# Variables d'installation du profil unraid-gunnm (lues par
# root-cachyos/scripts/steambox-env.sh). À reporter aussi dans le template
# Unraid (voir docs/deploiement-unraid.md).

# Ludothèque au format Batocera, dans un sous-dossier du partage Game
# (roms/, bios/, saves/ s'en déduisent).
GAMES_DIR=/home/arcade/games/Batocera

# AZERTY Mac du clavier Moonlight (KWin de streaming ; le bureau navigateur n'en a pas besoin).
KEYBOARD_LAYOUT=fr
KEYBOARD_VARIANT=mac

# Interface en français.
LANG=fr_FR.UTF-8
LANGUAGE=fr_FR:fr

# GPU NVIDIA : pilote VA-API (nvidia-vaapi-driver).
LIBVA_DRIVER_NAME=nvidia

# Haptiques HD de la DualSense (ds5-usbip, 22/11) : destination RTP des
# canaux haptiques, le PC client (AIBox, réception PipeWire sur 46100).
LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP=10.10.10.1:46100
# 4 canaux : haut-parleur de la manette (1-2) + haptiques (3-4) ; le
# récepteur d'AIBox (ds5-usbip-haptics.conf) doit être en 4 canaux aussi.
LIBVIRTUALHID_DUALSENSE_RTP_CHANNELS=4
