# syntax=docker/dockerfile:1.7
# SteamBox (ex-Waybox, ex-ArcadeBox) — variante CachyOS + labwc/XFCE (session Wayland réelle).
#
# Historique des architectures essayées sur cette branche, chacune abandonnée
# pour une raison concrète, testée en direct :
#
# 1. KDE Plasma/KWin (Wayland, `startplasma-wayland`) — abandonné : Plasma 6
#    dépend de systemd --user pour lancer ses composants, absent d'un
#    conteneur sans systemd (PID 1 = bash). Chaîne de blocages en cascade
#    (kcminit_startup, plasma_waitforname/KSplash, kded6).
#
# 2. Hyprland (Wayland, compositeur racine, accès DRM/GPU direct via
#    seatd+libinput) — a bien fonctionné techniquement (wlroots implémente
#    nativement zwlr_virtual_pointer/zwp_virtual_keyboard, contrairement à
#    KWin), mais bureau minimal (waybar + dock reconstruits à la main,
#    aucun vrai panneau de configuration pour résolution/scaling).
#
# 3. KDE Plasma/KWin (Wayland, `kwin_wayland --drm` lancé à la main comme
#    linuxserver/docker-webtop branche arch-kde, contournant ksmserver/
#    kcminit) — vrai bureau obtenu, capture Sunshine fonctionnelle
#    (KWIN_WAYLAND_NO_PERMISSION_CHECKS=1), MAIS deux problèmes bloquants :
#    - wayvnc (VNC) ne fonctionne QUE sur les compositeurs wlroots, confirmé
#      dans son propre README ("Gnome, KDE and Weston are not supported").
#    - le périphérique souris virtuel de Sunshine n'était jamais tagué
#      ID_INPUT_MOUSE par udev en temps réel sous KWin (cause exacte non
#      élucidée) — souris inopérante.
#
# 4. KDE Plasma/KWin (X11 réel — Xorg + driver NVIDIA direct sur le GPU,
#    PAS Xvfb) — abandonnée au profit du point 5 ci-dessous (pivot Waybox,
#    29/08). X11 réglait le problème VNC du point 3 structurellement :
#    x11vnc fonctionne avec n'importe quel gestionnaire de fenêtres (capture
#    native au protocole, pas de fragmentation par compositeur). Le problème
#    souris, lui, PERSISTAIT sous X11 (pas spécifique à Wayland/KWin comme
#    supposé initialement) : Sunshine injecte l'input via de vrais
#    périphériques uinput (pas XTest), et le pilote X11 'libinput' interroge
#    la même base udev on-disk qui ne persiste jamais ses tags dans ce
#    conteneur (cause exacte toujours non élucidée — udevd calcule et
#    diffuse bien les bons tags en temps réel, confirmé via `udevadm
#    monitor`, mais `/run/udev/data/` reste vide). Contourné en forçant le
#    pilote 'evdev' (n'a pas besoin d'udev, ouvre le device node
#    directement) sur les périphériques Sunshine via une règle InputClass —
#    cette règle n'a pas d'équivalent sous Wayland (libinput est la seule
#    voie, aucun pilote de contournement comme 'evdev' côté X11).
#
# 5. KDE Plasma/KWin (Wayland réel, via seatd — reprise du point 3, sans
#    VNC) — architecture Waybox (29/08). wayvnc est abandonné explicitement
#    (décision utilisateur : accès distant uniquement via Sunshine/Moonlight,
#    donc le point bloquant "wayvnc = wlroots only" du point 3 ne s'applique
#    plus). Reste le problème souris/clavier virtuel de Sunshine (uinput/udev,
#    point 3 et 4 ci-dessus) : sans pilote 'evdev' équivalent sous Wayland,
#    la seule parade connue dans ce dépôt est `evdev-bridge` (vendored à la
#    racine, ex-projet Desarso/evdev-bridge utilisé sur l'ancien Dockerfile
#    webstation/labwc) — il lit les devices uinput de Sunshine en direct
#    (indépendant d'udev) et les rejoue via les protocoles Wayland
#    zwlr_virtual_pointer_manager_v1/zwp_virtual_keyboard_manager_v1, QUE
#    KWin n'implémente PAS (protocoles wlroots-only, même famille que le
#    blocage wayvnc du point 3). Pegasus et les jeux tournent donc nichés
#    dans **gamescope** (déjà installé, compositeur wlroots, lancé comme
#    client Wayland ordinaire à l'intérieur de cette session KWin plutôt
#    qu'en root DRM — pour ne pas rouvrir le risque connu gamescope+NVIDIA
#    en mode DRM direct, jamais testé ici) : c'est CE socket Wayland-là que
#    ciblent evdev-bridge et Sunshine pour l'input pendant le jeu. La
#    capture vidéo Sunshine, elle, reste sur le bureau KWin externe — déjà
#    confirmée fonctionnelle au point 3 ("capture Sunshine fonctionnelle"),
#    gamescope plein écran y est simplement ce qui s'affiche à l'écran.
#    Le gamepad réel/virtuel n'est PAS concerné par ce contournement :
#    SDL_JOYSTICK_DISABLE_UDEV=1 (déjà en place, voir ENV plus bas) fait
#    déjà lire les manettes hors udev côté SDL/RetroArch, quel que soit le
#    compositeur — seuls souris/clavier virtuels Sunshine restent à risque,
#    non revérifiés en direct sur gamescope (seulement sur Hyprland/labwc
#    historiquement).
#
# 6. labwc (Wayland, compositeur wlroots) + panneau/bureau XFCE (xfce4-panel,
#    Thunar, xfce4-settings) — architecture Waybox définitive (29/08, second
#    pivot). KWin abandonné : ni wayvnc ni evdev-bridge n'y fonctionnent
#    (protocoles wlroots absents, point 5), et gamescope a lui aussi
#    abandonné ces protocoles au profit de libei entre-temps (confirmé en
#    direct : `zwlr_virtual_pointer_manager_v1 not available` contre
#    gamescope 3.16.25) — Sunshine, lui, n'est PAS lié à libei (confirmé via
#    `ldd`), donc aucun des deux compositeurs récemment essayés n'offre de
#    chemin d'input fonctionnel pour Sunshine. Hyprland (point 2) écarté à
#    nouveau : décision utilisateur, expérience tiling jugée inutilisable au
#    quotidien pour ce projet, malgré un input fonctionnel là aussi.
#
#    labwc est le SEUL choix qui coche toutes les cases déjà validées dans
#    l'historique de ce projet : c'est exactement le compositeur de l'ancien
#    Dockerfile webstation (avant migration CachyOS), où wayvnc ET
#    evdev-bridge fonctionnaient tous les deux en direct — voir le
#    commentaire d'origine d'evdev-bridge/bridge.c ("into Hyprland" y fait
#    référence à un test antérieur encore, mais le déploiement réel
#    utilisait labwc). xfce4-panel/Thunar/xfce4-settings ajoutés par-dessus
#    pour un bureau conventionnel (fenêtres empilées, pas de tiling) sans le
#    poids de KDE — Steam reste l'interface principale de la session, ce
#    bureau ne sert qu'à l'administration (fichiers, réglages).
#
#    Le gamepad réel/virtuel n'a jamais été concerné par le bug souris/clavier
#    (SDL_JOYSTICK_DISABLE_UDEV=1, voir ENV plus bas, bypasse udev côté
#    SDL/RetroArch indépendamment du compositeur) — seul le input Sunshine
#    (uinput) en dépendait, et evdev-bridge/labwc règle spécifiquement ce cas.
#
# 7. Deuxième labwc HEADLESS dédié à Sunshine (svc-labwc-headless, wayland-1,
#    30/08) — suite à une demande HDR, exploration complète de gamescope
#    comme cible de capture Sunshine (compositeur racine, --backend drm ET
#    headless, avec et sans --hdr-enabled/--expose-wayland) : jamais
#    fonctionnel, 3 échecs systématiques — portalgrab (RemoteDesktop/
#    ScreenCast absents du bus D-Bus), capture=kms ("Missing Wayland wire
#    XDG_OUTPUT", liste de moniteurs KMS vide), wlgrab par défaut
#    (EGL_BAD_ACCESS/[00003002] à l'init EGL). Confirmé indépendamment par
#    le projet Wolf (games-on-whales, streaming Docker+libei) : abandon de
#    gamescope pour Sway, support NVIDIA jugé insuffisant. HDR non atteignable
#    de toute façon avec Sunshine actuel : WLR_RENDERER=vulkan (requis pour
#    exposer wp_color_manager_v1) casse la capture NVIDIA quel que soit le
#    compositeur wlroots (confirmé sur labwc ET documenté indépendamment par
#    github.com/daaaaan/sunshine-headless-sway sur Sway, qui reste sciemment
#    sur WLR_RENDERER=gles2 pour cette raison).
#
#    Piste retenue à la place (même repo daaaaan, adaptée à labwc plutôt que
#    Sway — même famille wlroots, même principe) : un SECOND labwc, headless
#    (WLR_BACKENDS=headless, LIBSEAT_BACKEND=noop, aucun accès DRM/VT réel),
#    strictement dédié à Sunshine/evdev-bridge, indépendant du bureau XFCE
#    visible en local/VNC (svc-labwc, wayland-0). Validé en direct : capture
#    NVENC fonctionnelle (vraies keyframes IDR) contre ce labwc headless —
#    labwc implémente nativement ext_image_copy_capture_manager_v1 (capture
#    moderne) là où gamescope n'expose jamais assez de protocole. Input
#    (evdev-bridge-native inchangé, zwlr_virtual_pointer/zwp_virtual_keyboard)
#    fonctionne aussi nativement, sans le bridge libei exploré pour
#    gamescope (écrit, testé fonctionnel côté input, puis retiré : code mort
#    sans cible de capture viable). Pas de HDR dans cette architecture non
#    plus (toujours WLR_RENDERER par défaut/GLES2) — le seul gain réel est
#    l'isolation bureau/streaming, pas le HDR, qui reste hors de portée.

# Épinglé par digest (audit H2, 05/09), pas "latest" : un rebuild déclenché
# pour une seule ligne (ex: une règle udev) pouvait jusqu'ici faire monter
# silencieusement toute la base — Mesa, wlroots/labwc, Xwayland — sans
# qu'aucun commit ne le documente. Digest résolu le 05/09 (dernier build
# réussi et testé en production) ; pour bumper délibérément la base,
# relancer `docker pull cachyos/cachyos-v3:latest` et copier le nouveau
# digest ici, dans un commit dédié ("bump: base cachyos-v3").
FROM cachyos/cachyos-v3@sha256:8ab75658c3b5f7440615d533331c9f29896f9c9e2a92d4e8760f0d16f005b3a9

# github_token (audit C1, 05/09) : le build fait ~18 appels à l'API GitHub
# (releases "latest" des émulateurs) — non authentifié, la limite est de
# 60 requêtes/heure/IP : deux builds dans l'heure suffisent à faire échouer
# le suivant en "FATAL: URL vide". Passé désormais comme SECRET BuildKit
# (--secret id=github_token,env=GITHUB_TOKEN côté Makefile), lu via
# --mount=type=secret,id=github_token sur chaque RUN qui en a besoin, PAS
# comme ARG : un ARG consommé par un RUN reste visible en clair dans
# l'historique de l'image (`docker history`/`buildx imagetools inspect`)
# pour toujours, alors qu'un secret n'est monté que le temps du RUN et
# n'apparaît jamais dans aucune couche. Confirmé en direct le 05/09 :
# l'ancien ARG GITHUB_TOKEN était bien lisible en clair sur 52 des 74
# couches de l'image déjà poussée sur le registry — token révoqué et
# rebuild fait après ce correctif. Optionnel dans tous les cas : sans
# secret fourni au build, `cat /run/secrets/... 2>/dev/null || true`
# laisse GITHUB_TOKEN vide et ${GITHUB_TOKEN:+...} n'ajoute simplement pas
# le header Authorization.

# Épinglage des émulateurs/outils (audit H2, 05/09) : chacun des 16 appels
# à l'API GitHub "releases/latest" plus bas dispose désormais d'un ARG
# "<OUTIL>_TAG" (ex: CEMU_TAG, RPCS3_TAG, FLIPS_TAG...) — vide par défaut,
# comportement inchangé (résout toujours "latest" dynamiquement). Passer
# `--build-arg CEMU_TAG=v2.0-83` (ou via make : `make push CEMU_TAG=...`,
# à ajouter au Makefile si besoin d'un usage fréquent) fige cet outil sur
# un tag précis au lieu de suivre la dernière release à chaque build —
# utile pour bumper délibérément un seul outil sans que les 79 autres RUN
# ne bougent avec lui, ou pour reproduire une image passée. Non couvert :
# ShadPS4 (liste `/releases` complète, pas `/releases/latest`, pour
# capter des prereleases — mécanisme différent) et decky-loader (télécharge
# toujours le dernier binaire officiel une fois, PUIS se met à jour
# lui-même via son propre mécanisme, voir svc-decky-loader/run — un tag
# figé irait à l'encontre de ce design).

# BUILD_DATE : deuxième --build-arg passé par le Makefile jusqu'ici jamais
# consommé — exposé en label OCI standard, utile pour dater une image
# (`docker inspect` sur le registry) puisque les émulateurs sont tirés en
# "latest" au moment du build.
ARG BUILD_DATE
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="SteamBox" \
      org.opencontainers.image.source="https://github.com/Gunnm92/SteamBox"

# ── 1. Base système + labwc (Wayland) + bureau XFCE + seatd/libinput + GPU (Mesa/Vulkan) ──
# Panne CachyOS multilib (29/08) : lib32-gcc-libs/lib32-glibc — les DEUX
# SEULS paquets multilib que CachyOS rebuild elle-même (pour matcher sa
# toolchain optimisée x86_64_v3) — étaient absents de TOUS les miroirs
# cachyos-v3 (testé un par un), alors que le reste du multilib (dépôt Arch
# standard) fonctionnait très bien. Panne confirmée récurrente sur ce
# rebuild maison (incident quasi identique déjà documenté sur le forum
# CachyOS avec une version antérieure de ces deux mêmes paquets), et étendue
# en cascade à d'autres paquets 64-bit v3 (libpulse, libasyncns) au moment du
# test. Contournement RÉEL (pas une dégradation) trouvé en forçant ces 4
# paquets depuis le dépôt Arch standard (core/extra, mêmes versions logicielles,
# juste non-optimisées v3) plutôt que cachyos-v3/cachyos-extra-v3 — vérifié
# en direct, tout le reste de la chaîne (lib32-vulkan-*, lib32-pipewire,
# lib32-libpulse, dxvk-mingw-git) se résout et télécharge alors sans erreur.
# Si cette panne CachyOS est résolue au moment d'un futur rebuild, ces 4
# lignes "repo/paquet" explicites peuvent être simplifiées en noms de paquet
# nus sans risque (pacman retombera sur cachyos-v3 par défaut, prioritaire).
RUN pacman -Syyu --noconfirm && \
    pacman -S --noconfirm --needed \
      sudo vim openssh curl wget tar xz git jq unzip \
      seatd libinput \
      labwc xfdesktop xfce4-panel xfce4-settings xfce4-appfinder xfce4-terminal \
      thunar mousepad xfce4-taskmanager xfce4-pulseaudio-plugin \
      network-manager-applet polkit-gnome \
      xdg-desktop-portal-wlr xdg-desktop-portal-gtk \
      wayvnc python-pip wlr-randr \
      gtk3 \
      xorg-xwayland wayland libxkbcommon \
      mesa vulkan-icd-loader vulkan-tools \
      core/lib32-gcc-libs core/lib32-glibc extra/libpulse extra/libasyncns \
      vulkan-radeon lib32-vulkan-radeon \
      vulkan-intel lib32-vulkan-intel intel-media-driver libva-intel-driver \
      pipewire pipewire-pulse wireplumber \
      lib32-pipewire lib32-libpulse \
      ffmpeg \
      steam \
      heroic-games-launcher-bin \
      sunshine \
      gamemode mangohud \
      dbus polkit networkmanager \
      xdg-desktop-portal \
      gamescope \
      retroarch \
      libretro-nestopia libretro-bsnes libretro-genesis-plus-gx \
      libretro-mgba libretro-gambatte libretro-desmume \
      libretro-mupen64plus-next libretro-beetle-psx-hw libretro-ppsspp \
      libretro-flycast libretro-yabause libretro-dolphin \
      libretro-mame libretro-beetle-pce-fast libretro-beetle-pce \
      libretro-fbneo-git libretro-picodrive libretro-beetle-supergrafx \
      libretro-snes9x libretro-melonds libretro-scummvm \
      wine-staging winetricks dxvk-mingw-git vkd3d-proton-git \
      squashfuse squashfs-tools fuse-overlayfs \
      libnotify cabextract p7zip binutils nss \
      ark unrar zip \
      sdl2_image sdl2_mixer sdl2_ttf sdl2_gfx \
      dolphin-emu scummvm \
      papirus-icon-theme hicolor-icon-theme adwaita-icon-theme \
      ttf-jetbrains-mono-nerd cantarell-fonts noto-fonts ttf-dejavu \
      libva-utils \
      qt6-multimedia \
      flatpak \
    && pacman -Scc --noconfirm

# qt6-multimedia (audit menu XFCE 31/08) : melonDS a besoin de
# libQt6Multimedia.so.6 au runtime mais ne l'embarque pas dans son zip
# (contrairement à RPCS3/Azahar/ShadPS4 qui embarquent leur propre copie
# dans leur AppDir) — "cannot open shared object file" confirmé en direct
# sans ce paquet.
#
# flatpak (demandé 31/08) — xdg-desktop-portal(-gtk/-wlr) déjà installés
# ci-dessus couvrent les besoins runtime des apps Flatpak (permissions,
# ouverture de fichiers). Flathub ajouté comme remote système juste
# en dessous pour que le paquet soit utilisable dès le premier lancement,
# sans étape manuelle côté utilisateur.
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# nvidia-vaapi-driver — pont VA-API→NVDEC/NVENC pour NVIDIA (projet
# elFarto/nvidia-vaapi-driver), porté depuis le fix Dockerfile.ubuntu (audit
# 2026-08-26, "steam link fait crasher steam" : Steam Remote Play encode
# TOUJOURS via VA-API sous Linux, quel que soit le vendeur GPU, jamais un
# appel NVENC direct). Aucun paquet officiel Arch/CachyOS (core/extra/
# cachyos-*) — AUR-only, et PAS sous le nom du projet upstream : le paquet
# AUR s'appelle "libva-nvidia-driver-git" (confirmé via l'API AUR, URL
# github.com/elFarto/nvidia-vaapi-driver) — "nvidia-vaapi-driver" tout court
# clone un dépôt AUR vide (aucune erreur git, juste 0 commit). Buildé via
# makepkg (git/gcc/make/fakeroot déjà présents dans l'image — voir
# dxvk-mingw-git/vkd3d-proton-git plus haut, déjà des paquets -git) plutôt
# qu'extrait binaire comme Chrome : projet C minuscule, build de quelques
# secondes, pas la même échelle qu'un navigateur. meson/ninja/libva/
# ffnvcodec-headers = makedepends du PKGBUILD AUR, supprimés après coup
# avec le user de build temporaire.
# ludusavi (sauvegarde/restauration des saves de jeux, backend de la
# fonctionnalité "Ludusavi Manager" de Heroic) ajouté dans la MÊME session
# de build AUR que nvidia-vaapi-driver ci-dessus (un seul aller-retour
# useradd/userdel) : suite à l'audit du 29/08 sur le prefix Wine "shared"
# corrompu par nos changements de Proton successifs (voir commit sur
# install-nvidia-userspace.sh) — le prefix Wine ne doit plus être la seule
# copie des sauvegardes. Version "-bin" choisie (binaire précompilé upstream)
# plutôt que "ludusavi" source : évite d'ajouter toute la toolchain Rust/
# cargo à l'image pour un seul outil. depends du PKGBUILD (bzip2, gtk3,
# hicolor-icon-theme, libgcc) ajoutés aux paquets normaux car ce sont des
# dépendances RUNTIME (pas des makedepends) — elles doivent rester après
# le nettoyage, contrairement à meson/ninja plus bas.
# eden-nightly-bin (29/08) — build nightly de l'émulateur Switch Eden (fork
# de yuzu), ajouté dans la même session AUR. Variante "-bin" (AppImage
# précompilée par le CI du projet, juste extraite/installée) plutôt que
# "eden-nightly" source : évite d'ajouter Qt/LLVM/boost et une compilation
# C++ énorme à l'image pour un émulateur qui sort déjà un binaire tout fait.
# Dépendance runtime unique : hicolor-icon-theme (déjà installé plus haut).
#
# PKGBUILD upstream patché (bloc package(), via un petit script Python plutôt
# qu'un sed en ligne : trop d'imbrication de guillemets Dockerfile+shell+sed
# pour un remplacement multi-lignes propre) pour extraire l'AppImage
# (squashfs-root, déjà produit par prepare()/build() du PKGBUILD via
# --appimage-extract) et l'installer sous /opt/eden avec un wrapper shell
# exécutant AppRun — au lieu de copier le .AppImage brut sous
# /opt/${pkgname} (nécessite FUSE à chaque lancement). Exactement le
# comportement de l'ancien install manuel retiré plus haut : pas de FUSE
# requis au runtime, et des raccourcis/scripts existants pointent sur ce
# chemin /opt/eden précis.
# decky-loader (31/08, demande utilisateur) — chargeur de plugins Steam
# Deck (SteamDeckHomebrew/decky-loader). PAS installé via AUR (revu le
# 01/09) : le paquet AUR construit un wheel Python (via poetry) lancé comme
# module normal (/usr/bin/decky-loader) — un modèle de déploiement
# INCOMPATIBLE avec le mécanisme d'auto-update propre à decky, qui suppose
# toujours un binaire autonome nommé littéralement "PluginLoader" vivant
# dans son propre dossier de travail (voir updater.py:
# download_decky_binary — remove()/shutil.move() sur ce nom précis) :
# confirmé en direct, l'AUR laissait l'auto-update de decky totalement
# bloquée quel que soit le contournement systemd. Le vrai binaire officiel
# (release GitHub SteamDeckHomebrew/decky-loader, asset "PluginLoader",
# PyInstaller autonome) est téléchargé ici et copié au runtime par
# svc-decky-loader — voir ce fichier pour le détail du mécanisme d'update
# et le shim systemctl qui l'accompagne (root-cachyos/usr/local/bin/
# systemctl). Seules les dépendances RUNTIME des PLUGINS restent utiles ici
# (les plugins tiers comme CSS Loader tournent en process Python séparé,
# via l'interpréteur système, pas le binaire PyInstaller autonome de decky
# lui-même) : python-aiohttp-jinja2/-cors sont AUR-only, buildées dans
# build-aur.sh ; le reste (python-aiohttp/-watchdog/-certifi/-packaging/
# -multidict/-setproctitle/-jinja) vient des dépôts officiels.
RUN pacman -S --noconfirm --needed \
      meson ninja libva ffnvcodec-headers \
      bzip2 gtk3 hicolor-icon-theme libgcc \
      python python-aiohttp python-watchdog python-certifi python-packaging \
      python-multidict python-setproctitle python-jinja \
      python-setuptools python-wheel && \
    useradd -m -s /bin/bash aur-builder && \
    echo 'aur-builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/aur-builder

COPY <<'PATCH_EDEN_EOF' /tmp/patch-eden-pkgbuild.py
import pathlib
p = pathlib.Path("/tmp/eden-nightly-bin/PKGBUILD")
c = p.read_text()
old = (
    'package() {\n'
    '    install -Dm755 "${_appimage}" "${pkgdir}/opt/${pkgname}/${pkgname}.AppImage"\n'
)
new = (
    'package() {\n'
    '    install -dm755 "${pkgdir}/opt/eden"\n'
    '    cp -a squashfs-root/. "${pkgdir}/opt/eden/"\n'
    '    install -dm755 "${pkgdir}/usr/bin"\n'
    '    printf \'#!/bin/sh\\ncd /opt/eden && exec ./AppRun "$@"\\n\' > "${pkgdir}/usr/bin/eden"\n'
    '    chmod +x "${pkgdir}/usr/bin/eden"\n'
)
assert old in c, "bloc install introuvable dans PKGBUILD"
c = c.replace(old, new)
old2 = '    install -dm755 "${pkgdir}/usr/bin"\n    ln -s "/opt/${pkgname}/${pkgname}.AppImage" "${pkgdir}/usr/bin/eden"\n'
assert old2 in c, "bloc ln -s introuvable dans PKGBUILD"
c = c.replace(old2, "")
p.write_text(c)
print("PKGBUILD eden patche avec succes")
PATCH_EDEN_EOF

COPY <<'BUILD_AUR_EOF' /tmp/build-aur.sh
#!/bin/bash
set -e
cd /tmp
git clone --depth 1 https://aur.archlinux.org/libva-nvidia-driver-git.git
cd libva-nvidia-driver-git
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/ludusavi-bin.git
cd ludusavi-bin
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/eden-nightly-bin.git
python3 /tmp/patch-eden-pkgbuild.py
cd eden-nightly-bin
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/python-aiohttp-jinja2.git
cd python-aiohttp-jinja2
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/python-aiohttp-cors.git
cd python-aiohttp-cors
makepkg -si --noconfirm --needed
BUILD_AUR_EOF

RUN chown aur-builder:aur-builder /tmp/build-aur.sh /tmp/patch-eden-pkgbuild.py && \
    chmod +x /tmp/build-aur.sh && \
    su aur-builder -c /tmp/build-aur.sh && \
    rm -f /etc/sudoers.d/aur-builder /tmp/build-aur.sh /tmp/patch-eden-pkgbuild.py && \
    userdel -r aur-builder && \
    rm -rf /tmp/libva-nvidia-driver-git /tmp/ludusavi-bin /tmp/eden-nightly-bin \
           /tmp/python-aiohttp-jinja2 /tmp/python-aiohttp-cors && \
    pacman -Rns --noconfirm meson ninja && \
    pacman -Scc --noconfirm

# decky-loader — binaire officiel PyInstaller (voir commentaire plus haut),
# pas de build. Placé sous /opt (dans l'image, PAS sous /home/arcade — ce
# chemin est recouvert par le volume /config au runtime) : svc-decky-loader
# le copie vers ${DECKY_VAR_DATA}/PluginLoader au premier démarrage
# seulement (idempotent), pour ne jamais écraser une version que
# l'auto-update de decky aurait déjà installée sur le volume persistant.
RUN mkdir -p /opt/decky-loader && \
    curl -fsSL -o /opt/decky-loader/PluginLoader \
      "https://github.com/SteamDeckHomebrew/decky-loader/releases/latest/download/PluginLoader" && \
    chmod +x /opt/decky-loader/PluginLoader

# systemctl (shim) — decky-loader appelle "systemctl restart/stop/start/
# is-active plugin_loader" + "daemon-reload" pour s'auto-redémarrer après
# une mise à jour (updater.py: service_restart/service_stop/service_start/
# service_active) — ce conteneur n'a pas de vrai systemd (PID 1 = s6-
# svscan). Shim en shell qui traduit ces appels précis vers s6-svc sur
# svc-decky-loader ; /usr/local/bin passe avant /usr/sbin (où vit le vrai
# systemctl, utilisé par systemd-udevd/NetworkManager ailleurs dans cette
# image — jamais touché, seul le nom de service "plugin_loader" est
# intercepté ici, tout le reste retombe sur le vrai binaire).
COPY root-cachyos/usr/local/bin/systemctl /usr/local/bin/systemctl
RUN chmod +x /usr/local/bin/systemctl

# DISPLAY=:0 sur Ludusavi et Dolphin (audit menu XFCE, 31/08) — même bug que
# Chrome/Pegasus/Xenia : la session labwc unset DISPLAY globalement, ces deux
# apps en ont besoin pour s'initialiser (Ludusavi : "neither WAYLAND_DISPLAY
# nor WAYLAND_SOCKET nor DISPLAY is set", winit ne fait pas de repli
# implicite contrairement à un client Wayland natif ; Dolphin : plante
# silencieusement, "Aborted" sans autre message, résolu avec DISPLAY+
# WAYLAND_DISPLAY). Patché sur le .desktop déjà installé (paquet AUR/pacman,
# pas généré par ce Dockerfile) plutôt que réécrit, pour garder le reste du
# fichier upstream (icône, catégories, MimeType...) intact.
RUN sed -i 's|^Exec=ludusavi|Exec=env DISPLAY=:0 WAYLAND_DISPLAY=wayland-0 ludusavi|' \
      /usr/share/applications/com.mtkennerly.ludusavi.desktop && \
    sed -i 's|^Exec=dolphin-emu|Exec=env DISPLAY=:0 WAYLAND_DISPLAY=wayland-0 dolphin-emu|' \
      /usr/share/applications/dolphin-emu.desktop

# Steam (gamepadui) interroge NetworkManager via D-Bus pour son statut réseau
# et reste bloqué sur "waiting for network" sans ce service, même quand la
# connectivité réelle est bonne (observé : ses propres tests de connectivité
# HTTP passent, mais "Init: failed to create a NetworkManager client" bloque
# quand même l'écran de login). unmanaged-devices=* est CRITIQUE en
# network_mode: host : NetworkManager voit alors les vraies interfaces de
# l'hôte Unraid — sans ce réglage il pourrait tenter de les gérer/reconfigurer.
RUN mkdir -p /etc/NetworkManager && \
    printf '[main]\nplugins=keyfile\n\n[keyfile]\nunmanaged-devices=*\n' \
      > /etc/NetworkManager/NetworkManager.conf

# ── 1a2. Locale française — absente du glibc CachyOS (build allégé, seuls les
# locales en_* sont incluses ; fr_FR/*.fr manquent totalement). Le fichier de
# définition est un format texte stable côté glibc upstream — recréé depuis
# le miroir officiel plutôt que de basculer sur le paquet glibc standard
# d'Arch (risqué : glibc est la libc système, pas question d'en changer).
RUN curl -fsSL https://raw.githubusercontent.com/bminor/glibc/master/localedata/locales/fr_FR \
      -o /usr/share/i18n/locales/fr_FR && \
    localedef -i fr_FR -f UTF-8 fr_FR.UTF-8

# ── 1a3. Schémas GSettings — non compilés au build (hook pacman bloqué par le
# sandbox réseau de buildkit, cf. "could not isolate the network" pendant
# pacman -Scc). xdg-desktop-portal (utilisé par waybar/Steam) crashe
# immédiatement sans /usr/share/glib-2.0/schemas/gschemas.compiled.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas/

# ── 1a3b. Cache MIME — même classe de hook pacman bloqué au build. Sans
# /usr/share/mime/mime.cache, gdk-pixbuf ne peut pas identifier le format
# d'un fichier avant de le déléguer à glycin (nouveau backend de décodage
# d'image sandboxé) — TOUTE image (PNG compris, pas seulement SVG) échoue à
# charger ("Couldn't recognize the image file format"), et n'importe quelle
# appli GTK3 qui tente d'afficher une icône (même une icône interne, ex. le
# menu applications nwg-drawer) plante instantanément dessus.
RUN update-mime-database /usr/share/mime

# ── 1a3c. steam toujours avec -pipewire — Remote Play/Steam Link a besoin de
# ce flag pour la capture vidéo (sinon : "Unable to capture video:
# k_ECaptureFailedReasonPipewireRequired" après ~1 min de stream, confirmé
# dans streaming_log.txt). On avait ce flag via l'auto-lancement Big Picture
# retiré depuis — un wrapper le réapplique quel que soit le point d'entrée
# (dock, menu applications, app Sunshine), /usr/local/bin passant avant
# /usr/bin dans le PATH.
#
# -steamos3 -steampal -steamdeck (31/08, decky-loader) : sans détecter un
# vrai Steam Deck, Steam lance steamwebhelper avec --disable-quick-menu —
# désactivant tout le Quick Access Menu (QAM), l'endroit exact où
# decky-loader affiche son icône. La variable d'env SteamDeck=1 (essayée en
# premier) est INSUFFISANTE — confirmé en direct : --disable-quick-menu
# reste présent même avec cette variable fixée avant le lancement, elle ne
# sert qu'à l'API jeu IsSteamRunningOnSteamDeck(), pas à la décision interne
# du client sur ses propres flags d'UI. Le vrai mécanisme est un trio de
# flags CLI, trouvé dans le script officiel ChimeraOS/gamescope-session-steam
# (dont ce projet reprend déjà steamos-session-select.sh) :
# CLIENTCMD="steam -gamepadui -steamos3 -steampal -steamdeck". Testé en
# direct dans un terminal avec les trois flags ensemble : QAM + decky
# visibles, session stable — une suspicion initiale que -steamos3 cassait
# gamescope/labwc (erreurs vues au même moment dans les logs) n'a pas
# résisté à un nouveau test ciblé, très probablement du bruit sans lien.
# SDL_JOYSTICK_HIDAPI_PS5_RUMBLE (04/09, demande utilisateur — vibration
# DualSense/Moonlight aléatoire) — active les "extended input reports" du
# driver HIDAPI PS5 de SDL, nécessaires pour un rumble fiable ; sans ce
# hint, SDL peut silencieusement retomber sur son driver sysjoystick
# générique (boutons/axes seulement, pas de force feedback), documenté
# comme cause connue de rumble PS5 aléatoire (SDL_HINT_JOYSTICK_HIDAPI_
# PS5_RUMBLE, wiki.libsdl.org). Mitigation seulement : la cause racine
# réelle (Sunshine régénère un nouvel identifiant HID pour sa manette
# virtuelle à CHAQUE session Moonlight, donc Steam recrée un profil vierge
# à chaque fois) est un bug amont non résolu de Sunshine, sans correctif
# connu côté udev/config — voir LizardByte/Sunshine#3404.
RUN printf '#!/bin/sh\nexec env SDL_JOYSTICK_HIDAPI_PS5_RUMBLE=1 /usr/bin/steam -pipewire -steamos3 -steampal -steamdeck "$@"\n' > /usr/local/bin/steam && \
    chmod +x /usr/local/bin/steam

# ── 1a3d. xfdesktop-settings forcé sur Xwayland (30/08) — sous labwc/
# Wayland natif, sa détection de sortie échoue et il écrit ses réglages
# (fond d'écran) sur "monitorUnknown" au lieu du vrai connecteur
# "monitorHDMI-A-1" que le xfdesktop réellement affiché lit — un changement
# fait depuis le dialogue (clic droit bureau > Réglages du bureau) restait
# donc sans aucun effet visible, confirmé en direct. Forcer GDK_BACKEND=x11
# fait passer sa détection de sortie par XRandR (Xwayland), qui remonte le
# vrai nom de connecteur — écrit alors correctement sur monitorHDMI-A-1.
RUN printf '#!/bin/sh\nexec env GDK_BACKEND=x11 DISPLAY=:0 /usr/sbin/xfdesktop-settings "$@"\n' \
      > /usr/local/bin/xfdesktop-settings && \
    chmod +x /usr/local/bin/xfdesktop-settings

# ── 1a6. DXVK — injecte les DLL dans les préfixes Wine (dxvk-mingw-git ne le
# fait pas tout seul, contrairement à un vrai paquet dxvk-bin ; setup.sh doit
# tourner explicitement, généralement au 1er lancement d'un préfixe). Non
# automatisé : tous les jeux de ce conteneur tournent en Proton (GE-Proton
# via Heroic), qui embarque et configure sa propre DXVK/DXVK-NVAPI — vérifié
# le 30/08 sur le prefix Alan Wake 2 (nvapi64.dll + DXVK_ENABLE_NVAPI=1 déjà
# présents, posés par Proton lui-même). Un wrapper wine avait été ajouté
# puis retiré le 30/08 : aucun jeu ne passe par le wine système, donc aucune
# utilité réelle tant que ça reste le cas.
RUN ln -sf /usr/share/dxvk/setup_dxvk.sh /usr/local/bin/dxvk_setup 2>/dev/null || true

# ── 1a7. Pegasus Frontend — pas de paquet Arch/CachyOS, build x11-static
# officiel (Qt5 sans plugin Wayland compilé — testé en direct : "Could not
# find the Qt platform plugin wayland"), donc QT_QPA_PLATFORM=xcb explicite
# ici (l'ENV globale du Dockerfile vaut "wayland" par défaut). Décision
# utilisateur (29/08) : Steam est l'interface principale de la session
# (gamepadui, niché dans gamescope via scripts/steam-gamescope-launch.sh),
# PAS Pegasus en direct — Pegasus se lance DEPUIS Steam, ajouté comme "jeu
# non-Steam" dans la bibliothèque (config manuelle côté utilisateur, liée à
# son compte Steam, pas automatisable proprement dans l'image). Une fois
# lancé : détecte Steam/GOG/manettes automatiquement (confirmé en direct :
# 20 jeux Steam trouvés).
#
# DISPLAY=:0 explicite dans l'Exec= (audit menu XFCE 31/08) : Pegasus force
# QT_QPA_PLATFORM=xcb (pas de plugin Wayland dans ce build), mais la session
# labwc (wayland-session.sh) unset DISPLAY globalement — sans le fixer ici,
# lancé depuis le menu XFCE Pegasus échoue immédiatement ("could not connect
# to display", confirmé en direct). Même pattern que "Steam (Bureau)"
# ci-dessous ; labwc démarre son Xwayland interne à la demande sur :0.
ARG PEGASUS_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    PEGASUS_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/mmatyas/pegasus-frontend/releases/${PEGASUS_TAG:+tags/}${PEGASUS_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*x11-static\.zip"' | cut -d'"' -f4) && \
    [ -n "${PEGASUS_URL}" ] || { echo "FATAL: PEGASUS_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/pegasus.zip "${PEGASUS_URL}" && \
    mkdir -p /opt/pegasus && \
    unzip -q /tmp/pegasus.zip -d /opt/pegasus && \
    ln -sf /opt/pegasus/pegasus-fe /usr/local/bin/pegasus-fe && \
    printf '[Desktop Entry]\nType=Application\nName=Pegasus\nExec=env DISPLAY=:0 QT_QPA_PLATFORM=xcb /usr/local/bin/pegasus-fe\nIcon=applications-games\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/pegasus.desktop && \
    rm -f /tmp/pegasus.zip

# ── 1a7b. Steam (gamepadui) niché dans gamescope — remplace l'entrée de
# menu XFCE "Steam" générique du paquet (Exec=/usr/bin/steam nu, sans
# wrapper gamescope) qui échoue avec "Check your DISPLAY environment
# variable" — confirmé en direct le 30/08, aucun serveur X dans cette
# session Wayland pure sans passer par gamescope. Une seule entrée "Steam"
# désormais, celle qui fonctionne réellement.
RUN printf '[Desktop Entry]\nType=Application\nName=Steam\nExec=/usr/local/bin/scripts/steam-gamescope-launch.sh\nIcon=steam\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam.desktop

# "Steam (Bureau)" — client Steam classique (bibliothèque, réglages, ajout
# de jeux non-Steam comme Pegasus) en fenêtre normale sur le bureau XFCE/
# labwc, via l'Xwayland de labwc (DISPLAY=:0, confirmé en direct le 30/08 —
# distinct de l'Xwayland niché de gamescope utilisé par l'entrée "Steam"
# gamepadui ci-dessus). Pas de -gamepadui : interface desktop normale.
RUN printf '[Desktop Entry]\nType=Application\nName=Steam (Bureau)\nExec=env DISPLAY=:0 QT_QPA_PLATFORM=xcb /usr/local/bin/steam\nIcon=steam\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam-desktop.desktop

# "Retour au bureau" — ferme gamescope (et Steam avec) pour retrouver XFCE/
# labwc en dessous, sans dépendre du menu Quitter de Steam.
RUN printf '[Desktop Entry]\nType=Application\nName=Retour au bureau\nExec=/usr/local/bin/scripts/exit-to-desktop.sh\nIcon=go-home\nTerminal=false\nCategories=System;\n' \
      > /usr/share/applications/exit-to-desktop.desktop

# ── 1a7c. Thème GTK "Mc-OS-CTLina-XFCE-Dark" (macOS Catalina, sombre) —
# fourni par l'utilisateur (gnome-look.org, page bloquée par anti-bot Anubis,
# récupéré manuellement), vendored à la racine du dépôt comme evdev-bridge.
# Pas d'index.theme dans l'archive (contient juste gtk-2.0/ + gtk-3.0/,
# aucun xfwm4/ — sans importance, labwc gère les décorations de fenêtre, pas
# xfwm4) : on en génère un minimal pour qu'il apparaisse correctement dans
# le sélecteur de thème xfce4-appearance-settings.
COPY Mc-OS-CTLina-XFCE-Dark.tar.xz /tmp/theme.tar.xz
RUN mkdir -p /usr/share/themes && \
    tar -xJf /tmp/theme.tar.xz -C /usr/share/themes && \
    printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Mc-OS-CTLina-XFCE-Dark\nComment=macOS Catalina, sombre\n' \
      > /usr/share/themes/Mc-OS-CTLina-XFCE-Dark/index.theme && \
    rm -f /tmp/theme.tar.xz

# gtk.css du thème corrigé (audit 31/08) : 4 erreurs de syntaxe CSS réelles
# dans le fichier fourni, provoquant les "Theme parsing error" au démarrage
# de CHAQUE appli GTK3 du conteneur (RetroArch, Dolphin, Steam ROM Manager,
# Eden, xfce4-terminal...), toujours aux mêmes numéros de ligne — confirmé
# en isolant chaque erreur dans le fichier extrait :
#   - url"linear-gradient(...) : un "url" parasite devant un gradient, pas
#     une URL — probablement un artefact de recherche/remplacement en amont
#   - bloc .nautilus-window .path-bar button (styles Nautilus/GNOME Files,
#     jamais utilisés ici — ce projet utilise Thunar) : tentative de
#     commenter tout le bloc en éparpillant des /* */ ligne par ligne au
#     lieu d'un seul bloc propre — CSS ne supporte pas les commentaires
#     imbriqués, le premier */ rencontré referme prématurément, et le reste
#     du bloc est ensuite lu comme du vrai CSS invalide. Supprimé entièrement
#     plutôt que réparé : déjà mort/désactivé dans l'intention d'origine.
#   - "text-shadow: text-shadow: ..." : propriété dupliquée par erreur
#   - "color:ffffff" : # manquant devant le hex
COPY <<'PATCH_THEME_EOF' /tmp/patch-theme.py
p = '/usr/share/themes/Mc-OS-CTLina-XFCE-Dark/gtk-3.0/gtk.css'
lines = open(p, encoding='utf-8').read().splitlines(keepends=True)
assert 'url"linear-gradient' in lines[7852], 'ligne 7853 inattendue'
lines[7852] = lines[7852].replace('url"linear-gradient', 'linear-gradient')
assert lines[11632].startswith('/*.nautilus-window .path-bar button {'), 'ligne 11633 inattendue'
assert lines[11679].rstrip() == '}', 'ligne 11680 inattendue'
del lines[11632:11680]
c = ''.join(lines)
assert 'text-shadow: text-shadow:' in c
c = c.replace('text-shadow: text-shadow:', 'text-shadow:')
assert 'color:ffffff;' in c
c = c.replace('color:ffffff;', 'color:#ffffff;')
open(p, 'w', encoding='utf-8').write(c)
print('gtk.css theme patche avec succes')
PATCH_THEME_EOF

RUN python3 /tmp/patch-theme.py && rm -f /tmp/patch-theme.py

# ── 1a8. wsquashfs-launcher — lanceur de jeux Windows .wsquashfs (format
# Batocera), projet séparé (github.com/Gunnm92/wsquashfs-launcher) plutôt que
# le script wsquashfs-batocera embarqué dans l'image webstation — plus
# portable (détection auto Docker/FUSE, fallback unsquashfs), maintenu à part.
RUN curl -fsSL https://raw.githubusercontent.com/Gunnm92/wsquashfs-launcher/main/wsquashfs-launcher \
      -o /usr/local/bin/wsquashfs-launcher && \
    chmod +x /usr/local/bin/wsquashfs-launcher

# ── 1a9. Steam ROM Manager — génère des raccourcis Steam pour les ROMs/jeux
# non-Steam (AppImage officielle, pas de paquet Arch/CachyOS).
ARG SRM_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    SRM_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/SteamGridDB/steam-rom-manager/releases/${SRM_TAG:+tags/}${SRM_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*[0-9]\.AppImage"' | grep -v arm64 | cut -d'"' -f4) && \
    [ -n "${SRM_URL}" ] || { echo "FATAL: SRM_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/srm.AppImage "${SRM_URL}" && \
    chmod +x /tmp/srm.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./srm.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction srm.AppImage échouée"; exit 1; } && \
    mv /tmp/squashfs-root /opt/steam-rom-manager && \
    chmod -R a+rX /opt/steam-rom-manager && \
    printf '#!/bin/sh\nexport APPDIR=/opt/steam-rom-manager\nexec /opt/steam-rom-manager/AppRun "$@"\n' \
      > /usr/local/bin/steam-rom-manager && chmod +x /usr/local/bin/steam-rom-manager && \
    printf '[Desktop Entry]\nType=Application\nName=Steam ROM Manager\nExec=env DISPLAY=:0 /usr/local/bin/steam-rom-manager --no-sandbox\nIcon=/opt/steam-rom-manager/.DirIcon\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam-rom-manager.desktop && \
    rm -rf /tmp/srm.AppImage /tmp/squashfs-root

# ── 1a10. Lindbergh Loader (arcade Sega Lindbergh) — AppImage officielle.
RUN curl -fSL -o /tmp/lindbergh.app \
      "https://github.com/lindbergh-loader/lindbergh-loader/releases/download/v2.1.4/lindbergh-loader.AppImage" && \
    chmod +x /tmp/lindbergh.app && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root AppDir; ./lindbergh.app --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    { [ -d squashfs-root ] || [ -d AppDir ]; } || { echo "FATAL: extraction lindbergh.app échouée"; exit 1; } && \
    { [ -L squashfs-root ] && mv AppDir /opt/lindbergh && rm -f squashfs-root || mv squashfs-root /opt/lindbergh; } && \
    ln -sf /opt/lindbergh/AppRun /usr/local/bin/lindbergh && \
    printf '[Desktop Entry]\nType=Application\nName=Lindbergh Loader\nExec=/usr/local/bin/lindbergh\nIcon=/opt/lindbergh/.DirIcon\nCategories=Game;Emulator;\nTerminal=false\n' \
      > /usr/share/applications/lindbergh.desktop && \
    rm -rf /tmp/lindbergh.app /tmp/AppDir /tmp/squashfs-root

# ── 1a11. Supermodel (arcade Sega Model 3) — tarball Linux officiel.
ARG SUPERMODEL_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    SUPERMODEL_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/trzy/Supermodel/releases/${SUPERMODEL_TAG:+tags/}${SUPERMODEL_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*[Ll]inux[^"]*\.tar[^"]*"' | cut -d'"' -f4 | head -1) && \
    if [ -n "${SUPERMODEL_URL}" ]; then \
      curl -o /tmp/supermodel.tar.gz -L "${SUPERMODEL_URL}" && \
      mkdir -p /opt/supermodel && \
      tar -xzf /tmp/supermodel.tar.gz -C /opt/supermodel --strip-components=1 && \
      ln -sf /opt/supermodel/supermodel /usr/local/bin/supermodel; \
    else \
      echo "Supermodel: pas de release Linux, skip"; \
    fi && \
    rm -f /tmp/supermodel.tar.gz

# ── 1a12. Wine Gecko + Mono — sans ça, tout préfixe Wine invite au
# téléchargement (popup bloquant) au premier lancement d'un installeur/jeu qui
# a besoin du moteur HTML (Gecko) ou de .NET (Mono). Récupéré depuis le miroir
# officiel WineHQ, indépendant de la distro (déjà utilisé sur l'image
# webstation) — wine cherche nativement dans /usr/share/wine/{gecko,mono},
# chemin issu du code amont, pas d'un patch Debian.
RUN GECKO_VERSION=$(curl -fsSL "https://raw.githubusercontent.com/wine-mirror/wine/refs/heads/master/dlls/appwiz.cpl/addons.c" \
      | grep -oP '(?<=GECKO_VERSION ")[^"]+' | head -1) && \
    MONO_VERSION=$(curl -fsSL "https://raw.githubusercontent.com/wine-mirror/wine/refs/heads/master/dlls/appwiz.cpl/addons.c" \
      | grep -oP '(?<=MONO_VERSION ")[^"]+' | head -1) && \
    mkdir -p /usr/share/wine/gecko /usr/share/wine/mono && \
    for arch in x86 x86_64; do \
      curl -fsSL --retry 3 -o "/usr/share/wine/gecko/wine-gecko-${GECKO_VERSION}-${arch}.msi" \
        "https://dl.winehq.org/wine/wine-gecko/${GECKO_VERSION}/wine-gecko-${GECKO_VERSION}-${arch}.msi" || true; \
    done && \
    curl -fsSL --retry 3 -o "/tmp/wine-mono.tar.xz" \
      "https://dl.winehq.org/wine/wine-mono/${MONO_VERSION}/wine-mono-${MONO_VERSION}-x86.tar.xz" && \
    tar -xf /tmp/wine-mono.tar.xz -C /usr/share/wine/mono && \
    rm -f /tmp/wine-mono.tar.xz

# ── 1a13. Google Chrome — pas de paquet Arch officiel (AUR-only, nécessite un
# helper AUR + base-devel), extrait manuellement du .deb officiel Google
# (même approche que Pegasus/SRM/Lindbergh ci-dessus : curl + extraction, pas
# d'installeur). --ozone-platform=x11 + env DISPLAY=:0 explicites (audit C4,
# 31/08) : la session labwc unset DISPLAY globalement, et Chrome forcé en
# x11 sans DISPLAY échoue depuis le menu — même pattern que Pegasus/Xenia/
# Steam (Bureau) ; chmod 4755 sur chrome-sandbox reproduit ce que fait le
# postinst du .deb (on ne l'exécute pas, on ne prend que data.tar).
RUN curl -fsSL -o /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb" && \
    cd /tmp && ar x chrome.deb && \
    mkdir -p /tmp/chrome-extract && \
    tar -xf data.tar.xz -C /tmp/chrome-extract && \
    mkdir -p /opt/google/chrome && \
    cp -a /tmp/chrome-extract/opt/google/chrome/. /opt/google/chrome/ && \
    ln -sf /opt/google/chrome/google-chrome /usr/local/bin/google-chrome && \
    chmod 4755 /opt/google/chrome/chrome-sandbox && \
    printf '[Desktop Entry]\nType=Application\nName=Google Chrome\nExec=env DISPLAY=:0 /opt/google/chrome/google-chrome --ozone-platform=x11 %%U\nIcon=/opt/google/chrome/product_logo_256.png\nTerminal=false\nCategories=Network;WebBrowser;\n' \
      > /usr/share/applications/google-chrome.desktop && \
    rm -rf /tmp/chrome.deb /tmp/control.tar.* /tmp/data.tar.* /tmp/debian-binary /tmp/chrome-extract

# ── 1a14. Émulateurs supplémentaires — parité avec la suite bundlée dans
# l'ancienne image de base lscr.io/linuxserver/webstation (dolphin-emu et
# scummvm ci-dessus sont déjà des paquets Arch officiels ; le reste n'a pas
# de paquet Arch/AUR-free, mais chaque projet publie une AppImage/archive
# Linux officielle — même approche curl+extraction que Pegasus/SRM/Lindbergh/
# Chrome ci-dessus, pas de build depuis les sources.
#
# wrapper "exec /opt/X/AppRun" au lieu d'un ln -sf (audit menu XFCE 31/08) :
# l'AppRun de Cemu/RPCS3/Azahar/ShadPS4/SRM est un SCRIPT (linuxdeploy) qui
# calcule son propre dossier via `dirname "$0"` AVANT de résoudre les liens
# symboliques — lancé via un ln -sf sous /usr/local/bin, dirname donne
# /usr/local/bin au lieu de /opt/X, et le script part chercher ses hooks/
# libs au mauvais endroit ("No such file", "No desktop file found").
# env DISPLAY=:0 sur Cemu et Steam ROM Manager (audit menu XFCE 31/08,
# second passage) : au-delà du bug AppRun ci-dessus, ces deux-là ont aussi
# besoin d'un serveur X — Cemu via le hook linuxdeploy-plugin-gtk.sh sourcé
# par son AppRun ("Unable to initialize GTK+"), SRM via son Electron/ozone
# ("Missing X server or $DISPLAY", segfault ensuite) — même bug que Chrome/
# Pegasus/Xenia, la session labwc unset DISPLAY globalement.
#
# Confirmé en direct dans le conteneur : PCSX2/DuckStation/Xemu n'ont pas ce
# problème car leur AppRun est un lien direct vers le vrai binaire (aucun
# script, donc rien à mal résoudre) — un wrapper shell qui exec le chemin
# absolu évite complètement le calcul de dossier.
ARG CEMU_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    CEMU_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/cemu-project/Cemu/releases/${CEMU_TAG:+tags/}${CEMU_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*x86_64\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${CEMU_URL}" ] || { echo "FATAL: CEMU_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/cemu.AppImage "${CEMU_URL}" && \
    chmod +x /tmp/cemu.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./cemu.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction cemu.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/cemu && \
    printf '#!/bin/sh\nexec /opt/cemu/AppRun "$@"\n' > /usr/local/bin/cemu && \
    chmod +x /usr/local/bin/cemu && \
    printf '[Desktop Entry]\nType=Application\nName=Cemu\nExec=env DISPLAY=:0 /usr/local/bin/cemu\nIcon=/opt/cemu/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/cemu.desktop && \
    rm -f /tmp/cemu.AppImage

ARG PCSX2_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    PCSX2_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/PCSX2/pcsx2/releases/${PCSX2_TAG:+tags/}${PCSX2_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*linux-appimage-x64-Qt\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${PCSX2_URL}" ] || { echo "FATAL: PCSX2_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/pcsx2.AppImage "${PCSX2_URL}" && \
    chmod +x /tmp/pcsx2.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./pcsx2.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction pcsx2.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/pcsx2 && \
    ln -sf /opt/pcsx2/AppRun /usr/local/bin/pcsx2 && \
    printf '[Desktop Entry]\nType=Application\nName=PCSX2\nExec=/usr/local/bin/pcsx2\nIcon=/opt/pcsx2/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/pcsx2.desktop && \
    rm -f /tmp/pcsx2.AppImage

ARG RPCS3_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    RPCS3_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/RPCS3/rpcs3-binaries-linux/releases/${RPCS3_TAG:+tags/}${RPCS3_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*_linux64\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${RPCS3_URL}" ] || { echo "FATAL: RPCS3_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/rpcs3.AppImage "${RPCS3_URL}" && \
    chmod +x /tmp/rpcs3.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root AppDir; ./rpcs3.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    { [ -d squashfs-root ] || [ -d AppDir ]; } || { echo "FATAL: extraction rpcs3.AppImage échouée"; exit 1; } && \
    { [ -L squashfs-root ] && mv AppDir /opt/rpcs3 || mv squashfs-root /opt/rpcs3; } && \
    printf '#!/bin/sh\nexec /opt/rpcs3/AppRun "$@"\n' > /usr/local/bin/rpcs3 && \
    chmod +x /usr/local/bin/rpcs3 && \
    printf '[Desktop Entry]\nType=Application\nName=RPCS3\nExec=/usr/local/bin/rpcs3\nIcon=/opt/rpcs3/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/rpcs3.desktop && \
    rm -f /tmp/rpcs3.AppImage

ARG DUCKSTATION_TAG=""
