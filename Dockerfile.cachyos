# ArcadeBox — variante CachyOS + Hyprland, architecture proche SteamOS.
#
# Différence structurelle avec l'image webstation : Hyprland est le compositeur
# RACINE (accès DRM/GPU direct via seatd+libinput), pas imbriqué dans un
# backend de rendu tiers. Sunshine et wayvnc capturent donc directement le
# vrai wl_output de Hyprland — pas de compositeur parent à contourner, pas
# besoin du bridge evdev custom : seatd + libinput gèrent l'input normalement,
# comme sur un vrai bureau. Hyprland étant wlroots, il implémente nativement
# zwlr_virtual_pointer_manager_v1/zwp_virtual_keyboard_manager_v1 (wayvnc input
# fonctionne directement, contrairement à KWin qui ne les implémente pas).
#
# KDE Plasma/KWin a été essayé en premier (plus proche visuellement de
# SteamOS) mais abandonné : Plasma 6 dépend de systemd --user pour lancer ses
# composants, absent d'un conteneur sans systemd (PID 1 = bash). Chaîne de
# blocages en cascade (kcminit_startup, plasma_waitforname/KSplash, kded6)
# nécessitant des wrappers timeout au cas par cas — non soutenable. Hyprland
# n'a pas cette dépendance et évite toute cette classe de problèmes.
#
# Steam Big Picture se lance en plein écran DANS cette session Hyprland (pas
# de bascule vers un second compositeur type Gamescope).

FROM cachyos/cachyos-v3:latest

# ── 1. Base système + Hyprland minimal + seatd/libinput + GPU (Mesa/Vulkan) ──
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
      sudo vim openssh curl wget tar git jq unzip \
      seatd libinput \
      hyprland xdg-desktop-portal-hyprland foot \
      hyprpaper waybar wofi nwg-dock-hyprland nwg-drawer imagemagick grim \
      xorg-xwayland \
      mesa vulkan-icd-loader vulkan-tools \
      vulkan-radeon lib32-vulkan-radeon \
      vulkan-intel lib32-vulkan-intel intel-media-driver libva-intel-driver \
      pipewire pipewire-pulse wireplumber \
      lib32-pipewire lib32-libpulse \
      wayvnc python-pip \
      ffmpeg \
      steam \
      sunshine \
      gamemode mangohud \
      dbus polkit networkmanager \
      xdg-desktop-portal \
    && pacman -Scc --noconfirm

# wayvnc --websocket (0.10.1) crashe (double free) au premier client
# websocket — bug upstream connu (any1/wayvnc#319). websockify (absent des
# dépôts Arch/CachyOS) sert de proxy websocket devant le RFB brut de wayvnc,
# l'architecture noVNC classique/éprouvée.
RUN pip install --break-system-packages --no-cache-dir websockify

# Steam (gamepadui) interroge NetworkManager via D-Bus pour son statut réseau
# et reste bloqué sur "waiting for network" sans ce service, même quand la
# connectivité réelle est bonne (observé : ses propres tests de connectivité
# HTTP passent, mais "Init: failed to create a NetworkManager client" bloque
# quand même l'écran de login). unmanaged-devices=* est CRITIQUE en
# network_mode: host : NetworkManager voit alors les vraies interfaces de
# l'hôte Unraid — sans ce réglage il pourrait tenter de les gérer/reconfigurer.
RUN mkdir -p /etc/NetworkManager && \
    printf '[main]\nplugins=keyfile\n\n[keyfile]\nunmanaged-devices=*\n' \
      > /etc/NetworkManager/NetworkManager.conf

# ── 1a2. Locale française — absente du glibc CachyOS (build allégé, seuls les
# locales en_* sont incluses ; fr_FR/*.fr manquent totalement). Le fichier de
# définition est un format texte stable côté glibc upstream — recréé depuis
# le miroir officiel plutôt que de basculer sur le paquet glibc standard
# d'Arch (risqué : glibc est la libc système, pas question d'en changer).
RUN curl -fsSL https://raw.githubusercontent.com/bminor/glibc/master/localedata/locales/fr_FR \
      -o /usr/share/i18n/locales/fr_FR && \
    localedef -i fr_FR -f UTF-8 fr_FR.UTF-8

# ── 1a3. Schémas GSettings — non compilés au build (hook pacman bloqué par le
# sandbox réseau de buildkit, cf. "could not isolate the network" pendant
# pacman -Scc). xdg-desktop-portal (utilisé par waybar/Steam) crashe
# immédiatement sans /usr/share/glib-2.0/schemas/gschemas.compiled.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas/

# ── 1a3b. Cache MIME — même classe de hook pacman bloqué au build. Sans
# /usr/share/mime/mime.cache, gdk-pixbuf ne peut pas identifier le format
# d'un fichier avant de le déléguer à glycin (nouveau backend de décodage
# d'image sandboxé) — TOUTE image (PNG compris, pas seulement SVG) échoue à
# charger ("Couldn't recognize the image file format"), et n'importe quelle
# appli GTK3 qui tente d'afficher une icône (même une icône interne, ex. le
# menu applications nwg-drawer) plante instantanément dessus.
RUN update-mime-database /usr/share/mime

# ── 1a4. Fond d'écran par défaut — dégradé sombre, pas juste un écran noir.
RUN mkdir -p /usr/share/backgrounds && \
    magick -size 3840x2160 gradient:'#4a3a8a'-'#161028' /usr/share/backgrounds/arcadebox.png

# ── 1a5. Palette officielle Catppuccin Mocha — plutôt que deviner des
# couleurs à la main, on récupère la palette de référence (catppuccin/
# waybar) : @import-able depuis waybar ET le dock (même fichier CSS).
RUN mkdir -p /usr/share/catppuccin && \
    curl -fsSL https://raw.githubusercontent.com/catppuccin/waybar/main/themes/mocha.css \
      -o /usr/share/catppuccin/mocha.css

# ── 1b. noVNC — fichiers statiques (pas de paquet Arch/CachyOS, AUR-only) ────
RUN NOVNC_URL=$(curl -sX GET "https://api.github.com/repos/novnc/noVNC/releases/latest" \
      | grep -oE '"tarball_url": *"[^"]*"' | cut -d'"' -f4) && \
    mkdir -p /usr/share/webapps/novnc && \
    curl -fSL "${NOVNC_URL}" | tar -xz -C /usr/share/webapps/novnc --strip-components=1

# La racine ("/") du serveur noVNC affiche par défaut une liste de fichiers
# (aucun index.html fourni), et vnc.html seul n'a ni host ni port pré-remplis
# (l'utilisateur doit les saisir à la main dans le formulaire) — on redirige
# en JS avec l'hôte déduit dynamiquement (window.location.hostname, pas
# d'IP en dur) et le port websockify pour que l'URL de base se connecte
# directement.
RUN printf '<script>location.replace("vnc.html?host=" + location.hostname + "&port=5900&autoconnect=true&resize=remote&reconnect=true");</script>\n' \
      > /usr/share/webapps/novnc/index.html

# ── 2. Driver NVIDIA userspace — matché à la version du host au démarrage ────
# Le paquet Arch nvidia-utils suit la dernière release, pas forcément celle du
# host. On réutilise l'approche .run (agnostique à la distro, déjà éprouvée
# sur l'image webstation) : installée au runtime par un script d'init, pas ici
# au build (le driver du host n'est pas connu à ce stade).
COPY ArcadeBox/root-cachyos/usr/local/bin/install-nvidia-userspace.sh /usr/local/bin/install-nvidia-userspace.sh
RUN chmod +x /usr/local/bin/install-nvidia-userspace.sh

# ── 3. Règles udev manettes (Xbox/PlayStation/Switch — mappings non standard) ─
RUN git clone --depth 1 https://codeberg.org/fabiscafe/game-devices-udev.git /tmp/gdu && \
    cp /tmp/gdu/src/*.rules /etc/udev/rules.d/ && \
    rm -rf /tmp/gdu

# ── 4. Utilisateur non-root pour la session bureau ────────────────────────────
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g "${PGID}" arcade 2>/dev/null || true && \
    useradd -m -u "${PUID}" -g "${PGID}" \
      -G wheel,video,input,render,audio -s /bin/bash arcade && \
    echo "arcade ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    mkdir -p /home/arcade/.config/sunshine && \
    chown -R arcade:arcade /home/arcade

RUN setcap 'cap_sys_nice+p' "$(readlink -f /usr/bin/sunshine)" 2>/dev/null || \
    echo "WARN: setcap sunshine impossible ici, à refaire si le binaire change au runtime"

# ── 5. Scripts de démarrage ────────────────────────────────────────────────────
COPY ArcadeBox/root-cachyos/entrypoint.sh /entrypoint.sh
COPY ArcadeBox/root-cachyos/scripts/ /usr/local/bin/scripts/
RUN chmod +x /entrypoint.sh /usr/local/bin/scripts/*.sh

ENV XDG_RUNTIME_DIR=/run/user/1000 \
    WAYLAND_DISPLAY=wayland-0 \
    SEATD_VTBOUND=0 \
    LIBSEAT_BACKEND=seatd \
    QT_QPA_PLATFORM=wayland \
    SDL_VIDEODRIVER=wayland \
    SDL_JOYSTICK_DISABLE_UDEV=1 \
    LANG=fr_FR.UTF-8 \
    LANGUAGE=fr_FR:fr \
    LC_ALL=fr_FR.UTF-8

VOLUME /config
EXPOSE 6080 5900 47990 47984 47989 47998-48000/udp 48010

ENTRYPOINT ["/entrypoint.sh"]
