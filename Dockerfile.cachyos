# syntax=docker/dockerfile:1.7
# SteamBox (ex-Waybox, ex-ArcadeBox) — variante CachyOS + labwc/XFCE (session Wayland réelle).
#
# Historique des architectures essayées sur cette branche, chacune abandonnée
# pour une raison concrète, testée en direct :
#
# 1. KDE Plasma/KWin (Wayland, `startplasma-wayland`) — abandonné : Plasma 6
#    dépend de systemd --user pour lancer ses composants, absent d'un
#    conteneur sans systemd (PID 1 = bash). Chaîne de blocages en cascade
#    (kcminit_startup, plasma_waitforname/KSplash, kded6).
#
# 2. Hyprland (Wayland, compositeur racine, accès DRM/GPU direct via
#    seatd+libinput) — a bien fonctionné techniquement (wlroots implémente
#    nativement zwlr_virtual_pointer/zwp_virtual_keyboard, contrairement à
#    KWin), mais bureau minimal (waybar + dock reconstruits à la main,
#    aucun vrai panneau de configuration pour résolution/scaling).
#
# 3. KDE Plasma/KWin (Wayland, `kwin_wayland --drm` lancé à la main comme
#    linuxserver/docker-webtop branche arch-kde, contournant ksmserver/
#    kcminit) — vrai bureau obtenu, capture Sunshine fonctionnelle
#    (KWIN_WAYLAND_NO_PERMISSION_CHECKS=1), MAIS deux problèmes bloquants :
#    - wayvnc (VNC) ne fonctionne QUE sur les compositeurs wlroots, confirmé
#      dans son propre README ("Gnome, KDE and Weston are not supported").
#    - le périphérique souris virtuel de Sunshine n'était jamais tagué
#      ID_INPUT_MOUSE par udev en temps réel sous KWin (cause exacte non
#      élucidée) — souris inopérante.
#
# 4. KDE Plasma/KWin (X11 réel — Xorg + driver NVIDIA direct sur le GPU,
#    PAS Xvfb) — abandonnée au profit du point 5 ci-dessous (pivot Waybox,
#    29/08). X11 réglait le problème VNC du point 3 structurellement :
#    x11vnc fonctionne avec n'importe quel gestionnaire de fenêtres (capture
#    native au protocole, pas de fragmentation par compositeur). Le problème
#    souris, lui, PERSISTAIT sous X11 (pas spécifique à Wayland/KWin comme
#    supposé initialement) : Sunshine injecte l'input via de vrais
#    périphériques uinput (pas XTest), et le pilote X11 'libinput' interroge
#    la même base udev on-disk qui ne persiste jamais ses tags dans ce
#    conteneur (cause exacte toujours non élucidée — udevd calcule et
#    diffuse bien les bons tags en temps réel, confirmé via `udevadm
#    monitor`, mais `/run/udev/data/` reste vide). Contourné en forçant le
#    pilote 'evdev' (n'a pas besoin d'udev, ouvre le device node
#    directement) sur les périphériques Sunshine via une règle InputClass —
#    cette règle n'a pas d'équivalent sous Wayland (libinput est la seule
#    voie, aucun pilote de contournement comme 'evdev' côté X11).
#
# 5. KDE Plasma/KWin (Wayland réel, via seatd — reprise du point 3, sans
#    VNC) — architecture Waybox (29/08). wayvnc est abandonné explicitement
#    (décision utilisateur : accès distant uniquement via Sunshine/Moonlight,
#    donc le point bloquant "wayvnc = wlroots only" du point 3 ne s'applique
#    plus). Reste le problème souris/clavier virtuel de Sunshine (uinput/udev,
#    point 3 et 4 ci-dessus) : sans pilote 'evdev' équivalent sous Wayland,
#    la seule parade connue dans ce dépôt est `evdev-bridge` (vendored à la
#    racine, ex-projet Desarso/evdev-bridge utilisé sur l'ancien Dockerfile
#    webstation/labwc) — il lit les devices uinput de Sunshine en direct
#    (indépendant d'udev) et les rejoue via les protocoles Wayland
#    zwlr_virtual_pointer_manager_v1/zwp_virtual_keyboard_manager_v1, QUE
#    KWin n'implémente PAS (protocoles wlroots-only, même famille que le
#    blocage wayvnc du point 3). Pegasus et les jeux tournent donc nichés
#    dans **gamescope** (déjà installé, compositeur wlroots, lancé comme
#    client Wayland ordinaire à l'intérieur de cette session KWin plutôt
#    qu'en root DRM — pour ne pas rouvrir le risque connu gamescope+NVIDIA
#    en mode DRM direct, jamais testé ici) : c'est CE socket Wayland-là que
#    ciblent evdev-bridge et Sunshine pour l'input pendant le jeu. La
#    capture vidéo Sunshine, elle, reste sur le bureau KWin externe — déjà
#    confirmée fonctionnelle au point 3 ("capture Sunshine fonctionnelle"),
#    gamescope plein écran y est simplement ce qui s'affiche à l'écran.
#    Le gamepad réel/virtuel n'est PAS concerné par ce contournement :
#    SDL_JOYSTICK_DISABLE_UDEV=1 (déjà en place, voir ENV plus bas) fait
#    déjà lire les manettes hors udev côté SDL/RetroArch, quel que soit le
#    compositeur — seuls souris/clavier virtuels Sunshine restent à risque,
#    non revérifiés en direct sur gamescope (seulement sur Hyprland/labwc
#    historiquement).
#
# 6. labwc (Wayland, compositeur wlroots) + panneau/bureau XFCE (xfce4-panel,
#    Thunar, xfce4-settings) — architecture Waybox définitive (29/08, second
#    pivot). KWin abandonné : ni wayvnc ni evdev-bridge n'y fonctionnent
#    (protocoles wlroots absents, point 5), et gamescope a lui aussi
#    abandonné ces protocoles au profit de libei entre-temps (confirmé en
#    direct : `zwlr_virtual_pointer_manager_v1 not available` contre
#    gamescope 3.16.25) — Sunshine, lui, n'est PAS lié à libei (confirmé via
#    `ldd`), donc aucun des deux compositeurs récemment essayés n'offre de
#    chemin d'input fonctionnel pour Sunshine. Hyprland (point 2) écarté à
#    nouveau : décision utilisateur, expérience tiling jugée inutilisable au
#    quotidien pour ce projet, malgré un input fonctionnel là aussi.
#
#    labwc est le SEUL choix qui coche toutes les cases déjà validées dans
#    l'historique de ce projet : c'est exactement le compositeur de l'ancien
#    Dockerfile webstation (avant migration CachyOS), où wayvnc ET
#    evdev-bridge fonctionnaient tous les deux en direct — voir le
#    commentaire d'origine d'evdev-bridge/bridge.c ("into Hyprland" y fait
#    référence à un test antérieur encore, mais le déploiement réel
#    utilisait labwc). xfce4-panel/Thunar/xfce4-settings ajoutés par-dessus
#    pour un bureau conventionnel (fenêtres empilées, pas de tiling) sans le
#    poids de KDE — Steam reste l'interface principale de la session, ce
#    bureau ne sert qu'à l'administration (fichiers, réglages).
#
#    Le gamepad réel/virtuel n'a jamais été concerné par le bug souris/clavier
#    (SDL_JOYSTICK_DISABLE_UDEV=1, voir ENV plus bas, bypasse udev côté
#    SDL/RetroArch indépendamment du compositeur) — seul le input Sunshine
#    (uinput) en dépendait, et evdev-bridge/labwc règle spécifiquement ce cas.
#
# 7. Deuxième labwc HEADLESS dédié à Sunshine (svc-labwc-headless, wayland-1,
#    30/08) — suite à une demande HDR, exploration complète de gamescope
#    comme cible de capture Sunshine (compositeur racine, --backend drm ET
#    headless, avec et sans --hdr-enabled/--expose-wayland) : jamais
#    fonctionnel, 3 échecs systématiques — portalgrab (RemoteDesktop/
#    ScreenCast absents du bus D-Bus), capture=kms ("Missing Wayland wire
#    XDG_OUTPUT", liste de moniteurs KMS vide), wlgrab par défaut
#    (EGL_BAD_ACCESS/[00003002] à l'init EGL). Confirmé indépendamment par
#    le projet Wolf (games-on-whales, streaming Docker+libei) : abandon de
#    gamescope pour Sway, support NVIDIA jugé insuffisant. HDR non atteignable
#    de toute façon avec Sunshine actuel : WLR_RENDERER=vulkan (requis pour
#    exposer wp_color_manager_v1) casse la capture NVIDIA quel que soit le
#    compositeur wlroots (confirmé sur labwc ET documenté indépendamment par
#    github.com/daaaaan/sunshine-headless-sway sur Sway, qui reste sciemment
#    sur WLR_RENDERER=gles2 pour cette raison).
#
#    Piste retenue à la place (même repo daaaaan, adaptée à labwc plutôt que
#    Sway — même famille wlroots, même principe) : un SECOND labwc, headless
#    (WLR_BACKENDS=headless, LIBSEAT_BACKEND=noop, aucun accès DRM/VT réel),
#    strictement dédié à Sunshine/evdev-bridge, indépendant du bureau XFCE
#    visible en local/VNC (svc-labwc, wayland-0). Validé en direct : capture
#    NVENC fonctionnelle (vraies keyframes IDR) contre ce labwc headless —
#    labwc implémente nativement ext_image_copy_capture_manager_v1 (capture
#    moderne) là où gamescope n'expose jamais assez de protocole. Input
#    (evdev-bridge-native inchangé, zwlr_virtual_pointer/zwp_virtual_keyboard)
#    fonctionne aussi nativement, sans le bridge libei exploré pour
#    gamescope (écrit, testé fonctionnel côté input, puis retiré : code mort
#    sans cible de capture viable). Pas de HDR dans cette architecture non
#    plus (toujours WLR_RENDERER par défaut/GLES2) — le seul gain réel est
#    l'isolation bureau/streaming, pas le HDR, qui reste hors de portée.

# Épinglé par digest (audit H2, 05/09), pas "latest" : un rebuild déclenché
# pour une seule ligne (ex: une règle udev) pouvait jusqu'ici faire monter
# silencieusement toute la base — Mesa, wlroots/labwc, Xwayland — sans
# qu'aucun commit ne le documente. Digest résolu le 05/09 (dernier build
# réussi et testé en production) ; pour bumper délibérément la base,
# relancer `docker pull cachyos/cachyos-v3:latest` et copier le nouveau
# digest ici, dans un commit dédié ("bump: base cachyos-v3").
FROM cachyos/cachyos-v3@sha256:8ab75658c3b5f7440615d533331c9f29896f9c9e2a92d4e8760f0d16f005b3a9

# github_token (audit C1, 05/09) : le build fait ~18 appels à l'API GitHub
# (releases "latest" des émulateurs) — non authentifié, la limite est de
# 60 requêtes/heure/IP : deux builds dans l'heure suffisent à faire échouer
# le suivant en "FATAL: URL vide". Passé désormais comme SECRET BuildKit
# (--secret id=github_token,env=GITHUB_TOKEN côté Makefile), lu via
# --mount=type=secret,id=github_token sur chaque RUN qui en a besoin, PAS
# comme ARG : un ARG consommé par un RUN reste visible en clair dans
# l'historique de l'image (`docker history`/`buildx imagetools inspect`)
# pour toujours, alors qu'un secret n'est monté que le temps du RUN et
# n'apparaît jamais dans aucune couche. Confirmé en direct le 05/09 :
# l'ancien ARG GITHUB_TOKEN était bien lisible en clair sur 52 des 74
# couches de l'image déjà poussée sur le registry — token révoqué et
# rebuild fait après ce correctif. Optionnel dans tous les cas : sans
# secret fourni au build, `cat /run/secrets/... 2>/dev/null || true`
# laisse GITHUB_TOKEN vide et ${GITHUB_TOKEN:+...} n'ajoute simplement pas
# le header Authorization.

# Épinglage des émulateurs/outils (audit H2, 05/09) : chacun des 16 appels
# à l'API GitHub "releases/latest" plus bas dispose désormais d'un ARG
# "<OUTIL>_TAG" (ex: CEMU_TAG, RPCS3_TAG, FLIPS_TAG...) — vide par défaut,
# comportement inchangé (résout toujours "latest" dynamiquement). Passer
# `--build-arg CEMU_TAG=v2.0-83` (ou via make : `make push CEMU_TAG=...`,
# à ajouter au Makefile si besoin d'un usage fréquent) fige cet outil sur
# un tag précis au lieu de suivre la dernière release à chaque build —
# utile pour bumper délibérément un seul outil sans que les 79 autres RUN
# ne bougent avec lui, ou pour reproduire une image passée. Non couvert :
# ShadPS4 (liste `/releases` complète, pas `/releases/latest`, pour
# capter des prereleases — mécanisme différent) et decky-loader (télécharge
# toujours le dernier binaire officiel une fois, PUIS se met à jour
# lui-même via son propre mécanisme, voir svc-decky-loader/run — un tag
# figé irait à l'encontre de ce design).

# BUILD_DATE : deuxième --build-arg passé par le Makefile jusqu'ici jamais
# consommé — exposé en label OCI standard, utile pour dater une image
# (`docker inspect` sur le registry) puisque les émulateurs sont tirés en
# "latest" au moment du build.
ARG BUILD_DATE
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="SteamBox" \
      org.opencontainers.image.source="https://github.com/Gunnm92/SteamBox"

# ── 1. Base système + labwc (Wayland) + bureau XFCE + seatd/libinput + GPU (Mesa/Vulkan) ──
# Panne CachyOS multilib (29/08) : lib32-gcc-libs/lib32-glibc — les DEUX
# SEULS paquets multilib que CachyOS rebuild elle-même (pour matcher sa
# toolchain optimisée x86_64_v3) — étaient absents de TOUS les miroirs
# cachyos-v3 (testé un par un), alors que le reste du multilib (dépôt Arch
# standard) fonctionnait très bien. Panne confirmée récurrente sur ce
# rebuild maison (incident quasi identique déjà documenté sur le forum
# CachyOS avec une version antérieure de ces deux mêmes paquets), et étendue
# en cascade à d'autres paquets 64-bit v3 (libpulse, libasyncns) au moment du
# test. Contournement RÉEL (pas une dégradation) trouvé en forçant ces 4
# paquets depuis le dépôt Arch standard (core/extra, mêmes versions logicielles,
# juste non-optimisées v3) plutôt que cachyos-v3/cachyos-extra-v3 — vérifié
# en direct, tout le reste de la chaîne (lib32-vulkan-*, lib32-pipewire,
# lib32-libpulse, dxvk-mingw-git) se résout et télécharge alors sans erreur.
# Si cette panne CachyOS est résolue au moment d'un futur rebuild, ces 4
# lignes "repo/paquet" explicites peuvent être simplifiées en noms de paquet
# nus sans risque (pacman retombera sur cachyos-v3 par défaut, prioritaire).
#
# Groupe pacman "libretro" (15/09) — remplace la liste de ~20 cœurs
# choisis à la main : ne couvrait qu'une fraction des cœurs disponibles en
# dépôt officiel (le groupe en contient ~30, plus les paquets
# retroarch/retroarch-assets-{ozone,xmb,glui}/libretro-shaders-slang/
# libretro-overlays), confirmé en direct après un "menu RetroArch
# incomplet, il manque plein de cœurs" — l'utilisateur ne les téléchargeait
# pas lui-même via pacman puisque le Core Downloader intégré de RetroArch
# est désactivé par défaut sur ce paquet (menu_show_core_updater=false,
# repris tel quel côté init_retroarch.sh pour pointer vers un dossier
# cœurs écrivable en plus du dossier système). Règle ce même "menu Ozone
# dégradé" documenté au commit précédent (retroarch-assets-ozone inclus
# dans le groupe).
# Nouvel essai automatique (22/09, "make push" en échec) : chaque rebuild
# fait un -Syyu complet, donc dépend de l'état des miroirs CachyOS À CET
# INSTANT — confirmé en direct le 22/09 : base de paquets déjà publiée mais
# fichiers pas encore propagés (404 sur cdn77 puis sur us.cachyos.org pour
# bubblewrap .sig/libyuv/luajit/libcanberra), transaction annulée, alors
# que les mêmes fichiers étaient disponibles sur la plupart des miroirs
# quelques minutes plus tard. Jusqu'à 3 essais espacés de 60 s, avec
# resynchronisation de la base (-Syy) à chaque fois ; la transaction
# pacman est atomique ("no packages were upgraded"), rien à nettoyer entre
# deux essais. Rotation des miroirs entre deux essais (24/09) : sur une
# signature invalide, pacman ne passe PAS au miroir suivant, il abandonne —
# vécu en direct, cdn77.cachyos.org (1er de la liste de l'image de base)
# servait une signature périmée pour une base pourtant identique aux autres
# miroirs, trois essais d'affilée sur le même miroir ne pouvaient
# qu'échouer. Le premier miroir de chaque liste CachyOS passe en dernier.
RUN PKGS="sudo vim openssh curl wget tar xz git jq unzip \
      seatd libinput \
      labwc xfdesktop xfce4-panel xfce4-settings xfce4-appfinder xfce4-terminal \
      thunar mousepad xfce4-taskmanager xfce4-pulseaudio-plugin \
      network-manager-applet polkit-gnome \
      xdg-desktop-portal-wlr xdg-desktop-portal-gtk \
      wayvnc python-pip wlr-randr \
      gtk3 \
      xorg-xwayland wayland libxkbcommon \
      mesa vulkan-icd-loader vulkan-tools \
      core/lib32-gcc-libs core/lib32-glibc extra/libpulse extra/libasyncns \
      vulkan-radeon lib32-vulkan-radeon \
      vulkan-intel lib32-vulkan-intel intel-media-driver libva-intel-driver \
      pipewire pipewire-pulse pipewire-alsa wireplumber \
      lib32-pipewire lib32-libpulse \
      lib32-libxrandr lib32-libxi lib32-libxcursor lib32-libxcomposite lib32-libxrender \
      ffmpeg \
      steam \
      sunshine \
      gamemode mangohud \
      dbus polkit networkmanager \
      xdg-desktop-portal \
      gamescope \
      libretro \
      wine-staging winetricks dxvk-mingw-git vkd3d-proton-git \
      squashfuse squashfs-tools fuse-overlayfs \
      libnotify cabextract p7zip binutils nss \
      ark unrar zip \
      sdl2_image sdl2_mixer sdl2_ttf sdl2_gfx \
      dolphin-emu scummvm \
      papirus-icon-theme hicolor-icon-theme adwaita-icon-theme \
      ttf-jetbrains-mono-nerd cantarell-fonts noto-fonts ttf-dejavu \
      libva-utils \
      qt6-multimedia \
      gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav \
      flatpak" && \
    for i in 1 2 3; do \
      pacman -Syyu --noconfirm && pacman -S --noconfirm --needed ${PKGS} && break; \
      [ "${i}" = 3 ] && { echo "FATAL: pacman en échec après 3 essais (miroirs CachyOS)"; exit 1; }; \
      echo "pacman : échec (miroirs désynchronisés ?), nouvel essai $((i + 1))/3 dans 60 s"; \
      for f in /etc/pacman.d/cachyos*mirrorlist; do \
        awk '/^Server/ && !moved {first=$0; moved=1; next} {print} END {if (moved) print first}' "$f" > "$f.new" && mv "$f.new" "$f"; \
      done; \
      echo "pacman : miroirs CachyOS décalés, nouveau premier : $(grep -m1 '^Server' /etc/pacman.d/cachyos-mirrorlist)"; \
      sleep 60; \
    done && \
    pacman -Scc --noconfirm

# qt6-multimedia (audit menu XFCE 31/08) : melonDS a besoin de
# libQt6Multimedia.so.6 au runtime mais ne l'embarque pas dans son zip
# (contrairement à RPCS3/Azahar/ShadPS4 qui embarquent leur propre copie
# dans leur AppDir) — "cannot open shared object file" confirmé en direct
# sans ce paquet.
#
# gst-plugins-good/bad + gst-libav (20/09, "Pegasus n'arrive pas à lire les
# vidéos de preview") : qt6-multimedia tire gstreamer/gst-plugins-base-libs/
# gst-plugins-bad-libs en dépendance, mais ce sont uniquement des paquets
# "-libs" (bibliothèques partagées pour compiler contre, aucun greffon
# chargeable) — confirmé en direct via `gst-inspect-1.0`, aucun démultiplexeur
# MP4/QuickTime disponible. Pegasus (pegasus-fe) lie directement
# libgstreamer-1.0 pour ses vidéos de preview, pas seulement via
# qt6-multimedia : reproduit en direct avec `gst-launch-1.0 ... decodebin`
# sur une vraie vidéo scrapée (RetroBat/downloaded_media/.../*.mp4) —
# "Élément manquant : Démultiplexeur Quicktime". Le décodage H.264 lui-même
# fonctionnait déjà (accélération matérielle NVDEC/Vulkan présente), seul le
# conteneur MP4 ne pouvait pas être ouvert. gst-plugins-good fournit qtdemux
# (MP4/MOV) et la plupart des formats courants ; gst-plugins-bad et
# gst-libav (décodeurs de secours via FFmpeg) ajoutés pour une couverture
# large plutôt que corriger un format à la fois.
# gst-plugins-ugly (23/09) : asfdemux (ASF/WMV) n'est QUE là — les vidéos
# .wmv des jeux wsquashfs passent par winegstreamer et échouaient ("Missing
# decoder: Advanced Streaming Format"), confirmé en direct : BlazBlue Central
# Fiction (nesicax) quittait au lancement.
#
# flatpak (demandé 31/08) — xdg-desktop-portal(-gtk/-wlr) déjà installés
# ci-dessus couvrent les besoins runtime des apps Flatpak (permissions,
# ouverture de fichiers). Flathub ajouté comme remote système juste
# en dessous pour que le paquet soit utilisable dès le premier lancement,
# sans étape manuelle côté utilisateur.
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# nvidia-vaapi-driver — pont VA-API→NVDEC/NVENC pour NVIDIA (projet
# elFarto/nvidia-vaapi-driver), porté depuis le fix Dockerfile.ubuntu (audit
# 2026-08-26, "steam link fait crasher steam" : Steam Remote Play encode
# TOUJOURS via VA-API sous Linux, quel que soit le vendeur GPU, jamais un
# appel NVENC direct). Aucun paquet officiel Arch/CachyOS (core/extra/
# cachyos-*) — AUR-only, et PAS sous le nom du projet upstream : le paquet
# AUR s'appelle "libva-nvidia-driver-git" (confirmé via l'API AUR, URL
# github.com/elFarto/nvidia-vaapi-driver) — "nvidia-vaapi-driver" tout court
# clone un dépôt AUR vide (aucune erreur git, juste 0 commit). Buildé via
# makepkg (git/gcc/make/fakeroot déjà présents dans l'image — voir
# dxvk-mingw-git/vkd3d-proton-git plus haut, déjà des paquets -git) plutôt
# qu'extrait binaire comme Chrome : projet C minuscule, build de quelques
# secondes, pas la même échelle qu'un navigateur. meson/ninja/libva/
# ffnvcodec-headers = makedepends du PKGBUILD AUR, supprimés après coup
# avec le user de build temporaire.
# ludusavi (sauvegarde/restauration des saves de jeux, backend de la
# fonctionnalité "Ludusavi Manager" de Heroic) ajouté dans la MÊME session
# de build AUR que nvidia-vaapi-driver ci-dessus (un seul aller-retour
# useradd/userdel) : suite à l'audit du 29/08 sur le prefix Wine "shared"
# corrompu par nos changements de Proton successifs (voir commit sur
# install-nvidia-userspace.sh) — le prefix Wine ne doit plus être la seule
# copie des sauvegardes. Version "-bin" choisie (binaire précompilé upstream)
# plutôt que "ludusavi" source : évite d'ajouter toute la toolchain Rust/
# cargo à l'image pour un seul outil. depends du PKGBUILD (bzip2, gtk3,
# hicolor-icon-theme, libgcc) ajoutés aux paquets normaux car ce sont des
# dépendances RUNTIME (pas des makedepends) — elles doivent rester après
# le nettoyage, contrairement à meson/ninja plus bas.
# eden-nightly-bin (29/08) — build nightly de l'émulateur Switch Eden (fork
# de yuzu), ajouté dans la même session AUR. Variante "-bin" (AppImage
# précompilée par le CI du projet, juste extraite/installée) plutôt que
# "eden-nightly" source : évite d'ajouter Qt/LLVM/boost et une compilation
# C++ énorme à l'image pour un émulateur qui sort déjà un binaire tout fait.
# Dépendance runtime unique : hicolor-icon-theme (déjà installé plus haut).
#
# PKGBUILD upstream patché (bloc package(), via un petit script Python plutôt
# qu'un sed en ligne : trop d'imbrication de guillemets Dockerfile+shell+sed
# pour un remplacement multi-lignes propre) pour extraire l'AppImage
# (squashfs-root, déjà produit par prepare()/build() du PKGBUILD via
# --appimage-extract) et l'installer sous /opt/eden avec un wrapper shell
# exécutant AppRun — au lieu de copier le .AppImage brut sous
# /opt/${pkgname} (nécessite FUSE à chaque lancement). Exactement le
# comportement de l'ancien install manuel retiré plus haut : pas de FUSE
# requis au runtime, et des raccourcis/scripts existants pointent sur ce
# chemin /opt/eden précis.
# decky-loader (31/08, demande utilisateur) — chargeur de plugins Steam
# Deck (SteamDeckHomebrew/decky-loader). PAS installé via AUR (revu le
# 01/09) : le paquet AUR construit un wheel Python (via poetry) lancé comme
# module normal (/usr/bin/decky-loader) — un modèle de déploiement
# INCOMPATIBLE avec le mécanisme d'auto-update propre à decky, qui suppose
# toujours un binaire autonome nommé littéralement "PluginLoader" vivant
# dans son propre dossier de travail (voir updater.py:
# download_decky_binary — remove()/shutil.move() sur ce nom précis) :
# confirmé en direct, l'AUR laissait l'auto-update de decky totalement
# bloquée quel que soit le contournement systemd. Le vrai binaire officiel
# (release GitHub SteamDeckHomebrew/decky-loader, asset "PluginLoader",
# PyInstaller autonome) est téléchargé ici et copié au runtime par
# svc-decky-loader — voir ce fichier pour le détail du mécanisme d'update
# et le shim systemctl qui l'accompagne (root-cachyos/usr/local/bin/
# systemctl). Seules les dépendances RUNTIME des PLUGINS restent utiles ici
# (les plugins tiers comme CSS Loader tournent en process Python séparé,
# via l'interpréteur système, pas le binaire PyInstaller autonome de decky
# lui-même) : python-aiohttp-jinja2/-cors sont AUR-only, buildées dans
# build-aur.sh ; le reste (python-aiohttp/-watchdog/-certifi/-packaging/
# -multidict/-setproctitle/-jinja) vient des dépôts officiels.
RUN pacman -S --noconfirm --needed \
      meson ninja libva ffnvcodec-headers \
      bzip2 gtk3 hicolor-icon-theme libgcc \
      python python-aiohttp python-watchdog python-certifi python-packaging \
      python-multidict python-setproctitle python-jinja \
      python-setuptools python-wheel && \
    useradd -m -s /bin/bash aur-builder && \
    echo 'aur-builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/aur-builder

COPY <<'PATCH_EDEN_EOF' /tmp/patch-eden-pkgbuild.py
import pathlib
p = pathlib.Path("/tmp/eden-nightly-bin/PKGBUILD")
c = p.read_text()
old = (
    'package() {\n'
    '    install -Dm755 "${_appimage}" "${pkgdir}/opt/${pkgname}/${pkgname}.AppImage"\n'
)
new = (
    'package() {\n'
    '    install -dm755 "${pkgdir}/opt/eden"\n'
    '    cp -a squashfs-root/. "${pkgdir}/opt/eden/"\n'
    '    install -dm755 "${pkgdir}/usr/bin"\n'
    '    printf \'#!/bin/sh\\ncd /opt/eden && exec ./AppRun "$@"\\n\' > "${pkgdir}/usr/bin/eden"\n'
    '    chmod +x "${pkgdir}/usr/bin/eden"\n'
)
assert old in c, "bloc install introuvable dans PKGBUILD"
c = c.replace(old, new)
old2 = '    install -dm755 "${pkgdir}/usr/bin"\n    ln -s "/opt/${pkgname}/${pkgname}.AppImage" "${pkgdir}/usr/bin/eden"\n'
assert old2 in c, "bloc ln -s introuvable dans PKGBUILD"
c = c.replace(old2, "")
p.write_text(c)
print("PKGBUILD eden patche avec succes")
PATCH_EDEN_EOF

COPY <<'BUILD_AUR_EOF' /tmp/build-aur.sh
#!/bin/bash
set -e
cd /tmp
git clone --depth 1 https://aur.archlinux.org/libva-nvidia-driver-git.git
cd libva-nvidia-driver-git
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/ludusavi-bin.git
cd ludusavi-bin
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/eden-nightly-bin.git
python3 /tmp/patch-eden-pkgbuild.py
cd eden-nightly-bin
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/python-aiohttp-jinja2.git
cd python-aiohttp-jinja2
makepkg -si --noconfirm --needed

cd /tmp
git clone --depth 1 https://aur.archlinux.org/python-aiohttp-cors.git
cd python-aiohttp-cors
makepkg -si --noconfirm --needed

# freeimage (24/09) : dépendance de build ET d'exécution de Batocera
# EmulationStation (bloc 1a7), retirée des dépôts officiels Arch.
cd /tmp
git clone --depth 1 https://aur.archlinux.org/freeimage.git
cd freeimage
makepkg -si --noconfirm --needed
BUILD_AUR_EOF

RUN chown aur-builder:aur-builder /tmp/build-aur.sh /tmp/patch-eden-pkgbuild.py && \
    chmod +x /tmp/build-aur.sh && \
    su aur-builder -c /tmp/build-aur.sh && \
    rm -f /etc/sudoers.d/aur-builder /tmp/build-aur.sh /tmp/patch-eden-pkgbuild.py && \
    userdel -r aur-builder && \
    rm -rf /tmp/libva-nvidia-driver-git /tmp/ludusavi-bin /tmp/eden-nightly-bin \
           /tmp/python-aiohttp-jinja2 /tmp/python-aiohttp-cors /tmp/freeimage && \
    pacman -Rns --noconfirm meson ninja && \
    pacman -Scc --noconfirm

# decky-loader — binaire officiel PyInstaller (voir commentaire plus haut),
# pas de build. Placé sous /opt (dans l'image, PAS sous /home/arcade — ce
# chemin est recouvert par le volume /config au runtime) : svc-decky-loader
# le copie vers ${DECKY_VAR_DATA}/PluginLoader au premier démarrage
# seulement (idempotent), pour ne jamais écraser une version que
# l'auto-update de decky aurait déjà installée sur le volume persistant.
RUN mkdir -p /opt/decky-loader && \
    curl -fsSL -o /opt/decky-loader/PluginLoader \
      "https://github.com/SteamDeckHomebrew/decky-loader/releases/latest/download/PluginLoader" && \
    chmod +x /opt/decky-loader/PluginLoader

# systemctl (shim) — decky-loader appelle "systemctl restart/stop/start/
# is-active plugin_loader" + "daemon-reload" pour s'auto-redémarrer après
# une mise à jour (updater.py: service_restart/service_stop/service_start/
# service_active) — ce conteneur n'a pas de vrai systemd (PID 1 = s6-
# svscan). Shim en shell qui traduit ces appels précis vers s6-svc sur
# svc-decky-loader ; /usr/local/bin passe avant /usr/sbin (où vit le vrai
# systemctl, utilisé par systemd-udevd/NetworkManager ailleurs dans cette
# image — jamais touché, seul le nom de service "plugin_loader" est
# intercepté ici, tout le reste retombe sur le vrai binaire).
COPY root-cachyos/usr/local/bin/systemctl /usr/local/bin/systemctl
RUN chmod +x /usr/local/bin/systemctl

# Outils de build partagés (audit 22/09) — gh-asset-url (résolution d'un
# asset de release GitHub, secret github_token compris, échec franc si rien
# ne correspond) et install-appimage (extraction + lanceur + .desktop) :
# remplacent ~15 copies du même code curl/grep/extraction qui avaient
# divergé au fil des correctifs (voir chacun des deux scripts pour le
# détail). Placés hors du PATH (outils de build, quelques Ko).
COPY root-cachyos/build/ /usr/local/lib/steambox-build/
RUN chmod +x /usr/local/lib/steambox-build/*

# Heroic (Epic/GOG/Amazon) — paquet Arch officiel publié par le projet à
# chaque release GitHub (Heroic-x.y.z-linux-x64.pacman), plus le
# heroic-games-launcher-bin du dépôt cachyos (22/09) : ce dernier suit
# l'amont avec retard (2.22.1 dans l'image alors que la 2.22.3 était sortie,
# AUR compris, depuis le 16/09) — incompatible avec la règle "chaque rebuild
# prend la dernière version". Même nom de dossier (/opt/Heroic) que le
# paquet cachyos : prefixes, config (~/.config/heroic) et raccourcis Steam
# existants restent valides. Dépendances résolues par pacman depuis les
# dépôts (toutes présentes, vérifié le 22/09 ; libappindicator-gtk3 est
# fournie par libappindicator).
# Le scriptlet post_install du paquet ne s'exécute PAS ici (pacman refuse
# les scriptlets sous le sandbox réseau de BuildKit, voir "could not isolate
# the network" plus haut) : ses deux effets utiles sont reproduits à la main
# — lien /usr/bin/heroic, et chrome-sandbox en 0755 (état identique au
# paquet cachyos, fonctionnel en prod).
ARG HEROIC_TAG=""
RUN --mount=type=secret,id=github_token \
    HEROIC_URL=$(/usr/local/lib/steambox-build/gh-asset-url Heroic-Games-Launcher/HeroicGamesLauncher "${HEROIC_TAG}" 'linux-x64\.pacman$') && \
    curl -fSL --retry 3 -o /tmp/heroic.pkg.tar.xz "${HEROIC_URL}" && \
    pacman -U --noconfirm --needed /tmp/heroic.pkg.tar.xz && \
    ln -sf /opt/Heroic/heroic /usr/bin/heroic && \
    chmod 0755 /opt/Heroic/chrome-sandbox && \
    rm -f /tmp/heroic.pkg.tar.xz && \
    pacman -Scc --noconfirm

# DISPLAY sur Ludusavi, Dolphin et Winetricks (audit menu XFCE 31/08 puis
# 18/09) : ces apps nécessitaient un sed sur leur .desktop upstream pour
# forcer DISPLAY=:0 (Ludusavi : "neither WAYLAND_DISPLAY nor
# WAYLAND_SOCKET nor DISPLAY is set" ; Dolphin : "Aborted" silencieux sans
# DISPLAY+WAYLAND_DISPLAY ; Winetricks : "DISPLAY not set, not defaulting
# to gui", son vrai menu se fermait sans jamais s'afficher). Un détour par
# un script x11-wrap.sh choisissant :0 ou :1 selon le WAYLAND_DISPLAY
# hérité a été essayé le même jour (18/09) puis abandonné : plus
# nécessaire depuis que wayland-session.sh exporte DISPLAY/WAYLAND_DISPLAY
# explicitement pour tout le bureau visible avant de lancer XFCE,
# symétrique à sunshine-desktop-xfce.sh côté headless (voir
# wayland-session.sh). Les .desktop upstream (paquets AUR/pacman) restent
# donc intacts, sans aucun patch.

# Steam (gamepadui) interroge NetworkManager via D-Bus pour son statut réseau
# et reste bloqué sur "waiting for network" sans ce service, même quand la
# connectivité réelle est bonne (observé : ses propres tests de connectivité
# HTTP passent, mais "Init: failed to create a NetworkManager client" bloque
# quand même l'écran de login). unmanaged-devices=* est CRITIQUE en
# network_mode: host : NetworkManager voit alors les vraies interfaces de
# l'hôte Unraid — sans ce réglage il pourrait tenter de les gérer/reconfigurer.
RUN mkdir -p /etc/NetworkManager && \
    printf '[main]\nplugins=keyfile\n\n[keyfile]\nunmanaged-devices=*\n' \
      > /etc/NetworkManager/NetworkManager.conf

# UPower désactivé côté activation D-Bus (audit live, 05/09) — steamwebhelper
# (CEF, lancé par Sunshine à chaque connexion Moonlight via "steam -gamepadui")
# interroge org.freedesktop.UPower en continu pendant toute la durée d'une
# session (API standard Chromium de statut batterie/alimentation). Ce
# conteneur n'a pas de polkit fonctionnel (pas de logind sous s6, même cause
# que le NetworkManager.conf ci-dessus) : upowerd meurt donc immédiatement
# ("failed to get polkit authority", SIGABRT) à chaque activation, et D-Bus
# le relance aussitôt à la requête suivante de Steam — confirmé en DIRECT
# pendant une vraie session : ~1700 crashs en 25 minutes, environ un par
# seconde en continu tout le temps que Steam tourne. Supprimer le fichier
# d'activation fait échouer la requête D-Bus proprement et immédiatement
# (ServiceUnknown) au lieu de forker un process voué à crasher — Chromium
# gère nativement l'absence d'UPower (comportement standard hors Linux
# desktop), aucun impact observé sur Steam. Rien dans ce conteneur headless
# n'a de vraie batterie à surveiller de toute façon.
RUN rm -f /usr/share/dbus-1/system-services/org.freedesktop.UPower.service

# ── 1a2. Locale française — absente du glibc CachyOS (build allégé, seuls les
# locales en_* sont incluses ; fr_FR/*.fr manquent totalement). Le fichier de
# définition est un format texte stable côté glibc upstream — recréé depuis
# le miroir officiel plutôt que de basculer sur le paquet glibc standard
# d'Arch (risqué : glibc est la libc système, pas question d'en changer).
RUN curl -fsSL https://raw.githubusercontent.com/bminor/glibc/master/localedata/locales/fr_FR \
      -o /usr/share/i18n/locales/fr_FR && \
    localedef -i fr_FR -f UTF-8 fr_FR.UTF-8

# ── 1a3. Schémas GSettings — non compilés au build (hook pacman bloqué par le
# sandbox réseau de buildkit, cf. "could not isolate the network" pendant
# pacman -Scc). xdg-desktop-portal (utilisé par waybar/Steam) crashe
# immédiatement sans /usr/share/glib-2.0/schemas/gschemas.compiled.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas/

# ── 1a3b. Cache MIME — même classe de hook pacman bloqué au build. Sans
# /usr/share/mime/mime.cache, gdk-pixbuf ne peut pas identifier le format
# d'un fichier avant de le déléguer à glycin (nouveau backend de décodage
# d'image sandboxé) — TOUTE image (PNG compris, pas seulement SVG) échoue à
# charger ("Couldn't recognize the image file format"), et n'importe quelle
# appli GTK3 qui tente d'afficher une icône (même une icône interne, ex. le
# menu applications nwg-drawer) plante instantanément dessus.
RUN update-mime-database /usr/share/mime

# ── 1a3c'. Config xdg-desktop-portal — sans elle, ScreenCast (Steam Link,
# PipeWire) n'est JAMAIS enregistré, même avec xdg-desktop-portal-wlr
# installé et un WAYLAND_DISPLAY correct (confirmé en direct 07/09, voir
# scripts/steam-link-launch.sh pour l'historique complet du diagnostic).
# xdg-desktop-portal choisit son backend par interface selon un fichier
# nommé d'après $XDG_CURRENT_DESKTOP (ex: xfce-portals.conf pour "XFCE",
# la valeur que ce projet utilise partout — voir wayland-session.sh) ; le
# paquet xdg-desktop-portal-wlr ne fournit que wlr-portals.conf (nom "wlr",
# jamais chargé puisque XDG_CURRENT_DESKTOP ne vaut jamais littéralement
# "wlr" ici). Sans fichier correspondant, AUCUN backend n'est choisi pour
# ScreenCast/Screenshot — ni gtk (qui ne les implémente pas) ni wlr (jamais
# sélectionné) — l'interface disparaît purement et simplement de l'objet
# org.freedesktop.portal.Desktop, confirmé par une introspection D-Bus
# directe et par le log Steam ("L'interface org.freedesktop.portal.
# ScreenCast n'existe pas"). Testé en direct avec ce fichier + XDG_CURRENT_
# DESKTOP=XFCE exporté avant le lancement du portail : "XDP: Using
# wlr.portal for org.freedesktop.impl.portal.ScreenCast (default config)".
RUN mkdir -p /etc/xdg-desktop-portal && \
    printf '[preferred]\ndefault=wlr\n' > /etc/xdg-desktop-portal/xfce-portals.conf

# ── 1a3c. steam toujours avec -pipewire — Remote Play/Steam Link a besoin de
# ce flag pour la capture vidéo (sinon : "Unable to capture video:
# k_ECaptureFailedReasonPipewireRequired" après ~1 min de stream, confirmé
# dans streaming_log.txt). On avait ce flag via l'auto-lancement Big Picture
# retiré depuis — un wrapper le réapplique quel que soit le point d'entrée
# (dock, menu applications, app Sunshine), /usr/local/bin passant avant
# /usr/bin dans le PATH.
#
# -steamos3 -steampal -steamdeck (31/08, decky-loader) : sans détecter un
# vrai Steam Deck, Steam lance steamwebhelper avec --disable-quick-menu —
# désactivant tout le Quick Access Menu (QAM), l'endroit exact où
# decky-loader affiche son icône. La variable d'env SteamDeck=1 (essayée en
# premier) est INSUFFISANTE — confirmé en direct : --disable-quick-menu
# reste présent même avec cette variable fixée avant le lancement, elle ne
# sert qu'à l'API jeu IsSteamRunningOnSteamDeck(), pas à la décision interne
# du client sur ses propres flags d'UI. Le vrai mécanisme est un trio de
# flags CLI, trouvé dans le script officiel ChimeraOS/gamescope-session-steam
# (dont ce projet reprend déjà steamos-session-select.sh) :
# CLIENTCMD="steam -gamepadui -steamos3 -steampal -steamdeck". Testé en
# direct dans un terminal avec les trois flags ensemble : QAM + decky
# visibles, session stable — une suspicion initiale que -steamos3 cassait
# gamescope/labwc (erreurs vues au même moment dans les logs) n'a pas
# résisté à un nouveau test ciblé, très probablement du bruit sans lien.
# SDL_JOYSTICK_HIDAPI_PS5_RUMBLE (04/09, demande utilisateur — vibration
# DualSense/Moonlight aléatoire) — active les "extended input reports" du
# driver HIDAPI PS5 de SDL, nécessaires pour un rumble fiable ; sans ce
# hint, SDL peut silencieusement retomber sur son driver sysjoystick
# générique (boutons/axes seulement, pas de force feedback), documenté
# comme cause connue de rumble PS5 aléatoire (SDL_HINT_JOYSTICK_HIDAPI_
# PS5_RUMBLE, wiki.libsdl.org). Mitigation seulement : la cause racine
# réelle (Sunshine régénère un nouvel identifiant HID pour sa manette
# virtuelle à CHAQUE session Moonlight, donc Steam recrée un profil vierge
# à chaque fois) est un bug amont non résolu de Sunshine, sans correctif
# connu côté udev/config — voir LizardByte/Sunshine#3404.
RUN printf '#!/bin/sh\nexec env SDL_JOYSTICK_HIDAPI_PS5_RUMBLE=1 /usr/bin/steam -pipewire -steamos3 -steampal -steamdeck "$@"\n' > /usr/local/bin/steam && \
    chmod +x /usr/local/bin/steam

# ── 1a3d. xfdesktop-settings forcé sur Xwayland (30/08) — sous labwc/
# Wayland natif, sa détection de sortie échoue et il écrit ses réglages
# (fond d'écran) sur "monitorUnknown" au lieu du vrai connecteur
# "monitorHDMI-A-1" que le xfdesktop réellement affiché lit — un changement
# fait depuis le dialogue (clic droit bureau > Réglages du bureau) restait
# donc sans aucun effet visible, confirmé en direct. Forcer GDK_BACKEND=x11
# fait passer sa détection de sortie par XRandR (Xwayland), qui remonte le
# vrai nom de connecteur — écrit alors correctement sur monitorHDMI-A-1.
#
# DISPLAY=:0 en dur retiré (22/09, même motif que fc1f70a) : DISPLAY est
# désormais ambiant dans les deux bureaux (wayland-session.sh côté visible,
# sunshine-desktop-xfce.sh côté Moonlight) — ouvert depuis l'app "Desktop"
# de Moonlight, le dialogue s'affichait sur le VNC au lieu du stream.
RUN printf '#!/bin/sh\nexec env GDK_BACKEND=x11 /usr/sbin/xfdesktop-settings "$@"\n' \
      > /usr/local/bin/xfdesktop-settings && \
    chmod +x /usr/local/bin/xfdesktop-settings

# ── 1a6. DXVK — injecte les DLL dans les préfixes Wine (dxvk-mingw-git ne le
# fait pas tout seul, contrairement à un vrai paquet dxvk-bin ; setup.sh doit
# tourner explicitement, généralement au 1er lancement d'un préfixe). Non
# automatisé : tous les jeux de ce conteneur tournent en Proton (GE-Proton
# via Heroic), qui embarque et configure sa propre DXVK/DXVK-NVAPI — vérifié
# le 30/08 sur le prefix Alan Wake 2 (nvapi64.dll + DXVK_ENABLE_NVAPI=1 déjà
# présents, posés par Proton lui-même). Un wrapper wine avait été ajouté
# puis retiré le 30/08 : aucun jeu ne passe par le wine système, donc aucune
# utilité réelle tant que ça reste le cas.
RUN ln -sf /usr/share/dxvk/setup_dxvk.sh /usr/local/bin/dxvk_setup 2>/dev/null || true

# ── 1a7. Batocera EmulationStation (24/09) — frontend des jeux rétro/arcade,
# remplace Pegasus : sa SDL 2.0.20 embarquée ne lisait pas la DualSense
# virtuelle de Sunshine (confirmé en direct), build X11 seulement, et il
# fallait réécrire les metadata.pegasus.txt de RomM. La version Batocera
# d'ES lit directement les gamelist.xml de la ludothèque AVEC leurs chemins
# de médias (./covers/, ./videos/, ./marquees/...), tels que RomM/Batocera
# les écrivent — ES-DE, lui, ignore ces chemins (arborescence de médias
# propre). Pas de paquet ni de release binaire : compilé depuis les sources
# (instructions Arch officielles du README), freeimage vient d'AUR (bloc
# build-aur.sh plus haut). ES_REF : branche/tag, vide = branche par défaut.
#   -DGL=ON          OpenGL bureau (NVIDIA/Mesa), pas GLES
#   -DCEC=OFF        pas de HDMI-CEC dans un conteneur
#   -DENABLE_PULSE=ON contrôle du volume via PulseAudio/PipeWire au lieu
#                    d'ALSA ("Failed to attach to default card" sinon)
# Les systèmes (es_systems.cfg) et réglages par défaut sont écrits au
# démarrage par init_emulationstation.sh ; chaque jeu passe par
# game-launch.sh. Thème Carbon (celui de Batocera, dépôt amont référencé
# par leur buildroot) dans /usr/share/emulationstation/themes, lié dans
# ~/.emulationstation/themes par l'init (seul dossier de thèmes que lit un
# build non-Batocera). Traductions (.mo) dans /usr/share/locale : sous
# Linux ES passe par gettext (bindtextdomain sur ./locale/lang relatif au
# dossier COURANT, sinon /usr/share/locale) ; resources/locale n'est lu que
# par le build Windows — installées ailleurs, ES restait en anglais malgré
# LANG=fr_FR.UTF-8 (confirmé en direct, deux fois). vlc-plugin-ffmpeg : décodage H.264/AAC des vidéos
# d'aperçu (MP4) par libVLC — sans lui, aucun décodeur H.264 logiciel.
ARG ES_REF=""
RUN pacman -S --noconfirm --needed cmake boost rapidjson glu sdl2_mixer \
      libvlc vlc-plugins-base vlc-plugin-ffmpeg && \
    git clone --recursive --depth 1 ${ES_REF:+--branch "${ES_REF}"} \
      https://github.com/batocera-linux/batocera-emulationstation.git /tmp/batocera-es && \
    cd /tmp/batocera-es && \
    git log -1 --format='batocera-emulationstation %h (%cs)' && \
    cmake -DGL=ON -DCEC=OFF -DENABLE_PULSE=ON -DCMAKE_BUILD_TYPE=Release . && \
    make -j"$(nproc)" && \
    mkdir -p /opt/batocera-es && \
    strip -o /opt/batocera-es/emulationstation emulationstation && \
    cp -a resources /opt/batocera-es/ && \
    for d in locale/lang/*/; do \
      [ -f "${d}LC_MESSAGES/emulationstation2.mo" ] || continue; \
      install -Dm644 "${d}LC_MESSAGES/emulationstation2.mo" \
        "/usr/share/locale/$(basename "${d}")/LC_MESSAGES/emulationstation2.mo"; \
    done && \
    [ -f /usr/share/locale/fr/LC_MESSAGES/emulationstation2.mo ] \
      || { echo "FATAL: traduction française d'ES absente"; exit 1; } && \
    git clone --depth 1 https://github.com/fabricecaruso/es-theme-carbon.git \
      /usr/share/emulationstation/themes/es-theme-carbon && \
    rm -rf /usr/share/emulationstation/themes/es-theme-carbon/.git && \
    printf '[Desktop Entry]\nType=Application\nName=EmulationStation\nExec=/opt/batocera-es/emulationstation\nIcon=/opt/batocera-es/resources/window_icon_256.png\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/emulationstation.desktop && \
    cd / && rm -rf /tmp/batocera-es && \
    pacman -Rns --noconfirm cmake boost rapidjson && \
    pacman -Scc --noconfirm && \
    ldd /opt/batocera-es/emulationstation | grep -q "not found" \
      && { echo "FATAL: bibliothèque manquante pour emulationstation"; exit 1; } || true

# Manettes par défaut d'ES (consulté quand ~/.emulationstation/es_input.cfg
# ne connaît pas une manette) : base Batocera (clavier + 314 manettes) +
# DualSense virtuelle de Sunshine (identifiant SDL récent, absent de la base).
COPY root-cachyos/opt/batocera-es/es_input.cfg /opt/batocera-es/es_input.cfg

# ── 1a7b. Steam (gamepadui) niché dans gamescope — remplace l'entrée de
# menu XFCE "Steam" générique du paquet (Exec=/usr/bin/steam nu, sans
# wrapper gamescope) qui échoue avec "Check your DISPLAY environment
# variable" — confirmé en direct le 30/08, aucun serveur X dans cette
# session Wayland pure sans passer par gamescope. Une seule entrée "Steam"
# désormais, celle qui fonctionne réellement.
RUN printf '[Desktop Entry]\nType=Application\nName=Steam\nExec=/usr/local/bin/scripts/steam-gamescope-launch.sh\nIcon=steam\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam.desktop

# "Steam (Bureau)" — client Steam classique (bibliothèque, réglages, ajout
# de jeux non-Steam) en fenêtre normale sur le bureau XFCE/
# labwc, via l'Xwayland de labwc (distinct de l'Xwayland niché de gamescope
# utilisé par l'entrée "Steam" gamepadui ci-dessus). Pas de -gamepadui :
# interface desktop normale. DISPLAY=:0 en dur retiré (22/09, même motif
# que l'ancien Pegasus) : DISPLAY ambiant, :0 sur le bureau visible, :1
# depuis l'app "Desktop" de Moonlight.
RUN printf '[Desktop Entry]\nType=Application\nName=Steam (Bureau)\nExec=env QT_QPA_PLATFORM=xcb /usr/local/bin/steam\nIcon=steam\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam-desktop.desktop

# "Steam (Steam Link)" — raccourci séparé de l'entrée Sunshine "Steam Big
# Picture" (apps.json, volontairement laissée telle quelle : elle marche
# déjà pour Moonlight). Demande utilisateur (07/09) : pouvoir aussi utiliser
# Steam Link (meilleur support manette dans certains cas) — lance Steam sur
# wayland-1 via steam-link-launch.sh, qui l'isole sur son propre bus D-Bus
# pour que xdg-desktop-portal-wlr (ScreenCast PipeWire, requis par Steam
# Link pour streamer un jeu) se lie au bon compositeur au lieu du bureau
# visible — voir le script pour le détail du bug (écran noir/-pipewire
# requis) et sa confirmation en direct.
RUN printf '[Desktop Entry]\nType=Application\nName=Steam (Steam Link)\nExec=/usr/local/bin/scripts/steam-link-launch.sh\nIcon=steam\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam-link.desktop

# "Retour au bureau" — ferme gamescope (et Steam avec) pour retrouver XFCE/
# labwc en dessous, sans dépendre du menu Quitter de Steam.
RUN printf '[Desktop Entry]\nType=Application\nName=Retour au bureau\nExec=/usr/local/bin/scripts/exit-to-desktop.sh\nIcon=go-home\nTerminal=false\nCategories=System;\n' \
      > /usr/share/applications/exit-to-desktop.desktop

# ── 1a7c. Thème GTK "Mc-OS-CTLina-XFCE-Dark" (macOS Catalina, sombre) —
# fourni par l'utilisateur (gnome-look.org, page bloquée par anti-bot Anubis,
# récupéré manuellement), vendored à la racine du dépôt comme evdev-bridge.
# Pas d'index.theme dans l'archive (contient juste gtk-2.0/ + gtk-3.0/,
# aucun xfwm4/ — sans importance, labwc gère les décorations de fenêtre, pas
# xfwm4) : on en génère un minimal pour qu'il apparaisse correctement dans
# le sélecteur de thème xfce4-appearance-settings.
COPY Mc-OS-CTLina-XFCE-Dark.tar.xz /tmp/theme.tar.xz
RUN mkdir -p /usr/share/themes && \
    tar -xJf /tmp/theme.tar.xz -C /usr/share/themes && \
    printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Mc-OS-CTLina-XFCE-Dark\nComment=macOS Catalina, sombre\n' \
      > /usr/share/themes/Mc-OS-CTLina-XFCE-Dark/index.theme && \
    rm -f /tmp/theme.tar.xz

# gtk.css du thème corrigé (audit 31/08) : 4 erreurs de syntaxe CSS réelles
# dans le fichier fourni, provoquant les "Theme parsing error" au démarrage
# de CHAQUE appli GTK3 du conteneur (RetroArch, Dolphin, Steam ROM Manager,
# Eden, xfce4-terminal...), toujours aux mêmes numéros de ligne — confirmé
# en isolant chaque erreur dans le fichier extrait :
#   - url"linear-gradient(...) : un "url" parasite devant un gradient, pas
#     une URL — probablement un artefact de recherche/remplacement en amont
#   - bloc .nautilus-window .path-bar button (styles Nautilus/GNOME Files,
#     jamais utilisés ici — ce projet utilise Thunar) : tentative de
#     commenter tout le bloc en éparpillant des /* */ ligne par ligne au
#     lieu d'un seul bloc propre — CSS ne supporte pas les commentaires
#     imbriqués, le premier */ rencontré referme prématurément, et le reste
#     du bloc est ensuite lu comme du vrai CSS invalide. Supprimé entièrement
#     plutôt que réparé : déjà mort/désactivé dans l'intention d'origine.
#   - "text-shadow: text-shadow: ..." : propriété dupliquée par erreur
#   - "color:ffffff" : # manquant devant le hex
COPY <<'PATCH_THEME_EOF' /tmp/patch-theme.py
p = '/usr/share/themes/Mc-OS-CTLina-XFCE-Dark/gtk-3.0/gtk.css'
lines = open(p, encoding='utf-8').read().splitlines(keepends=True)
assert 'url"linear-gradient' in lines[7852], 'ligne 7853 inattendue'
lines[7852] = lines[7852].replace('url"linear-gradient', 'linear-gradient')
assert lines[11632].startswith('/*.nautilus-window .path-bar button {'), 'ligne 11633 inattendue'
assert lines[11679].rstrip() == '}', 'ligne 11680 inattendue'
del lines[11632:11680]
c = ''.join(lines)
assert 'text-shadow: text-shadow:' in c
c = c.replace('text-shadow: text-shadow:', 'text-shadow:')
assert 'color:ffffff;' in c
c = c.replace('color:ffffff;', 'color:#ffffff;')
open(p, 'w', encoding='utf-8').write(c)
print('gtk.css theme patche avec succes')
PATCH_THEME_EOF

RUN python3 /tmp/patch-theme.py && rm -f /tmp/patch-theme.py

# ── 1a8. wsquashfs-launcher — lanceur de jeux Windows .wsquashfs (format
# Batocera), projet séparé (github.com/Gunnm92/wsquashfs-launcher) plutôt que
# le script wsquashfs-batocera embarqué dans l'image webstation — plus
# portable (détection auto Docker/FUSE, fallback unsquashfs), maintenu à part.
# ADD d'URL plutôt que RUN curl (23/09) : BuildKit télécharge et compare le
# CONTENU à chaque build — un RUN curl à la commande inchangée restait en
# cache et figeait silencieusement une ancienne version du lanceur tant
# qu'aucune couche antérieure ne bougeait.
ADD --chmod=755 https://raw.githubusercontent.com/Gunnm92/wsquashfs-launcher/main/wsquashfs-launcher \
    /usr/local/bin/wsquashfs-launcher

# ── 1a9. Wine "classique" pour les prefixes win32 (23/09) — wine-staging
# d'Arch est WoW64 seul (pas de lib/wine/i386-unix) et refuse les prefixes
# 32 bits : "... is a 32-bit installation, it cannot support 64-bit
# applications". 8 jeux wsquashfs sur 312 sont dans ce cas (konamipc,
# rawthrills, namcoes3) — confirmé en direct, Lethal Enforcers 3 et
# MachStorm démarrent avec ce build. Build Kron4ek staging NON-wow64
# (i386-unix + x86_64-unix). Installé dans /opt/wine-win32, nom SANS
# "tkg"/"ge" : find_wine_binary() de wsquashfs-launcher ne le prend donc pas
# par défaut — il n'est choisi que pour un prefix win32 (voir
# wine_supports_win32), les 301 autres jeux restent sur wine-staging.
# Dépendances 32 bits : couvertes par les lib32-* déjà présents (Steam,
# Mesa, PipeWire) + lib32-libxrandr/xi/xcursor/xcomposite/xrender ajoutés
# plus haut (changements de résolution, curseur). Pas de lib32-sdl2 dans
# multilib : manettes via le backend udev/hidraw de winebus dans ce cas.
ARG WINE32_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    WINE32_VERSION=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/Kron4ek/Wine-Builds/releases/${WINE32_TAG:+tags/}${WINE32_TAG:-latest}" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${WINE32_VERSION}" ] || { echo "FATAL: WINE32_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/wine32.tar.xz \
      "https://github.com/Kron4ek/Wine-Builds/releases/download/${WINE32_VERSION}/wine-${WINE32_VERSION}-staging-amd64.tar.xz" && \
    mkdir -p /opt/wine-win32 && \
    tar -xf /tmp/wine32.tar.xz -C /opt/wine-win32 --strip-components=1 && \
    rm -f /tmp/wine32.tar.xz && \
    [ -d /opt/wine-win32/lib/wine/i386-unix ] || { echo "FATAL: build Wine sans i386-unix"; exit 1; } && \
    /opt/wine-win32/bin/wine --version

# ── 1a9. Steam ROM Manager — génère des raccourcis Steam pour les ROMs/jeux
# non-Steam (AppImage officielle, pas de paquet Arch/CachyOS).
ARG SRM_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url SteamGridDB/steam-rom-manager "${SRM_TAG}" '[0-9]\.AppImage$' arm64) && \
    WRAPPER_ENV='export APPDIR=/opt/steam-rom-manager' DESKTOP_ARGS='--no-sandbox' \
      /usr/local/lib/steambox-build/install-appimage steam-rom-manager "Steam ROM Manager" "${URL}"

# ── 1a10. Lindbergh Loader (arcade Sega Lindbergh) — AppImage officielle,
# version figée (pas de résolution "latest" pour ce projet).
RUN /usr/local/lib/steambox-build/install-appimage lindbergh "Lindbergh Loader" \
      "https://github.com/lindbergh-loader/lindbergh-loader/releases/download/v2.1.4/lindbergh-loader.AppImage"

# ── 1a11. Supermodel (arcade Sega Model 3) — tarball Linux officiel.
# Échec franc (22/09) au lieu du "skip" silencieux : game-systems.sh lance
# les jeux Model 3 via /usr/local/bin/supermodel — une image construite sans
# lui avait des jeux listés dans le frontend mais impossibles à lancer, sans
# rien au build pour le signaler. Le tarball est désormais publié à chaque
# release (vérifié le 22/09), et curl -f fait échouer un téléchargement
# tronqué au lieu de passer une page d'erreur à tar.
ARG SUPERMODEL_TAG=""
RUN --mount=type=secret,id=github_token \
    SUPERMODEL_URL=$(/usr/local/lib/steambox-build/gh-asset-url trzy/Supermodel "${SUPERMODEL_TAG}" '[Ll]inux[^/]*\.tar[^/]*$') && \
    curl -fSL --retry 3 -o /tmp/supermodel.tar.gz "${SUPERMODEL_URL}" && \
    mkdir -p /opt/supermodel && \
    tar -xzf /tmp/supermodel.tar.gz -C /opt/supermodel --strip-components=1 && \
    [ -x /opt/supermodel/supermodel ] || { echo "FATAL: binaire supermodel absent de l'archive"; exit 1; } && \
    ln -sf /opt/supermodel/supermodel /usr/local/bin/supermodel && \
    rm -f /tmp/supermodel.tar.gz

# ── 1a12. Wine Gecko + Mono — sans ça, tout préfixe Wine invite au
# téléchargement (popup bloquant) au premier lancement d'un installeur/jeu qui
# a besoin du moteur HTML (Gecko) ou de .NET (Mono). Récupéré depuis le miroir
# officiel WineHQ, indépendant de la distro (déjà utilisé sur l'image
# webstation) — wine cherche nativement dans /usr/share/wine/{gecko,mono},
# chemin issu du code amont, pas d'un patch Debian.
#
# Échecs francs (22/09) : les deux .msi Gecko étaient téléchargés avec
# "|| true", et une version vide (addons.c inaccessible ou reformaté)
# produisait des URL invalides sans erreur — l'image partait alors sans
# Gecko, et le popup bloquant réapparaissait sur chaque nouveau préfixe
# sans que rien au build ne l'ait signalé.
RUN ADDONS=$(curl -fsSL --retry 3 "https://raw.githubusercontent.com/wine-mirror/wine/refs/heads/master/dlls/appwiz.cpl/addons.c") && \
    GECKO_VERSION=$(printf '%s' "${ADDONS}" | grep -oP '(?<=GECKO_VERSION ")[^"]+' | head -1) && \
    MONO_VERSION=$(printf '%s' "${ADDONS}" | grep -oP '(?<=MONO_VERSION ")[^"]+' | head -1) && \
    [ -n "${GECKO_VERSION}" ] && [ -n "${MONO_VERSION}" ] || { echo "FATAL: versions Gecko/Mono introuvables dans addons.c"; exit 1; } && \
    mkdir -p /usr/share/wine/gecko /usr/share/wine/mono && \
    for arch in x86 x86_64; do \
      curl -fsSL --retry 3 -o "/usr/share/wine/gecko/wine-gecko-${GECKO_VERSION}-${arch}.msi" \
        "https://dl.winehq.org/wine/wine-gecko/${GECKO_VERSION}/wine-gecko-${GECKO_VERSION}-${arch}.msi" || exit 1; \
    done && \
    curl -fsSL --retry 3 -o "/tmp/wine-mono.tar.xz" \
      "https://dl.winehq.org/wine/wine-mono/${MONO_VERSION}/wine-mono-${MONO_VERSION}-x86.tar.xz" && \
    tar -xf /tmp/wine-mono.tar.xz -C /usr/share/wine/mono && \
    rm -f /tmp/wine-mono.tar.xz

# ── 1a13. Google Chrome — pas de paquet Arch officiel (AUR-only, nécessite un
# helper AUR + base-devel), extrait manuellement du .deb officiel Google
# (même approche que SRM/Lindbergh ci-dessus : curl + extraction, pas
# d'installeur). --ozone-platform=x11 explicite (audit C4, 31/08). Le
# DISPLAY=:0 en dur qui l'accompagnait est retiré (22/09, même motif que
# Pegasus/Steam (Bureau)) : DISPLAY est ambiant dans les deux bureaux, et :0
# en dur ouvrait Chrome sur le VNC depuis l'app "Desktop" de Moonlight.
# chmod 4755 sur chrome-sandbox reproduit ce que fait le postinst du .deb
# (on ne l'exécute pas, on ne prend que data.tar).
RUN curl -fsSL -o /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb" && \
    cd /tmp && ar x chrome.deb && \
    mkdir -p /tmp/chrome-extract && \
    tar -xf data.tar.xz -C /tmp/chrome-extract && \
    mkdir -p /opt/google/chrome && \
    cp -a /tmp/chrome-extract/opt/google/chrome/. /opt/google/chrome/ && \
    ln -sf /opt/google/chrome/google-chrome /usr/local/bin/google-chrome && \
    chmod 4755 /opt/google/chrome/chrome-sandbox && \
    printf '[Desktop Entry]\nType=Application\nName=Google Chrome\nExec=/opt/google/chrome/google-chrome --ozone-platform=x11 %%U\nIcon=/opt/google/chrome/product_logo_256.png\nTerminal=false\nCategories=Network;WebBrowser;\n' \
      > /usr/share/applications/google-chrome.desktop && \
    rm -rf /tmp/chrome.deb /tmp/control.tar.* /tmp/data.tar.* /tmp/debian-binary /tmp/chrome-extract

# ── 1a14. Émulateurs supplémentaires — parité avec la suite bundlée dans
# l'ancienne image de base lscr.io/linuxserver/webstation (dolphin-emu et
# scummvm ci-dessus sont déjà des paquets Arch officiels ; le reste n'a pas
# de paquet Arch/AUR-free, mais chaque projet publie une AppImage/archive
# Linux officielle — pas de build depuis les sources.
#
# Toutes les AppImage passent par install-appimage (22/09, voir ce script
# pour le détail : extraction, cas squashfs-root -> AppDir, lanceur
# "exec /opt/X/AppRun" plutôt qu'un ln -sf). Avant, chaque bloc portait sa
# propre copie de cette logique, et les correctifs n'avaient été reportés
# que sur une partie d'entre eux (PCSX2/DuckStation/Xemu/Xenia/SRM/Flycast
# sans gestion du lien AppDir, lanceurs mixtes ln -sf/wrapper). Pas de
# DISPLAY dans les Exec= : ambiant dans les deux bureaux depuis le 18/09
# (wayland-session.sh / sunshine-desktop-xfce.sh).
ARG PCSX2_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url PCSX2/pcsx2 "${PCSX2_TAG}" 'linux-appimage-x64-Qt\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage pcsx2 "PCSX2" "${URL}"

# PCSX2X6 (22/09) — fork arcade de PCSX2 pour Namco System 246/256
# (PS2Homebrew-arcade/pcsx2x6), l'émulateur qu'utilise Batocera pour le
# système namco2x6. AppImage Linux officielle publiée à chaque release ;
# "latest" = dernière release stable (les préversions sont ignorées par
# /releases/latest). Lancé depuis EmulationStation par game-launch-namco2x6.sh.
ARG PCSX2X6_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url PS2Homebrew-arcade/pcsx2x6 "${PCSX2X6_TAG}" 'linux-appimage-x64-Qt\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage pcsx2x6 "PCSX2X6 (Namco 246/256)" "${URL}"

ARG RPCS3_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url RPCS3/rpcs3-binaries-linux "${RPCS3_TAG}" '_linux64\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage rpcs3 "RPCS3" "${URL}"

ARG DUCKSTATION_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url stenzek/duckstation "${DUCKSTATION_TAG}" 'DuckStation-x64\.AppImage$') && \
    BIN=duckstation-qt /usr/local/lib/steambox-build/install-appimage duckstation "DuckStation" "${URL}"

# Xemu : la release publie aussi une variante -dbg (symboles de debug) au
# même suffixe x86_64.AppImage — exclue explicitement.
ARG XEMU_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url xemu-project/xemu "${XEMU_TAG}" 'x86_64\.AppImage$' dbg) && \
    /usr/local/lib/steambox-build/install-appimage xemu "Xemu" "${URL}"

# Disque dur virtuel Xbox vierge (22/09) — xemu exige un hdd_path ; même
# image que Batocera (release publique mborgerson/xemu-hdd-image 1.0, déjà
# formatée, sans aucun contenu Microsoft). Copiée au premier lancement par
# game-launch-chihiro.sh dans les données utilisateur.
RUN curl -fSL --retry 3 -o /tmp/xbox_hdd.zip \
      "https://github.com/mborgerson/xemu-hdd-image/releases/download/1.0/xbox_hdd.qcow2.zip" && \
    mkdir -p /usr/share/xemu && \
    unzip -q -o -j /tmp/xbox_hdd.zip xbox_hdd.qcow2 -d /usr/share/xemu && \
    chmod 644 /usr/share/xemu/xbox_hdd.qcow2 && \
    rm -f /tmp/xbox_hdd.zip

# Base de données RetroArch (18/09, "Scan Directory"/Manual Scan ne créait
# aucune liste) : content_database_path pointe par défaut sur
# ~/.config/retroarch/database/rdb, un dossier VIDE tant que personne n'a
# lancé "Online Updater > Update Databases" à la main dans RetroArch —
# confirmé en direct (0 fichier .rdb) et aucun paquet pacman ne fournit ces
# .rdb (pas de "libretro-database" dans les dépôts Arch/CachyOS). Avec
# scan_without_core_match=false (défaut), un scan sans base ne matche
# aucun jeu à aucun cœur et ne crée donc aucune entrée de liste — pas un
# bug du scan lui-même, juste une base absente. Téléchargée ici depuis le
# buildbot officiel (même origine que le Core/Asset Downloader intégré,
# juste fait au build plutôt qu'à la main une fois le conteneur démarré)
# et installée dans un chemin système (pas ~/.config, qui reste la donnée
# utilisateur) — init_retroarch.sh pointe content_database_path dessus.
RUN mkdir -p /usr/share/retroarch/database/rdb && \
    curl -fsSL --retry 3 -o /tmp/database-rdb.zip \
      "https://buildbot.libretro.com/assets/frontend/database-rdb.zip" && \
    unzip -q /tmp/database-rdb.zip -d /usr/share/retroarch/database/rdb && \
    rm -f /tmp/database-rdb.zip

# Profils de manettes RetroArch (24/09) — même origine que "Mettre à jour
# les profils de manettes" du menu RetroArch (buildbot officiel), un dossier
# par pilote (udev/, sdl2/...). Sans eux, la DualSense (dont la virtuelle de
# Sunshine) n'avait aucun mapping dans les jeux. init_retroarch.sh les
# copie dans le dossier d'autoconfig utilisateur sans écraser l'existant.
RUN mkdir -p /usr/share/libretro/autoconfig && \
    curl -fsSL --retry 3 -o /tmp/autoconfig.zip \
      "https://buildbot.libretro.com/assets/frontend/autoconfig.zip" && \
    unzip -q /tmp/autoconfig.zip -d /usr/share/libretro/autoconfig && \
    rm -f /tmp/autoconfig.zip && \
    [ -f "/usr/share/libretro/autoconfig/udev/Sony Interactive Entertainment DualSense Wireless Controller.cfg" ] \
      || { echo "FATAL: profil DualSense absent de autoconfig.zip"; exit 1; }

# PPSSPP standalone (18/09) — en plus du core libretro-ppsspp (groupe
# "libretro") : la version standalone (Qt/SDL, pas juste le core RetroArch)
# a son propre frontend avec plus d'options de compatibilité par jeu,
# utile pour les .iso/.cso qui posent problème sous le core seul.
ARG PPSSPP_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url hrydgard/ppsspp "${PPSSPP_TAG}" 'anylinux-x86_64\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage ppsspp "PPSSPP" "${URL}"

# Flycast standalone (18/09) — même logique que PPSSPP ci-dessus : en plus
# du core libretro-flycast (groupe "libretro"), la version standalone
# (flyinghead/flycast) a son propre frontend avec le support Naomi/
# Atomiswave complet et le netplay, pas juste le cœur Dreamcast.
ARG FLYCAST_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url flyinghead/flycast "${FLYCAST_TAG}" 'x86_64-[0-9.]+\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage flycast "Flycast" "${URL}"

# Cemu (20/09, ré-ajouté) — seul émulateur Wii U du conteneur, retiré à tort
# le 18/09 en même temps qu'Azahar/GZDoom (nettoyage qui n'aurait pas dû
# l'inclure).
ARG CEMU_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url cemu-project/Cemu "${CEMU_TAG}" 'x86_64\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage cemu "Cemu" "${URL}"

# Vita3K (20/09) — seul émulateur PS Vita disponible sur Linux. Release
# "continuous" (builds CI en continu) : c'est déjà ce que "latest" résout
# côté API GitHub pour ce dépôt. Nom complet Vita3K-x86_64.AppImage (le
# dépôt publie aussi une variante aarch64). Lanceur enrichi (20/09, "vita3k
# est bien présent mais il ne se lance pas") : son AppRun.wrapped (généré
# par linuxdeploy-plugin-qt) ne lance le vrai binaire QUE si APPIMAGE est
# non vide — sinon il sort silencieusement, confirmé en direct. APPIMAGE/
# APPDIR n'existent normalement que sous le vrai runtime squashfs, jamais
# pour un AppDir extrait. QT_QPA_PLATFORM=xcb en plus (confirmé en direct) :
# seul le plugin Qt xcb est embarqué dans cet AppImage.
ARG VITA3K_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url Vita3K/Vita3K "${VITA3K_TAG}" 'Vita3K-x86_64\.AppImage$') && \
    WRAPPER_ENV='export APPDIR=/opt/vita3k APPIMAGE=/opt/vita3k/AppRun QT_QPA_PLATFORM=xcb' /usr/local/lib/steambox-build/install-appimage vita3k "Vita3K" "${URL}"

# TeknoParrotUI (18/09) — build .NET 8 natif Linux (teknogods/TeknoParrotUI,
# release "TeknoParrotUI-net8"), PAS la release GitHub "latest" de ce dépôt :
# confirmé en direct que /releases/latest renvoie encore l'ancienne release
# 2019 Windows-only (TeknoParrotUi.zip) — le mainteneur n'a jamais remarqué
# la release net8 comme "latest" côté GitHub. Tag figé en dur plutôt que
# de suivre "latest" pour cette raison précise.
# ~60 jeux de la collection wsquashfs (namcoes3, rawthrills, konamipc,
# arcadepc, segaalls/er/nu/re/rw, adrenaline, unis, nesicax2) utilisent déjà
# TeknoParrotUi.exe comme CMD dans leur autorun.cmd, lancé sous Wine jusqu'ici.
# Ce build natif remplace uniquement la coquille TeknoParrotUi.exe/launcher —
# OpenParrot (la bibliothèque de hooks par jeu : anti-dongle JVS, entrées
# clavier) n'a pas été mise à jour depuis 2019 et reste Windows-only
# (confirmé sur teknogods/OpenParrot, aucune release Linux) : le jeu lui-même
# tourne donc probablement toujours sous Wine derrière ce launcher natif,
# pipehelper.exe (présent dans le zip) restant un binaire Windows pour le
# pont IPC avec le process du jeu. Pas encore basculé les autorun.cmd des
# 60 jeux dessus (à valider un par un, cf. audit KOF XIV Arcade/NESiCA_Unlocker
# — ces procédures de lancement sont fragiles et spécifiques par jeu) :
# seul l'outil est installé ici, l'intégration par jeu est un chantier séparé.
# Règle udev "uaccess" fournie dans le zip (setup/) volontairement PAS
# installée : mécanisme systemd-logind absent de ce conteneur, sans effet
# ici — l'accès /dev/input passe déjà par le groupe "input" (arcade y est
# déjà, voir plus bas useradd) et le bind mount complet /dev/input du
# docker-compose, mécanisme différent mais qui couvre déjà ce besoin.
# chmod -R a+rwX (18/09, confirmé en direct) : TeknoParrotUi écrit sa
# config (ParrotData.xml, joystick) directement dans son propre dossier
# dinstallation plutôt que dans un dossier XDG — hérité de son
# fonctionnement portable sous Windows (à côté de lexe). Sans ça,
# UnauthorizedAccessException au démarrage (root:root par défaut après
# unzip). Le symlink TeknoParrotUi -> /usr/local/bin/teknoparrot lui-même
# est sans risque contrairement à PPSSPP/Flycast plus haut : binaire .NET
# natif, résout son propre dossier via AppContext.BaseDirectory (API
# système), pas un script shell lisant $0 à la main.
ARG TEKNOPARROT_TAG="TeknoParrotUI-net8"
RUN --mount=type=secret,id=github_token \
    TEKNOPARROT_URL=$(/usr/local/lib/steambox-build/gh-asset-url teknogods/TeknoParrotUI "${TEKNOPARROT_TAG}" 'linux-x64\.zip$') && \
    curl -fSL --retry 3 -o /tmp/teknoparrot.zip "${TEKNOPARROT_URL}" && \
    mkdir -p /opt/teknoparrot && \
    unzip -q /tmp/teknoparrot.zip -d /opt/teknoparrot && \
    chmod +x /opt/teknoparrot/TeknoParrotUi /opt/teknoparrot/ParrotPatcher && \
    chmod -R a+rwX /opt/teknoparrot && \
    ln -sf /opt/teknoparrot/TeknoParrotUi /usr/local/bin/teknoparrot && \
    printf '[Desktop Entry]\nType=Application\nName=TeknoParrotUI\nExec=/usr/local/bin/teknoparrot\nIcon=/opt/teknoparrot/Icons/TeknoVegas.png\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/teknoparrot.desktop && \
    rm -f /tmp/teknoparrot.zip

ARG XENIA_TAG=""
RUN --mount=type=secret,id=github_token \
    URL=$(/usr/local/lib/steambox-build/gh-asset-url has207/xenia-edge "${XENIA_TAG}" 'linux\.AppImage$') && \
    /usr/local/lib/steambox-build/install-appimage xenia "Xenia (Xbox 360)" "${URL}"

# melonDS (Nintendo DS) — zip, pas d'AppImage.
ARG MELONDS_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    MELONDS_VERSION=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/melonDS-emu/melonDS/releases/${MELONDS_TAG:+tags/}${MELONDS_TAG:-latest}" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${MELONDS_VERSION}" ] || { echo "FATAL: MELONDS_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/melon.zip \
      "https://github.com/melonDS-emu/melonDS/releases/download/${MELONDS_VERSION}/melonDS-${MELONDS_VERSION}-ubuntu-x86_64.zip" && \
    mkdir -p /opt/melonds && unzip -q /tmp/melon.zip -d /opt/melonds && \
    ln -sf /opt/melonds/melonDS /usr/local/bin/melonDS && \
    curl -fSL --retry 3 -o /opt/melonds/melon.png \
      "https://raw.githubusercontent.com/melonDS-emu/melonDS/master/res/melon512.png" && \
    printf '[Desktop Entry]\nType=Application\nName=melonDS\nExec=/usr/local/bin/melonDS\nIcon=/opt/melonds/melon.png\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/melonds.desktop && \
    rm -f /tmp/melon.zip

# DOSBox Staging — tarball officiel, pas d'AppImage.
ARG DSTAGING_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    DSTAGING_VERSION=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/dosbox-staging/dosbox-staging/releases/${DSTAGING_TAG:+tags/}${DSTAGING_TAG:-latest}" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${DSTAGING_VERSION}" ] || { echo "FATAL: DSTAGING_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/dosbox.tar.xz \
      "https://github.com/dosbox-staging/dosbox-staging/releases/download/${DSTAGING_VERSION}/dosbox-staging-linux-x86_64-${DSTAGING_VERSION}.tar.xz" && \
    mkdir -p /opt/dosbox && tar -xf /tmp/dosbox.tar.xz -C /opt/dosbox --strip-components=1 && \
    ln -sf /opt/dosbox/dosbox /usr/local/bin/dosbox && \
    printf '[Desktop Entry]\nType=Application\nName=DOSBox Staging\nExec=/usr/local/bin/dosbox\nIcon=/opt/dosbox/icons/hicolor/256x256/apps/org.dosbox-staging.dosbox-staging.png\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/dosbox.desktop && \
    rm -f /tmp/dosbox.tar.xz

# ShadPS4 (PS4, expérimental) — zip officiel (AppImage empaqueté dedans).
# Liste /releases complète (pas /releases/latest) pour capter les
# prereleases — d'où l'appel direct à l'API plutôt que gh-asset-url.
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    SHADPS4_URL=$(curl -fsSL --retry 3 ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases" \
      | grep -oE '"browser_download_url": *"[^"]*linux-qt[^"]*\.zip"' | head -1 | cut -d'"' -f4) && \
    [ -n "${SHADPS4_URL}" ] || { echo "FATAL: SHADPS4_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/shadps4.zip "${SHADPS4_URL}" && \
    mkdir -p /tmp/shadps4 && unzip -q /tmp/shadps4.zip -d /tmp/shadps4 && \
    APPIMAGE=$(find /tmp/shadps4 -name "*.AppImage" | head -1) && \
    [ -n "${APPIMAGE}" ] || { echo "FATAL: aucune AppImage dans le zip ShadPS4"; exit 1; } && \
    /usr/local/lib/steambox-build/install-appimage shadps4 "ShadPS4" "${APPIMAGE}" && \
    rm -rf /tmp/shadps4.zip /tmp/shadps4

# Eden (Nintendo Switch) — remplacé par le paquet AUR eden-nightly-bin
# (voir plus haut, section AUR avec libva-nvidia-driver-git/ludusavi-bin) :
# gardait ici un doublon de build "stable" téléchargé à la main depuis
# stable.eden-emu.dev (audit 29/08) — deux entrées "Eden" dans le menu, deux
# binaires potentiellement différents. Nightly seule conservée, plus simple
# à tenir à jour (juste rebuild l'image) qu'un script curl+extraction ad hoc.

# Flips — patcher de ROMs IPS/BPS, petit utilitaire ligne de commande + GUI.
ARG FLIPS_TAG=""
RUN --mount=type=secret,id=github_token \
    FLIPS_URL=$(/usr/local/lib/steambox-build/gh-asset-url Alcaro/Flips "${FLIPS_TAG}" 'linux\.zip$') && \
    curl -fSL --retry 3 -o /tmp/flips.zip "${FLIPS_URL}" && \
    mkdir -p /tmp/flips && cd /tmp/flips && unzip -q /tmp/flips.zip && \
    install -Dm755 flips /usr/local/bin/flips && \
    rm -rf /tmp/flips.zip /tmp/flips

# ── 1b. evdev-bridge — injection input Wayland pour Sunshine (voir point 6
# de l'historique en tête de fichier). Lit les périphériques uinput virtuels
# de Sunshine (souris/clavier) en direct, indépendant d'udev, et les rejoue
# via zwlr_virtual_pointer_manager_v1/zwp_virtual_keyboard_manager_v1 — QUE
# labwc (wlroots) implémente, pas KWin, plus gamescope depuis sa bascule
# vers libei. Source vendored dans ce dépôt (ex-projet Desarso/evdev-bridge,
# pas de licence explicite — usage privé uniquement, jamais republié), déjà
# utilisée telle quelle sur l'ancien Dockerfile webstation/labwc. Cible
# maintenant le labwc HEADLESS dédié au streaming (voir svc-labwc-headless
# et point 7 ci-dessus), pas le bureau XFCE visible.
#
# Piste gamescope-racine + libei explorée puis abandonnée le 30/08 (voir
# point 7) : input fonctionnel, mais capture Sunshine impossible contre
# gamescope quel que soit le mode (portail D-Bus absent, XDG_OUTPUT
# manquant, EGL_BAD_ACCESS) — confirmé aussi par le projet Wolf (games-on-
# whales), qui a abandonné gamescope pour la même raison. Bridge libei
# retiré : code mort sans cible fonctionnelle.
COPY evdev-bridge /tmp/evdev-bridge
RUN make -C /tmp/evdev-bridge evdev-bridge-native && \
    install -Dm755 /tmp/evdev-bridge/evdev-bridge-native /usr/local/bin/evdev-bridge-native && \
    rm -rf /tmp/evdev-bridge

# ── 1c. noVNC — fichiers statiques (pas de paquet Arch/CachyOS, AUR-only) ────
# wayvnc sert le RFB brut (5900, interne, voir svc-wayvnc) ; websockify (pip,
# absent des dépôts Arch/CachyOS) fait le pont websocket->RFB pour un accès
# navigateur direct sans client VNC, ET sert les fichiers statiques noVNC sur
# le même port via --web (voir svc-websockify) — même montage que l'ancien
# Dockerfile webstation/labwc, où wayvnc fonctionnait déjà (KWin n'était pas
# encore dans l'équation à l'époque).
RUN pip install --break-system-packages --no-cache-dir websockify

ARG NOVNC_TAG=""
# Contrôles ajoutés (22/09) : une URL vide (rate-limit API) ou un tarball
# tronqué laissaient passer le build avec un noVNC vide ou partiel — le
# bureau navigateur (seul accès d'administration) cassé sans aucun signal
# avant le premier déploiement.
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    NOVNC_URL=$(curl -fsSL --retry 3 ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} "https://api.github.com/repos/novnc/noVNC/releases/${NOVNC_TAG:+tags/}${NOVNC_TAG:-latest}" \
      | grep -oE '"tarball_url": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${NOVNC_URL}" ] || { echo "FATAL: NOVNC_URL vide"; exit 1; } && \
    mkdir -p /usr/share/webapps/novnc && \
    curl -fSL --retry 3 -o /tmp/novnc.tar.gz "${NOVNC_URL}" && \
    tar -xzf /tmp/novnc.tar.gz -C /usr/share/webapps/novnc --strip-components=1 && \
    [ -f /usr/share/webapps/novnc/vnc.html ] || { echo "FATAL: vnc.html absent après extraction noVNC"; exit 1; } && \
    rm -f /tmp/novnc.tar.gz

# La racine ("/") du serveur noVNC affiche par défaut une liste de fichiers
# (aucun index.html fourni), et vnc.html seul n'a ni host ni port pré-remplis
# — redirection en JS avec l'hôte déduit dynamiquement (window.location.hostname)
# et le port websockify (même port que la page grâce à --web).
RUN printf '<script>location.replace("vnc.html?host=" + location.hostname + "&port=" + location.port + "&autoconnect=true&resize=scale&reconnect=true");</script>\n' \
      > /usr/share/webapps/novnc/index.html

# ── 2. Driver NVIDIA userspace — matché à la version du host au démarrage ────
# Le paquet Arch nvidia-utils suit la dernière release, pas forcément celle du
# host. On réutilise l'approche .run (agnostique à la distro, déjà éprouvée
# sur l'image webstation) : installée au runtime par un script d'init, pas ici
# au build (le driver du host n'est pas connu à ce stade).
COPY root-cachyos/usr/local/bin/install-nvidia-userspace.sh /usr/local/bin/install-nvidia-userspace.sh
RUN chmod +x /usr/local/bin/install-nvidia-userspace.sh

# ── 2b. s6-overlay — vrai supervisor de conteneur (comme l'ancienne image
# webstation, basée sur linuxserver/baseimage-selkies qui l'embarque déjà).
# Remplace les boucles bash artisanales de l'ancien entrypoint.sh : chaque
# service (Hyprland, Sunshine, wayvnc, websockify...) est redémarré
# automatiquement par s6 s'il crashe, avec ses propres logs, sans dépendre
# d'un `while kill -0 $PID; do ...; done` maison — fragile, comme confirmé en
# direct sur ce projet (un `pkill` a un jour tué le superviseur de wayvnc en
# plus du service, sans que rien ne le relance). Version épinglée (pas
# "latest") : composant d'infrastructure, la reproductibilité prime ici sur
# la fraîcheur.
ARG S6_OVERLAY_VERSION=3.2.3.2
RUN curl -fsSL -o /tmp/s6-overlay-noarch.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && \
    curl -fSL -o /tmp/s6-overlay-x86_64.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && \
    rm -f /tmp/s6-overlay-*.tar.xz

# ── 3. Règles udev manettes (Xbox/PlayStation/Switch — mappings non standard) ─
RUN git clone --depth 1 https://codeberg.org/fabiscafe/game-devices-udev.git /tmp/gdu && \
    cp /tmp/gdu/src/*.rules /etc/udev/rules.d/ && \
    rm -rf /tmp/gdu

# ── 3b. Règle udev anti-double-saisie clavier/souris (30/08) — sans elle,
# libinput (labwc) lit les périphériques uinput virtuels de Sunshine EN
# PARALLÈLE d'evdev-bridge via son propre hotplug udev temps réel (qui
# fonctionne, contrairement à l'énumération initiale basée sur la base
# persistée cassée — voir point 6 de l'historique) : chaque touche/clic
# était traité deux fois, confirmé en direct. NOTE (audit B2, 31/08) :
# depuis le 30/08 evdev-bridge fait AUSSI un EVIOCGRAB exclusif de son côté
# (bridge.c, non fiable à 100% seul car le tag udev ne survit pas à un
# redémarrage de labwc) — les deux protections coexistent volontairement,
# ceinture et bretelles : cette règle couvre le cas où le grab échoue, le
# grab couvre le cas où labwc redémarre et ré-énumère sans repasser par
# le hotplug.
RUN printf 'ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="*passthrough*", ENV{LIBINPUT_IGNORE_DEVICE}="1"\n' \
      > /etc/udev/rules.d/99-sunshine-passthrough-no-libinput.rules

# ── 4. Utilisateur non-root pour la session bureau ────────────────────────────
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g "${PGID}" arcade 2>/dev/null || true && \
    useradd -l -m -u "${PUID}" -g "${PGID}" \
      -G wheel,video,input,render,audio -s /bin/bash arcade && \
    echo "arcade ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    mkdir -p /home/arcade/.config/sunshine && \
    chown -R arcade:arcade /home/arcade

# cap_sys_admin ajouté (29/08, pivot Wayland) : Sunshine tourne en arcade
# (non-root) — avoir CAP_SYS_ADMIN dans le conteneur (docker-compose.cachyos.yml
# cap_add) ne suffit pas, un process non-root ne l'a dans son set effectif
# que si le binaire la porte en capacité fichier. Sans ça, confirmé en
# direct : Sunshine échoue son accès KMS ("Failed to gain CAP_SYS_ADMIN"),
# retombe sur le portail XDG/PipeWire, qui reste bloqué indéfiniment en
# attente d'un consentement qu'il n'y a personne pour valider en headless —
# le serveur web/streaming de Sunshine ne démarre jamais (aucun port
# 47984-47990 en écoute), symptôme : "impossible de se connecter à Sunshine".
#
# +ep, pas +p seul (audit M8, 05/09) : une capacité de fichier "permitted"
# (+p) seule n'est PAS automatiquement utilisable — un programme doit la
# hisser lui-même du set permitted vers le set effectif (prctl/cap_set_proc)
# avant de pouvoir réellement s'en servir. Sunshine le fait pour
# CAP_SYS_ADMIN (l'accès KMS ci-dessus fonctionne bien), mais PAS pour
# CAP_SYS_NICE — confirmé en direct (build prerelease 2026.902.143621,
# 04/09) : "setpriority failed for nice -15/-10: Permission denied" à
# répétition alors que le binaire portait déjà cap_sys_nice+p. +ep la rend
# effective dès l'exec, sans que Sunshine ait quoi que ce soit à faire —
# threads d'encodage/audio correctement priorisés sous charge CPU.
#
# CORRECTION (audit 22/09, vérifié en direct sur la prod) : +ep ne suffit
# PAS pour CAP_SYS_NICE côté Sunshine. Le binaire porte bien
# cap_sys_admin,cap_sys_nice=ep, mais Sunshine vide lui-même son set
# effectif après son initialisation (CapEff=0 sur le process en cours) : ses
# 18 threads tournaient tous en nice 0, et "setpriority failed for nice
# -15/-10" apparaissait toujours dans sunshine.log. Le vrai correctif est
# côté conteneur : --ulimit nice=40 (docker-compose.cachyos.yml ulimits,
# template Unraid — voir docs/deploiement-unraid.md), qui autorise un
# process NON privilégié à descendre jusqu'à nice -20, sans capacité.
# La capacité de fichier reste posée ici pour CAP_SYS_ADMIN (voir plus haut).
#
# Échec franc (22/09) au lieu d'un simple WARN : sans cette capacité,
# Sunshine ne démarre jamais son serveur (voir plus haut) — une image
# construite sans elle est inutilisable, autant le savoir au build.
RUN setcap 'cap_sys_nice,cap_sys_admin+ep' "$(readlink -f /usr/bin/sunshine)" && \
    getcap "$(readlink -f /usr/bin/sunshine)" | grep -q cap_sys_admin

# PipeWire — même classe de correctif (audit M8, 05/09) : sans CAP_SYS_NICE
# effective, PipeWire ne peut obtenir de priorité temps réel (SCHED_FIFO)
# pour ses threads audio qu'en passant par rtkit (D-Bus), absent de ce
# conteneur (pas de polkit/rtkit-daemon supervisé) — il tourne alors en
# ordonnancement normal, exposé aux craquements audio sous charge (jeu
# gourmand, compilation de shaders). cap_add: SYS_NICE existe déjà côté
# docker-compose ; il ne manquait que la capacité de fichier sur le binaire
# réellement exécuté, comme pour Sunshine ci-dessus.
# Contrairement à Sunshine, PipeWire garde bien cette capacité effective
# (CapEff contient CAP_SYS_NICE, vérifié en direct le 22/09). Échec franc
# (22/09) pour la même raison que Sunshine : un WARN noyé dans un log de
# build de 12 Go n'est jamais lu.
RUN setcap 'cap_sys_nice+ep' "$(readlink -f /usr/bin/pipewire)"

# Catégorie "Emulator" (audit menu XFCE, 07/09) : xfce-applications.menu
# définit le menu "Système" comme <Or><Category>Emulator</Category>
# <Category>System</Category></Or> — tout .desktop taggé Game;Emulator;
# apparaît donc EN PLUS dans "Système", à côté de Thunar/xfce4-terminal,
# alors qu'il est déjà dans "Jeux" via Game seul (confirmé en direct,
# capture d'écran utilisateur). Nos .desktop générés par ce Dockerfile ont
# déjà été corrigés (Categories=Game; seul, voir plus haut) — ceux-ci
# viennent de paquets pacman/AUR upstream (dolphin-emu, retroarch,
# eden-nightly-bin) et gardent leur catégorie d'origine tant qu'on ne la
# patch pas ici (fichier upstream gardé intact à part ce qu'on doit
# changer) — même logique que pour DISPLAY sur dolphin-emu.desktop plus
# haut, même si ce dernier ne nécessite plus aucun sed depuis que DISPLAY
# est ambiant via wayland-session.sh.
RUN for f in /usr/share/applications/dolphin-emu.desktop \
             /usr/share/applications/com.libretro.RetroArch.desktop \
             /usr/share/applications/eden-nightly.desktop; do \
        [ -f "$f" ] && sed -i 's/^Categories=Game;Emulator;/Categories=Game;/' "$f" || true; \
    done

# Rafraîchit la base des .desktop (/usr/share/applications) — au cas où le
# menu XFCE (garcon) ne les reprendrait pas correctement sans ça, non
# confirmé en direct mais coût nul.
RUN update-desktop-database /usr/share/applications 2>/dev/null || true

# Papirus/Papirus-Dark livrés sans icon-theme.cache (30/08, warning constaté
# en direct) — contrairement à hicolor/Adwaita qui l'ont déjà. Sans ce
# fichier, GTK doit re-scanner le thème à chaque lookup d'icône au lieu de
# lire l'index précompilé — coût de performance, pas de cassure fonctionnelle,
# mais gtk-update-icon-cache est quasi gratuit au build.
RUN gtk-update-icon-cache -f /usr/share/icons/Papirus 2>/dev/null || true && \
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true

# ── 5. Scripts de démarrage ────────────────────────────────────────────────────
# root-cachyos/etc/ apporte l'arborescence s6-rc.d (services) par-dessus les
# fichiers déjà installés par s6-overlay lui-même (section 2b) — remplace
# l'ancien entrypoint.sh (boucle bash artisanale) entièrement.
COPY root-cachyos/etc/ /etc/
COPY root-cachyos/scripts/ /usr/local/bin/scripts/
RUN chmod +x /usr/local/bin/scripts/*.sh && \
    find /etc/s6-overlay/s6-rc.d -name run -exec chmod +x {} \; && \
    ln -sf /usr/local/bin/scripts/steamos-session-select.sh /usr/bin/steamos-session-select && \
    ln -sf /usr/local/bin/scripts/os-session-select.sh /usr/lib/os-session-select

# Caches de shaders (DXVK/NVIDIA) HORS de /config (audit 2026-08-26) :
# /config est sur un partage Unraid FUSE/shfs, lent en accès aléatoire,
# alors que le stockage écrivable du conteneur est sur le pool Docker
# direct (typiquement le pool cache Unraid). Cache non persistant entre
# recréations du conteneur, contre un accès disque nettement plus rapide.
RUN mkdir -p /var/cache/steambox/dxvk /var/cache/steambox/nv-shader && \
    chmod -R 1777 /var/cache/steambox

# Inventaire de paquets (audit H2, 05/09) : rien n'étant épinglé dans ce
# Dockerfile hormis s6-overlay et désormais la base (voir FROM plus haut),
# c'est le seul moyen fiable de savoir ce qu'une image donnée contient
# réellement une fois construite. `diff` entre deux `docker run --rm <tag>
# cat /etc/steambox-packages.txt` rend visible tout ce qui a changé entre
# deux builds — Mesa, wlroots, Sunshine, émulateurs AUR/pacman compris.
RUN pacman -Q > /etc/steambox-packages.txt

# GSK_RENDERER=cairo (fix GTK4 de l'ère X11) retiré : la cause identifiée
# était le SHM X11 refusé par un client non-root (arcade) face à un Xorg
# root — plus de root/Xorg du tout dans cette session Wayland (labwc tourne
# entièrement en arcade via seatd, voir wayland-session.sh). À remettre si
# un bug de rendu GTK4 identique resurgit ici, non revérifié en direct sous
# Wayland.
#
# XDG_RUNTIME_DIR retirée d'ici (audit F2, 05/09) : cette ENV globale valait
# "/run/user/1000", qui ne correspond JAMAIS à l'UID réel d'arcade en
# production (99 côté Unraid/PUID, voir docker-compose.cachyos.yml) —
# fausse pour tout ce qui l'hériterait sans la recalculer. Au moins trois
# services de ce dépôt (svc-wayvnc, svc-evdev-bridge, svc-sunshine)
# documentent déjà le bug exact que cette valeur causait et la
# recalculent eux-mêmes via $(id -u arcade). init-system/run exporte
# désormais la VRAIE valeur dans /run/s6/container_environment/ (lu par
# with-contenv, l'en-tête de tous les scripts s6-rc.d de ce projet), avec
# le bon PUID dès le premier service qui en a besoin.
# LC_ALL absent volontairement (audit F5, 05/09) : primait auparavant sur
# TOUTE variable LC_*, empêchant de passer un jeu/outil précis en anglais
# sans le retirer globalement — LANG+LANGUAGE ci-dessous suffisent pour
# une interface FR par défaut, sans ce verrou.
ENV WAYLAND_DISPLAY=wayland-0 \
    SEATD_VTBOUND=0 \
    LIBSEAT_BACKEND=seatd \
    QT_QPA_PLATFORM=wayland \
    SDL_VIDEODRIVER=wayland,x11 \
    SDL_JOYSTICK_DISABLE_UDEV=1 \
    XDG_CURRENT_DESKTOP=XFCE \
    XDG_SESSION_TYPE=wayland \
    LIBVA_DRIVER_NAME=nvidia \
    NVD_BACKEND=direct \
    LANG=fr_FR.UTF-8 \
    LANGUAGE=fr_FR:fr \
    DXVK_STATE_CACHE_PATH=/var/cache/steambox/dxvk \
    __GL_SHADER_DISK_CACHE_PATH=/var/cache/steambox/nv-shader \
    __GL_SHADER_DISK_CACHE_SIZE=1073741824 \
    S6_KEEP_ENV=1 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=2

VOLUME /config
# EXPOSE purement documentaire (audit B4, 31/08) : le conteneur tourne en
# network_mode: host, cette directive n'a donc aucun effet — gardée comme
# inventaire des ports réellement utilisés : 6080 noVNC, 47984/47989/47990
# Sunshine (HTTPS/HTTP/Web UI), 47998-48000/udp flux vidéo/audio/contrôle,
# 48010 RTSP. 1337 (decky-loader) retiré de la liste (22/09) : decky
# n'écoute que sur 127.0.0.1 (vérifié en direct, ss -ltnp), il n'est
# joignable que par Steam dans le conteneur, jamais depuis le LAN.
EXPOSE 6080 47990 47984 47989 47998-48000/udp 48010

ENTRYPOINT ["/init"]
