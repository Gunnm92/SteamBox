# melonDS (Nintendo DS) — zip, pas d'AppImage.
ARG MELONDS_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    MELONDS_VERSION=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/melonDS-emu/melonDS/releases/${MELONDS_TAG:+tags/}${MELONDS_TAG:-latest}" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${MELONDS_VERSION}" ] || { echo "FATAL: MELONDS_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/melon.zip \
      "https://github.com/melonDS-emu/melonDS/releases/download/${MELONDS_VERSION}/melonDS-${MELONDS_VERSION}-ubuntu-x86_64.zip" && \
    mkdir -p /opt/melonds && unzip -q /tmp/melon.zip -d /opt/melonds && \
    ln -sf /opt/melonds/melonDS /usr/local/bin/melonDS && \
    curl -fSL --retry 3 -o /opt/melonds/melon.png \
      "https://raw.githubusercontent.com/melonDS-emu/melonDS/master/res/melon512.png" && \
    printf '[Desktop Entry]\nType=Application\nName=melonDS\nExec=/usr/local/bin/melonDS\nIcon=/opt/melonds/melon.png\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/melonds.desktop && \
    rm -f /tmp/melon.zip

# DOSBox Staging — tarball officiel, pas d'AppImage.
ARG DSTAGING_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    DSTAGING_VERSION=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/dosbox-staging/dosbox-staging/releases/${DSTAGING_TAG:+tags/}${DSTAGING_TAG:-latest}" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${DSTAGING_VERSION}" ] || { echo "FATAL: DSTAGING_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/dosbox.tar.xz \
      "https://github.com/dosbox-staging/dosbox-staging/releases/download/${DSTAGING_VERSION}/dosbox-staging-linux-x86_64-${DSTAGING_VERSION}.tar.xz" && \
    mkdir -p /opt/dosbox && tar -xf /tmp/dosbox.tar.xz -C /opt/dosbox --strip-components=1 && \
    ln -sf /opt/dosbox/dosbox /usr/local/bin/dosbox && \
    printf '[Desktop Entry]\nType=Application\nName=DOSBox Staging\nExec=/usr/local/bin/dosbox\nIcon=/opt/dosbox/icons/hicolor/256x256/apps/org.dosbox-staging.dosbox-staging.png\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/dosbox.desktop && \
    rm -f /tmp/dosbox.tar.xz

# GZDoom + Freedoom (WAD libre, pas besoin du WAD original Doom) — .deb officiel,
# même technique d'extraction manuelle que Chrome ci-dessus.
ARG GZDOOM_TAG=""
ARG FREEDOOM_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    GZDOOM_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/ZDoom/gzdoom/releases/${GZDOOM_TAG:+tags/}${GZDOOM_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*_amd64\.deb"' | cut -d'"' -f4) && \
    [ -n "${GZDOOM_URL}" ] || { echo "FATAL: GZDOOM_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/gzdoom.deb "${GZDOOM_URL}" && \
    cd /tmp && ar x gzdoom.deb && mkdir -p /tmp/gzdoom-extract && \
    tar -xf data.tar.* -C /tmp/gzdoom-extract && \
    cp -a /tmp/gzdoom-extract/opt/. /opt/ && \
    cp -a /tmp/gzdoom-extract/usr/. /usr/ && \
    chmod +x /usr/games/gzdoom /opt/gzdoom/gzdoom && \
    ln -sf /usr/games/gzdoom /usr/local/bin/gzdoom && \
    FREEDOOM_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/freedoom/freedoom/releases/${FREEDOOM_TAG:+tags/}${FREEDOOM_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*freedoom-[^"]*\.zip"' | cut -d'"' -f4) && \
    curl -fSL --retry 3 -o /tmp/freedoom.zip "${FREEDOOM_URL}" && \
    mkdir -p /usr/local/share/doom && \
    unzip -qj /tmp/freedoom.zip '*/freedoom1.wad' -d /usr/local/share/doom && \
    rm -rf /tmp/gzdoom.deb /tmp/control.tar.* /tmp/data.tar.* /tmp/debian-binary /tmp/gzdoom-extract /tmp/freedoom.zip

# ShadPS4 (PS4, expérimental) — zip officiel (AppImage empaqueté dedans).
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    SHADPS4_TAG=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases" \
      | grep -oE '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4) && \
    SHADPS4_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases" \
      | grep -oE '"browser_download_url": *"[^"]*linux-qt[^"]*\.zip"' | head -1 | cut -d'"' -f4) && \
    [ -n "${SHADPS4_URL}" ] || { echo "FATAL: SHADPS4_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/shadps4.zip "${SHADPS4_URL}" && \
    mkdir -p /tmp/shadps4 && cd /tmp/shadps4 && unzip -q /tmp/shadps4.zip && \
    APPIMAGE=$(find . -name "*.AppImage" | head -1) && \
    chmod +x "${APPIMAGE}" && \
    for i in 1 2 3; do rm -rf squashfs-root; "./${APPIMAGE##./}" --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction shadps4 échouée"; exit 1; } && \
    mv squashfs-root /opt/shadps4 && \
    printf '#!/bin/sh\nexec /opt/shadps4/AppRun "$@"\n' > /usr/local/bin/shadps4 && \
    chmod +x /usr/local/bin/shadps4 && \
    printf '[Desktop Entry]\nType=Application\nName=ShadPS4\nExec=/usr/local/bin/shadps4\nIcon=/opt/shadps4/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/shadps4.desktop && \
    rm -rf /tmp/shadps4.zip /tmp/shadps4

# Eden (Nintendo Switch) — remplacé par le paquet AUR eden-nightly-bin
# (voir plus haut, section AUR avec libva-nvidia-driver-git/ludusavi-bin) :
# gardait ici un doublon de build "stable" téléchargé à la main depuis
# stable.eden-emu.dev (audit 29/08) — deux entrées "Eden" dans le menu, deux
# binaires potentiellement différents. Nightly seule conservée, plus simple
# à tenir à jour (juste rebuild l'image) qu'un script curl+extraction ad hoc.

# Flips — patcher de ROMs IPS/BPS, petit utilitaire ligne de commande + GUI.
ARG FLIPS_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    FLIPS_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/Alcaro/Flips/releases/${FLIPS_TAG:+tags/}${FLIPS_TAG:-latest}" \
      | grep -oE '"browser_download_url": *"[^"]*linux\.zip"' | cut -d'"' -f4) && \
    [ -n "${FLIPS_URL}" ] || { echo "FATAL: FLIPS_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/flips.zip "${FLIPS_URL}" && \
    mkdir -p /tmp/flips && cd /tmp/flips && unzip -q /tmp/flips.zip && \
    install -Dm755 flips /usr/local/bin/flips && \
    rm -rf /tmp/flips.zip /tmp/flips

# ── 1b. evdev-bridge — injection input Wayland pour Sunshine (voir point 6
# de l'historique en tête de fichier). Lit les périphériques uinput virtuels
# de Sunshine (souris/clavier) en direct, indépendant d'udev, et les rejoue
# via zwlr_virtual_pointer_manager_v1/zwp_virtual_keyboard_manager_v1 — QUE
# labwc (wlroots) implémente, pas KWin, plus gamescope depuis sa bascule
# vers libei. Source vendored dans ce dépôt (ex-projet Desarso/evdev-bridge,
# pas de licence explicite — usage privé uniquement, jamais republié), déjà
# utilisée telle quelle sur l'ancien Dockerfile webstation/labwc. Cible
# maintenant le labwc HEADLESS dédié au streaming (voir svc-labwc-headless
# et point 7 ci-dessus), pas le bureau XFCE visible.
#
# Piste gamescope-racine + libei explorée puis abandonnée le 30/08 (voir
# point 7) : input fonctionnel, mais capture Sunshine impossible contre
# gamescope quel que soit le mode (portail D-Bus absent, XDG_OUTPUT
# manquant, EGL_BAD_ACCESS) — confirmé aussi par le projet Wolf (games-on-
# whales), qui a abandonné gamescope pour la même raison. Bridge libei
# retiré : code mort sans cible fonctionnelle.
COPY evdev-bridge /tmp/evdev-bridge
RUN make -C /tmp/evdev-bridge evdev-bridge-native && \
    install -Dm755 /tmp/evdev-bridge/evdev-bridge-native /usr/local/bin/evdev-bridge-native && \
    rm -rf /tmp/evdev-bridge

# ── 1c. noVNC — fichiers statiques (pas de paquet Arch/CachyOS, AUR-only) ────
# wayvnc sert le RFB brut (5900, interne, voir svc-wayvnc) ; websockify (pip,
# absent des dépôts Arch/CachyOS) fait le pont websocket->RFB pour un accès
# navigateur direct sans client VNC, ET sert les fichiers statiques noVNC sur
# le même port via --web (voir svc-websockify) — même montage que l'ancien
# Dockerfile webstation/labwc, où wayvnc fonctionnait déjà (KWin n'était pas
# encore dans l'équation à l'époque).
RUN pip install --break-system-packages --no-cache-dir websockify

ARG NOVNC_TAG=""
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN=$(cat /run/secrets/github_token 2>/dev/null || true) && \
    NOVNC_URL=$(curl -sL ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} -X GET "https://api.github.com/repos/novnc/noVNC/releases/${NOVNC_TAG:+tags/}${NOVNC_TAG:-latest}" \
      | grep -oE '"tarball_url": *"[^"]*"' | cut -d'"' -f4) && \
    mkdir -p /usr/share/webapps/novnc && \
    curl -fSL "${NOVNC_URL}" | tar -xz -C /usr/share/webapps/novnc --strip-components=1

# La racine ("/") du serveur noVNC affiche par défaut une liste de fichiers
# (aucun index.html fourni), et vnc.html seul n'a ni host ni port pré-remplis
# — redirection en JS avec l'hôte déduit dynamiquement (window.location.hostname)
# et le port websockify (même port que la page grâce à --web).
RUN printf '<script>location.replace("vnc.html?host=" + location.hostname + "&port=" + location.port + "&autoconnect=true&resize=scale&reconnect=true");</script>\n' \
      > /usr/share/webapps/novnc/index.html

# ── 2. Driver NVIDIA userspace — matché à la version du host au démarrage ────
# Le paquet Arch nvidia-utils suit la dernière release, pas forcément celle du
# host. On réutilise l'approche .run (agnostique à la distro, déjà éprouvée
# sur l'image webstation) : installée au runtime par un script d'init, pas ici
# au build (le driver du host n'est pas connu à ce stade).
COPY root-cachyos/usr/local/bin/install-nvidia-userspace.sh /usr/local/bin/install-nvidia-userspace.sh
RUN chmod +x /usr/local/bin/install-nvidia-userspace.sh

# ── 2b. s6-overlay — vrai supervisor de conteneur (comme l'ancienne image
# webstation, basée sur linuxserver/baseimage-selkies qui l'embarque déjà).
# Remplace les boucles bash artisanales de l'ancien entrypoint.sh : chaque
# service (Hyprland, Sunshine, wayvnc, websockify...) est redémarré
# automatiquement par s6 s'il crashe, avec ses propres logs, sans dépendre
# d'un `while kill -0 $PID; do ...; done` maison — fragile, comme confirmé en
# direct sur ce projet (un `pkill` a un jour tué le superviseur de wayvnc en
# plus du service, sans que rien ne le relance). Version épinglée (pas
# "latest") : composant d'infrastructure, la reproductibilité prime ici sur
# la fraîcheur.
ARG S6_OVERLAY_VERSION=3.2.3.2
RUN curl -fsSL -o /tmp/s6-overlay-noarch.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && \
    curl -fSL -o /tmp/s6-overlay-x86_64.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && \
    rm -f /tmp/s6-overlay-*.tar.xz

# ── 3. Règles udev manettes (Xbox/PlayStation/Switch — mappings non standard) ─
RUN git clone --depth 1 https://codeberg.org/fabiscafe/game-devices-udev.git /tmp/gdu && \
    cp /tmp/gdu/src/*.rules /etc/udev/rules.d/ && \
    rm -rf /tmp/gdu

# ── 3b. Règle udev anti-double-saisie clavier/souris (30/08) — sans elle,
# libinput (labwc) lit les périphériques uinput virtuels de Sunshine EN
# PARALLÈLE d'evdev-bridge via son propre hotplug udev temps réel (qui
# fonctionne, contrairement à l'énumération initiale basée sur la base
# persistée cassée — voir point 6 de l'historique) : chaque touche/clic
# était traité deux fois, confirmé en direct. NOTE (audit B2, 31/08) :
# depuis le 30/08 evdev-bridge fait AUSSI un EVIOCGRAB exclusif de son côté
# (bridge.c, non fiable à 100% seul car le tag udev ne survit pas à un
# redémarrage de labwc) — les deux protections coexistent volontairement,
# ceinture et bretelles : cette règle couvre le cas où le grab échoue, le
# grab couvre le cas où labwc redémarre et ré-énumère sans repasser par
# le hotplug.
RUN printf 'ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="*passthrough*", ENV{LIBINPUT_IGNORE_DEVICE}="1"\n' \
      > /etc/udev/rules.d/99-sunshine-passthrough-no-libinput.rules

# ── 4. Utilisateur non-root pour la session bureau ────────────────────────────
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g "${PGID}" arcade 2>/dev/null || true && \
    useradd -m -u "${PUID}" -g "${PGID}" \
      -G wheel,video,input,render,audio -s /bin/bash arcade && \
    echo "arcade ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    mkdir -p /home/arcade/.config/sunshine && \
    chown -R arcade:arcade /home/arcade

# cap_sys_admin ajouté (29/08, pivot Wayland) : Sunshine tourne en arcade
# (non-root) — avoir CAP_SYS_ADMIN dans le conteneur (docker-compose.cachyos.yml
# cap_add) ne suffit pas, un process non-root ne l'a dans son set effectif
# que si le binaire la porte en capacité fichier. Sans ça, confirmé en
# direct : Sunshine échoue son accès KMS ("Failed to gain CAP_SYS_ADMIN"),
# retombe sur le portail XDG/PipeWire, qui reste bloqué indéfiniment en
# attente d'un consentement qu'il n'y a personne pour valider en headless —
# le serveur web/streaming de Sunshine ne démarre jamais (aucun port
# 47984-47990 en écoute), symptôme : "impossible de se connecter à Sunshine".
#
# +ep, pas +p seul (audit M8, 05/09) : une capacité de fichier "permitted"
# (+p) seule n'est PAS automatiquement utilisable — un programme doit la
# hisser lui-même du set permitted vers le set effectif (prctl/cap_set_proc)
# avant de pouvoir réellement s'en servir. Sunshine le fait pour
# CAP_SYS_ADMIN (l'accès KMS ci-dessus fonctionne bien), mais PAS pour
# CAP_SYS_NICE — confirmé en direct (build prerelease 2026.902.143621,
# 04/09) : "setpriority failed for nice -15/-10: Permission denied" à
# répétition alors que le binaire portait déjà cap_sys_nice+p. +ep la rend
# effective dès l'exec, sans que Sunshine ait quoi que ce soit à faire —
# threads d'encodage/audio correctement priorisés sous charge CPU.
RUN setcap 'cap_sys_nice,cap_sys_admin+ep' "$(readlink -f /usr/bin/sunshine)" 2>/dev/null || \
    echo "WARN: setcap sunshine impossible ici, à refaire si le binaire change au runtime"

# PipeWire — même classe de correctif (audit M8, 05/09) : sans CAP_SYS_NICE
# effective, PipeWire ne peut obtenir de priorité temps réel (SCHED_FIFO)
# pour ses threads audio qu'en passant par rtkit (D-Bus), absent de ce
# conteneur (pas de polkit/rtkit-daemon supervisé) — il tourne alors en
# ordonnancement normal, exposé aux craquements audio sous charge (jeu
# gourmand, compilation de shaders). cap_add: SYS_NICE existe déjà côté
# docker-compose ; il ne manquait que la capacité de fichier sur le binaire
# réellement exécuté, comme pour Sunshine ci-dessus.
RUN setcap 'cap_sys_nice+ep' "$(readlink -f /usr/bin/pipewire)" 2>/dev/null || \
    echo "WARN: setcap pipewire impossible ici, à refaire si le binaire change au runtime"

# Rafraîchit la base des .desktop (/usr/share/applications) — au cas où le
# menu XFCE (garcon) ne les reprendrait pas correctement sans ça, non
# confirmé en direct mais coût nul.
RUN update-desktop-database /usr/share/applications 2>/dev/null || true

# Papirus/Papirus-Dark livrés sans icon-theme.cache (30/08, warning constaté
# en direct) — contrairement à hicolor/Adwaita qui l'ont déjà. Sans ce
# fichier, GTK doit re-scanner le thème à chaque lookup d'icône au lieu de
# lire l'index précompilé — coût de performance, pas de cassure fonctionnelle,
# mais gtk-update-icon-cache est quasi gratuit au build.
RUN gtk-update-icon-cache -f /usr/share/icons/Papirus 2>/dev/null || true && \
    gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true

# ── 5. Scripts de démarrage ────────────────────────────────────────────────────
# root-cachyos/etc/ apporte l'arborescence s6-rc.d (services) par-dessus les
# fichiers déjà installés par s6-overlay lui-même (section 2b) — remplace
# l'ancien entrypoint.sh (boucle bash artisanale) entièrement.
COPY root-cachyos/etc/ /etc/
COPY root-cachyos/scripts/ /usr/local/bin/scripts/
RUN chmod +x /usr/local/bin/scripts/*.sh && \
    find /etc/s6-overlay/s6-rc.d -name run -exec chmod +x {} \; && \
    ln -sf /usr/local/bin/scripts/steamos-session-select.sh /usr/bin/steamos-session-select && \
    ln -sf /usr/local/bin/scripts/os-session-select.sh /usr/lib/os-session-select

# Caches de shaders (DXVK/NVIDIA) HORS de /config — voir commentaire détaillé
# dans Dockerfile.ubuntu (audit 2026-08-26) : /config est sur un partage
# Unraid FUSE/shfs, le stockage écrivable du conteneur est sur le pool Docker
# direct (typiquement le pool cache Unraid). Cache non persistant entre
# recréations du conteneur, contre un accès disque nettement plus rapide.
RUN mkdir -p /var/cache/steambox/dxvk /var/cache/steambox/nv-shader && \
    chmod -R 1777 /var/cache/steambox

# Inventaire de paquets (audit H2, 05/09) : rien n'étant épinglé dans ce
# Dockerfile hormis s6-overlay et désormais la base (voir FROM plus haut),
# c'est le seul moyen fiable de savoir ce qu'une image donnée contient
# réellement une fois construite. `diff` entre deux `docker run --rm <tag>
# cat /etc/steambox-packages.txt` rend visible tout ce qui a changé entre
# deux builds — Mesa, wlroots, Sunshine, émulateurs AUR/pacman compris.
RUN pacman -Q > /etc/steambox-packages.txt

# GSK_RENDERER=cairo (fix GTK4 de l'ère X11) retiré : la cause identifiée
# était le SHM X11 refusé par un client non-root (arcade) face à un Xorg
# root — plus de root/Xorg du tout dans cette session Wayland (labwc tourne
# entièrement en arcade via seatd, voir wayland-session.sh). À remettre si
# un bug de rendu GTK4 identique resurgit ici, non revérifié en direct sous
# Wayland.
#
# XDG_RUNTIME_DIR retirée d'ici (audit F2, 05/09) : cette ENV globale valait
# "/run/user/1000", qui ne correspond JAMAIS à l'UID réel d'arcade en
# production (99 côté Unraid/PUID, voir docker-compose.cachyos.yml) —
# fausse pour tout ce qui l'hériterait sans la recalculer. Au moins trois
# services de ce dépôt (svc-wayvnc, svc-evdev-bridge, svc-sunshine)
# documentent déjà le bug exact que cette valeur causait et la
# recalculent eux-mêmes via $(id -u arcade). init-system/run exporte
# désormais la VRAIE valeur dans /run/s6/container_environment/ (lu par
# with-contenv, l'en-tête de tous les scripts s6-rc.d de ce projet), avec
# le bon PUID dès le premier service qui en a besoin.
# LC_ALL absent volontairement (audit F5, 05/09) : primait auparavant sur
# TOUTE variable LC_*, empêchant de passer un jeu/outil précis en anglais
# sans le retirer globalement — LANG+LANGUAGE ci-dessous suffisent pour
# une interface FR par défaut, sans ce verrou.
ENV WAYLAND_DISPLAY=wayland-0 \
    SEATD_VTBOUND=0 \
    LIBSEAT_BACKEND=seatd \
    QT_QPA_PLATFORM=wayland \
    SDL_VIDEODRIVER=wayland,x11 \
    SDL_JOYSTICK_DISABLE_UDEV=1 \
    XDG_CURRENT_DESKTOP=XFCE \
    XDG_SESSION_TYPE=wayland \
    LIBVA_DRIVER_NAME=nvidia \
    NVD_BACKEND=direct \
    LANG=fr_FR.UTF-8 \
    LANGUAGE=fr_FR:fr \
    DOOMWADDIR=/usr/local/share/doom \
    DXVK_STATE_CACHE_PATH=/var/cache/steambox/dxvk \
    __GL_SHADER_DISK_CACHE_PATH=/var/cache/steambox/nv-shader \
    __GL_SHADER_DISK_CACHE_SIZE=1073741824 \
    S6_KEEP_ENV=1 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=2

VOLUME /config
# EXPOSE purement documentaire (audit B4, 31/08) : le conteneur tourne en
# network_mode: host, cette directive n'a donc aucun effet — gardée comme
# inventaire des ports réellement utilisés : 6080 noVNC, 47984/47989/47990
# Sunshine (HTTPS/HTTP/Web UI), 47998-48000/udp flux vidéo/audio/contrôle,
# 48010 RTSP, 1337 interface web decky-loader (gestion des plugins).
EXPOSE 6080 47990 47984 47989 47998-48000/udp 48010 1337

ENTRYPOINT ["/init"]
