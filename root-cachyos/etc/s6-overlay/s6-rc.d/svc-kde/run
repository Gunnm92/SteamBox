#!/command/with-contenv bash
# Session KDE Plasma, utilisateur arcade. Le script génère la config
# minimale (pas d'écran de verrouillage, base d'applications) puis exec
# dans dbus-run-session -- kwin_wayland+plasmashell — c'est ce process
# final que s6 supervise (redémarre automatiquement en cas de crash).
exec runuser -u arcade -- /usr/local/bin/scripts/kde-session.sh
