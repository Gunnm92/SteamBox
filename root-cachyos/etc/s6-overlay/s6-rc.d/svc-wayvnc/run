#!/command/with-contenv bash
# wayvnc capture labwc via wlr-screencopy (protocole wlroots natif) — marche
# ici contrairement à KWin (voir point 6 de l'historique Dockerfile.cachyos).
# Sert le RFB brut sur 5900, en local uniquement : websockify (svc-websockify)
# fait le pont websocket pour l'accès navigateur.
# $(id -u arcade), pas ${XDG_RUNTIME_DIR:-...} : historiquement, cette
# variable était fixée globalement dans le Dockerfile à /run/user/1000, qui
# ne correspond PAS à l'UID réel d'arcade (99 côté Unraid/PUID) — le repli
# ":-" ne se déclenchait donc jamais. Cette ENV a été retirée (audit F2,
# 05/09 ; init-system exporte désormais la vraie valeur) ; le calcul
# explicite est gardé, il ne dépend d'aucun héritage.
# Bug d'origine, confirmé en direct le 30/08 : le service
# cherchait le socket au mauvais endroit et ne démarrait jamais wayvnc.
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"
SOCKET_PATH="${XDG_RUNTIME_DIR}/wayland-0"

TIMEOUT=30
while [ ! -S "${SOCKET_PATH}" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done

# Échec franc si le socket n'existe toujours pas (audit M1, 05/09, même
# pattern que svc-sunshine/svc-labwc-headless) : sans ça wayvnc démarrait
# quand même après le timeout et échouait à se connecter en silence,
# laissant le VNC mort jusqu'à un redémarrage manuel du service.
if [ ! -S "${SOCKET_PATH}" ]; then
    echo "[wayvnc] wayland-0 absent après 15s — refus de démarrer, s6 va relancer."
    exit 1
fi

mkdir -p /config/logs
# -k <layout>[-<variant>] (30/08) : wayvnc a son propre chemin d'input,
# indépendant d'evdev-bridge/Sunshine — sans ce flag il utilise un clavier
# par défaut (US). Syntaxe <layout>-<variant> propre à wayvnc (voir --help),
# ex. fr-mac. Disposition : KEYBOARD_LAYOUT/VARIANT (steambox-env.sh).
# shellcheck source=../../../../scripts/steambox-env.sh
. /usr/local/bin/scripts/steambox-env.sh
exec s6-setuidgid arcade \
  env HOME=/home/arcade WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
  wayvnc --render-cursor --max-fps=60 -k "${KEYBOARD_LAYOUT}${KEYBOARD_VARIANT:+-${KEYBOARD_VARIANT}}" 127.0.0.1 5900
