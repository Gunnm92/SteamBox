#!/command/with-contenv bash
# Préparation système one-shot, avant tout service longrun.
set -e

PUID="${PUID:-1000}"
PGID="${PGID:-1000}"

echo "[init-system] Préparation système..."

# ── Alignement UID/GID sur le volume /config monté ─────────────────────────
if [ "$(id -u arcade)" != "${PUID}" ] || [ "$(id -g arcade)" != "${PGID}" ]; then
    groupmod -o -g "${PGID}" arcade
    usermod -o -u "${PUID}" -g "${PGID}" arcade
fi
mkdir -p /config
chown "${PUID}:${PGID}" /config
# Le home réel vit sur le volume /config (persistant), pas dans le rootfs image.
if [ ! -d /config/.config ]; then
    cp -a /home/arcade/. /config/ 2>/dev/null || true
fi
rm -rf /home/arcade
ln -sfn /config /home/arcade

# ── Driver NVIDIA userspace (matché au host) ───────────────────────────────
/usr/local/bin/install-nvidia-userspace.sh || echo "[init-system] Continuer sans match NVIDIA (voir logs ci-dessus)"

# ── ICD Vulkan NVIDIA aussi dans /usr/share (audit 29/08, Eden) ────────────
# nvidia-container-toolkit injecte nvidia_icd.json UNIQUEMENT dans
# /etc/vulkan/icd.d/ sur cet hôte (confirmé en direct) — /etc a priorité sur
# /usr/share dans l'ordre de recherche standard du loader Vulkan, donc tout
# ce qui utilise ce loader normalement (jeux natifs, Proton/DXVK, vulkaninfo)
# le trouve déjà très bien. Mais certaines apps embarquées en AppImage
# (Eden/Yuzu) font leur propre vérification codée en dur sur le chemin
# /usr/share/vulkan/icd.d spécifiquement (message "YOU HAVE AN INCOMPLETE
# NVIDIA DRIVER INSTALLATION" au lancement) sans consulter /etc — symlink
# ajouté pour satisfaire ce genre de vérification étroite, sans dupliquer
# le vrai fichier (qui n'existe qu'au runtime, injecté par le toolkit,
# jamais présent au moment du build de cette image).
if [ -f /etc/vulkan/icd.d/nvidia_icd.json ] && [ ! -e /usr/share/vulkan/icd.d/nvidia_icd.json ]; then
    mkdir -p /usr/share/vulkan/icd.d
    ln -sf /etc/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json
fi

XDG_RUNTIME_DIR="/run/user/${PUID}"
rm -rf "${XDG_RUNTIME_DIR}" /run/seatd.sock /tmp/.X* 2>/dev/null || true
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"
chown "${PUID}:${PGID}" "${XDG_RUNTIME_DIR}"

# Exportée pour tous les services longrun via with-contenv (audit F2,
# 05/09) — remplace l'ancienne ENV Dockerfile globale XDG_RUNTIME_DIR=
# /run/user/1000, fausse dès que PUID != 1000 (le cas en production,
# PUID=99). Plusieurs services de ce dépôt recalculaient déjà eux-mêmes
# $(id -u arcade) pour contourner cette valeur héritée incorrecte —
# laissés tels quels (inoffensifs), mais tout futur script bénéficie
# maintenant directement de la bonne valeur sans avoir à le savoir.
mkdir -p /run/s6/container_environment
printf '%s' "${XDG_RUNTIME_DIR}" > /run/s6/container_environment/XDG_RUNTIME_DIR

# Permissions génériques input/GPU — device_cgroup_rules côté docker-compose
# gère déjà l'accès cgroup, ceci couvre la permission Unix classique.
#
# /dev/uhid ajouté (audit 29/08, rumble manette jamais fonctionnel) :
# contrairement à /dev/uinput (crw-rw---- root:input dès le passthrough
# Docker), /dev/uhid arrivait en crw------- root:root — inaccessible à
# arcade (Sunshine ne tourne pas root). Sunshine (libvirtualhid) crée ses
# manettes virtuelles via l'interface uhid, PAS uinput seul — sans accès à
# ce device, aucune manette virtuelle Sunshine ne peut être créée du tout
# (ni tactile/gyro DualSense, ni rumble sur aucun type de manette). Une
# règle udev seule ne suffit pas ici : ce node vient d'un passthrough Docker
# statique (--device), pas d'un événement udev interne au conteneur —
# udevadm trigger ne le touche jamais, d'où ce chmod one-shot comme pour
# les autres devices ci-dessus.
chmod 666 /dev/uinput /dev/uhid /dev/dri/card* /dev/dri/renderD* /dev/input/event* 2>/dev/null || true

# ── Groupe GID 71 (/dev/uinput, /dev/input/* côté hôte) ────────────────────
# Régression identifiée dans l'audit du 2026-08-26 : l'ancienne image
# webstation faisait de 71 un membre RÉEL et persistant du compte de session
# dans /etc/group (custom-cont-init.d/05-input-group.sh), avec ce
# commentaire explicite : le --group-add de docker-compose ajoute bien ce
# GID au process racine du conteneur, mais s6-setuidgid (utilisé par tous
# les services : svc-labwc, svc-sunshine...) recalcule les groupes
# supplémentaires depuis /etc/group à CHAQUE bascule vers arcade — ça
# écrase silencieusement le --group-add. Cette variante Ubuntu/CachyOS ne
# faisait jusqu'ici que chmod 666 les devices présents au boot (ligne
# ci-dessus), ce qui ne couvre ni le hotplug (manette branchée après coup)
# ni les périphériques virtuels uinput que Sunshine crée à chaque connexion
# Moonlight. group_add: ["71"] doit être présent côté docker-compose (voir
# docker-compose.yml/.ubuntu.yml/.cachyos.yml) pour que ce bloc ait un GID
# 71 à rejoindre.
# Ne pas supposer que le GID 71 existe déjà côté image/hôte (30/08) : sur ce
# conteneur précis, `getent group 71` ne renvoie RIEN malgré `--group-add 71`
# côté docker run — Docker injecte ce GID brut au niveau noyau pour le
# process racine et docker exec en hérite, mais ça ne crée AUCUNE entrée
# /etc/group. runuser/s6-setuidgid recalculent les groupes via /etc/group
# (comportement normal, volontaire, d'un outil de changement d'utilisateur)
# et ne voient donc jamais ce GID brut sans entrée nommée — confirmé en
# direct : evdev-bridge ne pouvait jamais ouvrir "Keyboard passthrough"
# (appartenant au GID 71), resté bloqué indéfiniment sur "Waiting for
# Sunshine devices...". On crée le groupe nous-mêmes si absent, plutôt que
# d'espérer qu'il soit déjà là.
if ! getent group 71 >/dev/null 2>&1; then
    groupadd -g 71 steambox-input 2>/dev/null || true
fi
if getent group 71 >/dev/null 2>&1; then
    HOSTINPUT_GROUP="$(getent group 71 | cut -d: -f1)"
    if ! id -nG arcade 2>/dev/null | grep -qw "${HOSTINPUT_GROUP}"; then
        usermod -aG "${HOSTINPUT_GROUP}" arcade
        echo "[init-system] arcade ajouté au groupe GID 71 (${HOSTINPUT_GROUP})"
    fi
fi

# || echo (audit H1, 05/09) : ce oneshot tourne sous set -e et TOUS les
# services longrun (labwc, sunshine, wayvnc...) en dépendent — avant ce
# correctif, une seule exception dans un de ces scripts (ex: apps.json
# édité à la main invalide pour jq, gamelist.xml malformé) tuait tout le
# conteneur d'un coup, sans rapport avec la gravité réelle du problème.
# Aucun de ces quatre scripts n'est un prérequis dur du bureau/streaming.
#
# init_retroarch ajouté à la boucle (même audit) : présent sur disque
# (root-cachyos/scripts/init_retroarch.sh) depuis l'origine mais jamais
# invoqué nulle part dans le dépôt — ses correctifs documentés
# ("confirmés en direct sur la prod" : video_vsync=false pour le freeze
# GLX, pause_nonactive=false, system_directory vers /userdata/bios)
# n'avaient donc jamais réellement pris effet.
for script in init_system init_audio init_sunshine init_pegasus init_retroarch; do
    if [ -x "/usr/local/bin/scripts/${script}.sh" ]; then
        "/usr/local/bin/scripts/${script}.sh" || echo "[init-system] ${script}.sh a échoué (code $?) — on continue"
    fi
done

# D-Bus système : machine-id requis avant que svc-dbus-system démarre.
[ -f /etc/machine-id ] || dbus-uuidgen --ensure=/etc/machine-id
mkdir -p /run/dbus

echo "[init-system] Terminé."
