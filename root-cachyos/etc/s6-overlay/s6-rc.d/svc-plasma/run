#!/command/with-contenv bash
# Bureau Plasma du navigateur (24/11) : startplasma-wayland imbriqué dans le
# compositeur de Selkies (wayland-0, svc-selkies). Remplace svc-labwc et les
# services XFCE (xfsettingsd, xfdesktop, xfce4-panel), retirés le 24/11.
# Si Selkies redémarre, KWin perd son hôte et la session s'arrête : s6 la
# relance ici, une fois le nouveau wayland-0 prêt.
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"
# shellcheck source=../../../../scripts/steambox-env.sh
. /usr/local/bin/scripts/steambox-env.sh

# Le run est lancé dès le fork de svc-selkies (pas de notification-fd) :
# attendre que son compositeur accepte des connexions. Échec franc après
# 30 s, s6 relance.
TIMEOUT=60
until socket_live "${XDG_RUNTIME_DIR}/wayland-0" || [ "${TIMEOUT}" -le 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done
if ! socket_live "${XDG_RUNTIME_DIR}/wayland-0"; then
    echo "[plasma] compositeur de Selkies (wayland-0) absent après 30 s — s6 va relancer."
    exit 1
fi

# Pile limitée à 8 Mo (30/09) : Docker sur Unraid hérite d'une pile
# ILLIMITÉE, et Linux passe alors à la disposition mémoire « legacy » (libs
# vers 0x14…). proton-cachyos (émulation seccomp) tuait ses processus enfants
# chargés sous 0x7001_0000_0000 (wineboot : SIGSYS), et les jeux 32 bits
# sous wine-tkg n'obtenaient plus leurs grosses réservations (GTI Club,
# 450 Mo). Hérité par tout ce que lance le bureau (Steam, ES, jeux).
ulimit -S -s 8192 2>/dev/null || true

# exec : s6 signale directement la chaîne runuser → startplasma.
# QT_QPA_PLATFORM="wayland;xcb" : repli X11 pour les AppImage Qt livrées sans
# greffon Wayland (AppManager, autostart : « no Qt platform plugin could be
# initialized », essai du 24/11).
exec runuser -u arcade -- env \
    HOME=/home/arcade USER=arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    KEYBOARD_LAYOUT="${KEYBOARD_LAYOUT}" KEYBOARD_VARIANT="${KEYBOARD_VARIANT}" \
    "QT_QPA_PLATFORM=wayland;xcb" XDG_CURRENT_DESKTOP=KDE \
    SDL_VIDEODRIVER=wayland,x11 SDL_JOYSTICK_DISABLE_UDEV=1 \
    PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games" \
    /usr/local/bin/scripts/plasma-session.sh
