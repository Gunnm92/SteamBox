#!/command/with-contenv bash
# Compositeur de streaming (Sunshine/Moonlight, Steam Remote Play) : KWin en
# DRM sur la sortie branchée au GPU du conteneur (dongle HDMI factice),
# capturée en KMS par Sunshine (HDR possible). Historique : labwc headless
# du 30/08 au 24/11 (gamescope n'expose aucun protocole de capture), KWin en
# DRM avec dongle depuis le 24/11 (phase 1 KWin), seul depuis le 24/11
# (Selkies + Plasma) : labwc retiré de l'image.
#
# Dongle OBLIGATOIRE (24/11, choix utilisateur) : KWin 6.8 en --virtual ne
# lit aucune entrée (essai T4 de la phase 0), donc sans sortie branchée il
# n'y a ni compositeur de streaming ni Sunshine — le service attend sans
# boucler (sleep infinity), et svc-sunshine fait de même.
#
# Socket wayland-stream (24/11), plus wayland-1 : un nom non numéroté.
# Selkies (bureau navigateur, wayland-0) cherche le compositeur de ses
# applis parmi les autres sockets wayland-<chiffres> et n'en accepte qu'un
# (le KWin de Plasma) ; avec deux candidats il injecte dans son propre
# compositeur et perd toutes les touches non ASCII. Et le wrapper KWin de
# Plasma, qui prend le premier wayland-N libre, ne peut jamais prendre ce
# nom pendant que ce KWin est arrêté (session Steam gamescope).
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

# Pile limitée à 8 Mo (30/09) : Docker sur Unraid hérite d'une pile
# ILLIMITÉE, et Linux passe alors à la disposition mémoire « legacy » (libs
# vers 0x14…). proton-cachyos (émulation seccomp) tuait ses processus enfants
# chargés sous 0x7001_0000_0000 (wineboot : SIGSYS), et les jeux 32 bits
# sous wine-tkg n'obtenaient plus leurs grosses réservations (GTI Club,
# 450 Mo). Hérité par tout ce que lance ce service (Steam, ES, jeux).
ulimit -S -s 8192 2>/dev/null || true

# Sortie streamée (22/11, steambox-env.sh : stream_drm_card). Le connecteur
# retenu est noté dans $XDG_RUNTIME_DIR/steambox-stream-output (vide sans
# dongle), lu par svc-sunshine, set-resolution.sh et la session Steam.
# shellcheck source=../../../../scripts/steambox-env.sh
. /usr/local/bin/scripts/steambox-env.sh
read -r STREAM_CARD STREAM_CONNECTOR _ <<<"$(stream_drm_card)"
printf '%s' "${STREAM_CONNECTOR:-}" > "${XDG_RUNTIME_DIR}/steambox-stream-output"
chown arcade "${XDG_RUNTIME_DIR}/steambox-stream-output"

if [ -z "${STREAM_CONNECTOR:-}" ]; then
    rm -f "${XDG_RUNTIME_DIR}/steambox-stream-compositor"
    echo "[kwin-stream] aucune sortie branchée : dongle HDMI requis pour Moonlight/Remote Play (bureau navigateur seul)"
    exec sleep infinity
fi

# Session Steam en DRM : son prep-cmd Sunshine (lancé en arcade) arrête ce
# compositeur pour libérer la sortie, puis le relance
# (steam-gamescope-session.sh).
s6-svperms -O arcade -E arcade . 2>/dev/null || true

echo "[kwin-stream] sortie ${STREAM_CONNECTOR} pilotée en DRM par KWin (${STREAM_CARD}), capture KMS"
printf '%s' kwin > "${XDG_RUNTIME_DIR}/steambox-stream-compositor"
# dbus-daemon --fork se détache : s6-svc -d ne l'atteint pas, et chaque
# relance en laissait un orphelin (environnement d'activation, portails
# périmés). Son PID est noté (24/11) et tué ici avant de le relancer, mais
# seulement si ce PID est un dbus-daemon DONT la ligne de commande porte le
# chemin de ce bus (24/11) : un PID réutilisé par le dbus-daemon du bureau
# (même nom de processus) n'est pas touché. comm seul ne suffit pas.
OLD_PID=$(cat "${XDG_RUNTIME_DIR}/bus-stream.pid" 2>/dev/null)
OLD_CMD=$(tr '\0' ' ' < "/proc/${OLD_PID:-0}/cmdline" 2>/dev/null)
if [[ "${OLD_PID}" =~ ^[0-9]+$ ]] \
    && [ "$(cat "/proc/${OLD_PID}/comm" 2>/dev/null)" = dbus-daemon ] \
    && [[ "${OLD_CMD}" == *"unix:path=${XDG_RUNTIME_DIR}/bus-stream "* ]]; then
    kill "${OLD_PID}" 2>/dev/null
    TIMEOUT=50
    while [ -d "/proc/${OLD_PID}" ] && [ "${TIMEOUT}" -gt 0 ]; do
        sleep 0.1
        TIMEOUT=$((TIMEOUT - 1))
    done
fi
# Restes d'une session KWin morte (env, DISPLAY, socket de bus) retirés :
# dbus-daemon refuse un socket existant, et les applis ne doivent pas lire
# un DISPLAY périmé.
rm -f "${XDG_RUNTIME_DIR}/steambox-stream-session.env" \
      "${XDG_RUNTIME_DIR}/steambox-stream-display" \
      "${XDG_RUNTIME_DIR}/bus-stream" \
      "${XDG_RUNTIME_DIR}/bus-stream.pid"
# Bus de session propre à ce compositeur (24/11) : KWin et les applis
# lancées depuis Sunshine s'y connectent, et non au bus du bureau.
# --print-pid écrit le PID du démon forké dans le fichier, pour la
# prochaine relance.
runuser -u arcade -- env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    dbus-daemon --session --address="unix:path=${XDG_RUNTIME_DIR}/bus-stream" --fork --print-pid \
    > "${XDG_RUNTIME_DIR}/bus-stream.pid" || {
    echo "[kwin-stream] dbus-daemon du bus de streaming non démarré — s6 va relancer."
    exit 1
}
# env -u : WAYLAND_DISPLAY et DISPLAY hérités de l'ENV du Dockerfile
# feraient croire à KWin qu'il est un client imbriqué ;
# KWIN_*_NO_PERMISSION_CHECKS : KWin ne demande pas d'autorisation de
# capture ou de saisie (personne pour répondre à la fenêtre dans ce
# conteneur, sans écran). kwin-launch.py (24/11) : prépare les sockets X
# (Xwayland) que kwin_wayland lancé seul ne crée pas, en gardant --socket.
exec runuser -u arcade -- \
    env -u WAYLAND_DISPLAY -u DISPLAY HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus-stream" \
    XDG_CURRENT_DESKTOP=KDE XDG_SESSION_TYPE=wayland \
    KWIN_WAYLAND_NO_PERMISSION_CHECKS=1 KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1 \
    KWIN_DRM_DEVICES="${STREAM_CARD}" KWIN_FORCE_ASSUME_HDR_SUPPORT=1 \
    /usr/local/bin/scripts/kwin-launch.py --drm --xwayland --socket wayland-stream \
    --no-lockscreen --exit-with-session /usr/local/bin/scripts/kwin-stream-session.sh
