#!/command/with-contenv bash
# Longrun, pas oneshot (audit M3, 05/09) — l'ancienne version en oneshot
# lançait "systemd-udevd --daemon", qui se détache lui-même dans sa propre
# session : s6 ne pouvait donc PAS le superviser (aucun process à
# surveiller après le retour immédiat du oneshot), confirmé en direct par
# le commentaire d'origine de ce fichier. Toute la chaîne de hotplug
# manette (mknod hidraw, permissions uhid, tag LIBINPUT_IGNORE_DEVICE)
# dépend de ce démon — sa mort silencieuse reproduisait exactement les
# symptômes déjà vécus sur ce projet ("manette détectée, zéro bouton") sans
# aucune ligne de log pour l'expliquer, et rien ne le relançait jamais.
#
# --daemon retiré : udevd reste au premier plan, supervisé comme tout
# autre longrun de ce projet (peut être relancé par s6 s'il meurt).
#
# rm préventif du socket de contrôle (même motif que svc-dbus-system/run,
# qui nettoie déjà /run/dbus/pid pour la même raison) : un udevd qui
# meurt sans nettoyer laisse /run/udev/control, et un nouveau udevd
# détecte alors un démon "déjà résident" et sort immédiatement sans
# jamais réellement démarrer.
rm -f /run/udev/control

# Nécessaire pour le hotplug (souris/clavier virtuels créés par Sunshine à
# la connexion d'un client) : sans démon udev tournant en continu,
# libinput/Hyprland ne détecte jamais ces périphériques uinput.
exec /usr/lib/systemd/systemd-udevd
