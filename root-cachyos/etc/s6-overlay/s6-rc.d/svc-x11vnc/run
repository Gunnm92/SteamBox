#!/command/with-contenv bash
# x11vnc, pas wayvnc : confirmé en direct que wayvnc ne fonctionne QUE sur
# les compositeurs wlroots (son propre README l'indique explicitement pour
# Gnome/KDE/Weston). x11vnc capture n'importe quelle session X11 sans se
# soucier du gestionnaire de fenêtres.
#
# -noshm : sans ça, plantage immédiat ("X11 MIT Shared Memory Attach
# failed... BadAccess") — confirmé en direct, l'attache mémoire partagée
# est refusée dans ce conteneur (x11vnc et le serveur X n'ont pas le même
# contexte de permissions). Léger coût en perf (XGetImage au lieu de SHM),
# sans conséquence pour un usage de configuration/setup, pas de jeu.
#
# -noxdamage retiré (audit 2026-08-26) : cette option désactive l'extension
# X DAMAGE, qui permet à x11vnc de ne relire QUE les zones d'écran modifiées
# entre deux images. Sans elle, x11vnc rescanne l'écran entier en boucle
# (XGetImage plein écran plusieurs fois par seconde) même bureau immobile —
# un des postes de CPU permanent les plus probables identifiés dans l'audit.
# Aucun rapport documenté avec le bug SHM ci-dessus (BadAccess) : ajouté par
# précaution, jamais nécessaire pour corriger un symptôme précis. À remettre
# uniquement si DAMAGE se révèle lui aussi cassé dans ce conteneur (rects
# de mise à jour visiblement incorrects/manquants dans le client VNC).
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

TIMEOUT=30
while ! DISPLAY=:0 s6-setuidgid arcade xdpyinfo >/dev/null 2>&1 && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done

exec s6-setuidgid arcade \
    env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" DISPLAY=:0 \
    x11vnc -display :0 -forever -shared -rfbport 5901 -nopw -noshm
