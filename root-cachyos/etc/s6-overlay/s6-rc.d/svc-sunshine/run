#!/command/with-contenv bash
# WAYLAND_DISPLAY=wayland-1 (socket du labwc HEADLESS, voir svc-labwc-
# headless/run) au lieu de wayland-0 (bureau XFCE visible) — 30/08, suite à
# l'audit HDR/gamescope : gamescope ne peut jamais être capturé par Sunshine
# (portail D-Bus absent, XDG_OUTPUT manquant, EGL_BAD_ACCESS, testé sous
# toutes ses formes), alors qu'un second labwc dédié, headless, fonctionne
# nativement (labwc implémente les protocoles de capture modernes que
# gamescope n'a pas). Sunshine tourne donc maintenant contre une session
# séparée du bureau visible en local/VNC — Steam lancé depuis cette session
# (voir apps.json, "detached" hérite de cet environnement) est ce que
# Moonlight affiche ; le bureau XFCE local reste inchangé et indépendant.
#
# s6-setuidgid change l'UID/GID mais PAS HOME — contrairement à runuser/su,
# il ne fait rien de plus (pas de vraie session utilisateur). Sans le
# préciser, Sunshine hérite du HOME=/root ambiant et tente d'écrire sa
# config dans /root/.config/sunshine, inaccessible à arcade — confirmé en
# direct : "Failed to apply config: filesystem error: status: Permission
# denied [/root/.config/sunshine]" en boucle jusqu'à ce crash-loop soit fixé.
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

# Attend que le socket Wayland du labwc headless existe réellement (le
# service le lance mais ne le signale pas comme "up" avant la fin du
# script) — Sunshine échouerait sa capture s'il démarre avant que le
# compositeur n'accepte de connexions.
TIMEOUT=30
while [ ! -S "${XDG_RUNTIME_DIR}/wayland-1" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done

# DISPLAY=:1 (30/08, audit "Steam Big Picture" cassé) : labwc démarre son
# Xwayland interne PARESSEUSEMENT, seulement quand un premier client en a
# besoin (confirmé en direct : rien ne l'annonce à l'avance, pas de
# protocole/variable à interroger avant coup) — mais une fois démarré, il
# reste vivant tant que le compositeur tourne. Steam a besoin de ce DISPLAY
# pour son petit écran "vérification des mises à jour" (Xlib brut, pas
# Wayland) : sans lui, "XOpenDisplay failed" puis un dialogue d'erreur
# zenity qui bloque le lancement complet de gamepadui — confirmé en direct.
# :1 plutôt que :0 : le bureau XFCE (svc-labwc, wayland-0) démarre TOUJOURS
# avant ce service headless — garanti depuis l'audit C1 du 31/08 :
# svc-labwc-headless refuse désormais de démarrer (exit 1, s6 relance)
# tant que wayland-0 n'existe pas, au lieu de continuer après timeout et
# de risquer de voler wayland-0/:0 au bureau (inversion des rôles vécue
# en direct le 31/08). Ce service-ci est donc toujours le second, :1 est
# fiable tant qu'aucune troisième session Xwayland ne s'intercale.
exec s6-setuidgid arcade \
    env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" WAYLAND_DISPLAY=wayland-1 DISPLAY=:1 \
    sunshine /config/.config/sunshine/sunshine.conf
