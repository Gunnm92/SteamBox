#!/command/with-contenv bash
# DISPLAY=:0 : Sunshine tourne indépendamment de la session KDE (pas un
# enfant lancé par elle), donc n'hérite de rien d'autre que ce qu'on lui
# passe explicitement.
#
# s6-setuidgid change l'UID/GID mais PAS HOME — contrairement à runuser/su,
# il ne fait rien de plus (pas de vraie session utilisateur). Sans le
# préciser, Sunshine hérite du HOME=/root ambiant et tente d'écrire sa
# config dans /root/.config/sunshine, inaccessible à arcade — confirmé en
# direct : "Failed to apply config: filesystem error: status: Permission
# denied [/root/.config/sunshine]" en boucle jusqu'à ce crash-loop soit fixé.
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

# Attend que Xorg réponde réellement (svc-kde le lance mais ne le signale
# pas comme "up" avant la fin de tout le script — Sunshine échouerait sa
# capture s'il démarre avant que le serveur X n'accepte de connexions).
TIMEOUT=30
while ! DISPLAY=:0 s6-setuidgid arcade xdpyinfo >/dev/null 2>&1 && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done

exec s6-setuidgid arcade \
    env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" DISPLAY=:0 \
    sunshine /config/.config/sunshine/sunshine.conf
