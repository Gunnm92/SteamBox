#!/command/with-contenv bash
# Sunshine contre le KWin de streaming (svc-kwin-stream, socket
# wayland-stream), séparé du bureau navigateur (Selkies + Plasma). Steam
# lancé depuis cette session (apps.json, "detached" hérite de cet
# environnement) est ce que Moonlight affiche. Historique : labwc headless
# du 30/08 au 24/11 (gamescope ne peut pas être capturé), KWin en DRM sur le
# dongle depuis le 24/11, seul depuis le 24/11 (Selkies + Plasma).
#
# s6-setuidgid change l'UID/GID mais PAS HOME — contrairement à runuser/su.
# Sans le préciser, Sunshine hérite du HOME=/root ambiant et tente d'écrire
# sa config dans /root/.config/sunshine, inaccessible à arcade (crash-loop
# vu en direct).
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

# Dongle HDMI obligatoire (24/11) : sans sortie branchée, svc-kwin-stream ne
# lance pas de compositeur — Sunshine attend sans boucler. Le fichier est
# écrit par svc-kwin-stream (dépendance) avant tout le reste.
TIMEOUT=20
while [ ! -e "${XDG_RUNTIME_DIR}/steambox-stream-output" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done
if [ ! -s "${XDG_RUNTIME_DIR}/steambox-stream-output" ]; then
    echo "[sunshine] aucune sortie branchée : dongle HDMI requis, Sunshine non démarré"
    exec sleep infinity
fi

# Attend que le socket de KWin existe réellement (s6 déclare le service
# "up" dès le fork du script) — Sunshine échouerait sa capture sinon.
# Échec franc (audit M1, 05/09) : exit 1 et s6 relance, jamais de démarrage
# "réussi" sans cible de capture.
TIMEOUT=30
while [ ! -S "${XDG_RUNTIME_DIR}/stream/wayland-stream" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done
if [ ! -S "${XDG_RUNTIME_DIR}/stream/wayland-stream" ]; then
    echo "[sunshine] wayland-stream absent après 15s — refus de démarrer, s6 va relancer."
    exit 1
fi

# Pile limitée à 8 Mo (30/09) : Docker sur Unraid hérite d'une pile
# ILLIMITÉE, et Linux passe alors à la disposition mémoire « legacy » (libs
# vers 0x14…). proton-cachyos (émulation seccomp) tuait ses processus enfants
# chargés sous 0x7001_0000_0000 (wineboot : SIGSYS), et les jeux 32 bits
# sous wine-tkg n'obtenaient plus leurs grosses réservations (GTI Club,
# 450 Mo). Hérité par tout ce que lance ce service (Steam, ES, jeux).
ulimit -S -s 8192 2>/dev/null || true

# Environnement de la session KWin (24/11) : Sunshine et les applis qu'il
# lance (Steam, EmulationStation) doivent voir le bus bus-stream, le
# Xwayland de KWin et ses portails. kwin-stream-session.sh publie
# steambox-stream-session.env puis steambox-stream-display (signal de
# disponibilité) ; sans eux après 10 s : refus de démarrer, s6 relance.
# shellcheck source=../../../../scripts/steambox-env.sh
. /usr/local/bin/scripts/steambox-env.sh
TIMEOUT=20
while [ ! -s "${XDG_RUNTIME_DIR}/steambox-stream-display" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done
if ! stream_session_env; then
    echo "[sunshine] steambox-stream-session.env absent après 10s — refus de démarrer, s6 va relancer."
    exit 1
fi

# DualSense USB/IP (ds5-usbip, via le Sunshine de sunshine-ds) : activée par
# défaut ; repli automatique sur uhid si vhci-hcd n'est pas monté en écriture.
# Haptiques vers le client : LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP=ip:port dans
# l'environnement du conteneur (modèle Unraid / profil).
export LIBVIRTUALHID_DUALSENSE_USBIP="${LIBVIRTUALHID_DUALSENSE_USBIP:-1}"
# capture=kms (22/11) : seule capture qui transmet le HDR, et elle suit la
# sortie quelle que soit l'appli qui la pilote (KWin, ou gamescope seul
# pendant la session Steam). XDG_CURRENT_DESKTOP=KDE et
# KWIN_WAYLAND_NO_PERMISSION_CHECKS : session validée à la main le 24/11,
# sans demande d'autorisation de capture (personne pour répondre).
exec s6-setuidgid arcade \
    env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
    WAYLAND_DISPLAY="${XDG_RUNTIME_DIR}/stream/wayland-stream" DISPLAY="$(stream_display)" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
    XDG_CURRENT_DESKTOP=KDE KWIN_WAYLAND_NO_PERMISSION_CHECKS=1 \
    sunshine /config/.config/sunshine/sunshine.conf capture=kms
