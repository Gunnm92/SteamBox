#!/command/with-contenv bash
# Sert les fichiers statiques noVNC.
# HOME=/home/arcade explicite : s6-setuidgid change l'UID/GID mais pas HOME
# (contrairement à runuser/su) — n'affecte pas ce serveur statique en
# pratique, mais gardé pour cohérence avec svc-sunshine/svc-wayvnc où
# l'absence de HOME cassait réellement le service.
exec s6-setuidgid arcade \
    env HOME=/home/arcade \
    python3 -m http.server 6080 --directory /usr/share/webapps/novnc --bind 0.0.0.0
