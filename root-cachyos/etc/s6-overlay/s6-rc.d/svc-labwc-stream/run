#!/command/with-contenv bash
# Deuxième compositeur — dédié à Sunshine/Moonlight (labwc ; KWin en DRM depuis
# le 24/11, voir plus bas). Headless à
# l'origine (svc-labwc-headless, renommé svc-labwc-stream le 22/11) ; en DRM
# sur le dongle HDMI s'il est branché (voir plus bas), indépendant du bureau XFCE visible
# en local/VNC (svc-labwc, wayland-0). Ajouté le 30/08 suite à l'échec
# confirmé de gamescope comme cible de capture Sunshine (portail D-Bus
# absent, XDG_OUTPUT manquant, EGL_BAD_ACCESS — testé avec ET sans HDR,
# en --backend drm ET headless, jamais fonctionnel) : gamescope n'implémente
# jamais les protocoles de capture (ext_image_copy_capture_manager_v1) que
# labwc, lui, expose nativement. Pattern repris de github.com/daaaaan/
# sunshine-headless-sway (Sway à la place de labwc là-bas — même famille
# wlroots, même principe), validé en direct le 30/08 : capture NVENC
# fonctionnelle contre ce labwc headless (vraies keyframes IDR), input
# souris/clavier fonctionnel via evdev-bridge-native inchangé (labwc
# implémente zwlr_virtual_pointer/zwp_virtual_keyboard nativement, pas
# besoin du bridge libei exploré pour gamescope).
#
# En headless, LIBSEAT_BACKEND=noop : pas de vrai accès DRM/VT nécessaire
# (aucune sortie physique) — seatd resterait bloqué à attribuer un VT à un
# compositeur qui n'en a pas besoin. WLR_BACKENDS=headless force wlroots à
# créer un backend de rendu hors écran au lieu de chercher un GPU/VT réel.
#
# unset WAYLAND_DISPLAY/DISPLAY avant lancement : même piège que labwc
# principal (voir wayland-session.sh) — hérités depuis l'ENV Dockerfile, ce
# compositeur tenterait sinon de s'y CONNECTER comme client au lieu de créer
# son propre socket.
XDG_RUNTIME_DIR="/run/user/$(id -u arcade)"

# Attend que le labwc PRINCIPAL (svc-labwc) ait déjà créé wayland-0 avant de
# démarrer celui-ci — sans ça, rien ne garantit l'ordre : wlroots numérote
# les sockets par ordre d'arrivée (premier lancé = wayland-0), et le
# marqueur "up" d'un service s6 longrun sans notification-fd se déclenche
# dès le fork du script, pas une fois labwc réellement lancé dedans
# (wayland-session.sh fait dbus/pipewire/GTK avant sa ligne `labwc &`) — une
# simple dépendances.d/svc-labwc ne suffit donc pas à empêcher ce service-ci
# de gagner la course et de prendre wayland-0 à la place du bureau visible,
# cassant wayvnc/evdev-bridge/xfce qui le codent tous en dur.
TIMEOUT=30
while [ ! -S "${XDG_RUNTIME_DIR}/wayland-0" ] && [ "${TIMEOUT}" -gt 0 ]; do
    sleep 0.5
    TIMEOUT=$((TIMEOUT - 1))
done

# Échec FRANC si wayland-0 n'existe toujours pas (audit C1, 31/08) : la
# version précédente démarrait quand même après le timeout — si le bureau
# visible tardait (crash-loop, seatd pas prêt), CE compositeur headless
# créait alors wayland-0 à sa place et le bureau récupérait wayland-1,
# inversant les rôles pour wayvnc/Sunshine/evdev-bridge qui codent ces
# noms en dur (vécu en direct le 31/08 : bureau capturé par Moonlight,
# flux headless sur le VNC). exit 1 + s6 qui relance ce service jusqu'à
# ce que le bureau soit réellement up : l'invariant "headless = wayland-1"
# ne peut plus être violé, quel que soit l'ordre réel de démarrage.
if [ ! -S "${XDG_RUNTIME_DIR}/wayland-0" ]; then
    echo "[labwc-stream] wayland-0 absent après 15s — refus de démarrer" \
         "(sinon ce compositeur volerait wayland-0 au bureau), s6 va relancer."
    exit 1
fi

# Pile limitée à 8 Mo (30/09) : Docker sur Unraid hérite d'une pile
# ILLIMITÉE, et Linux passe alors à la disposition mémoire « legacy » (libs
# vers 0x14…). proton-cachyos (émulation seccomp) tuait ses processus enfants
# chargés sous 0x7001_0000_0000 (wineboot : SIGSYS), et les jeux 32 bits
# sous wine-tkg n'obtenaient plus leurs grosses réservations (GTI Club,
# 450 Mo). Hérité par tout ce que lance ce service (Steam, Heroic, ES, jeux).
ulimit -S -s 8192 2>/dev/null || true

# Sortie streamée (22/11, steambox-env.sh : stream_drm_card) : si une sortie
# est branchée sur le GPU du conteneur (dongle HDMI factice), ce labwc la
# pilote en DRM (seatd) et Sunshine la capture en KMS — HDR possible, et la
# session Steam y met gamescope seul en DRM. Sinon, headless comme avant
# (Sunshine en capture wlr). Le connecteur retenu est noté dans
# $XDG_RUNTIME_DIR/steambox-stream-output (vide en headless), lu par
# svc-sunshine, svc-evdev-bridge, set-resolution.sh et la session Steam.
# shellcheck source=../../../../scripts/steambox-env.sh
. /usr/local/bin/scripts/steambox-env.sh
read -r STREAM_CARD STREAM_CONNECTOR _ <<<"$(stream_drm_card)"
printf '%s' "${STREAM_CONNECTOR:-}" > "${XDG_RUNTIME_DIR}/steambox-stream-output"
chown arcade "${XDG_RUNTIME_DIR}/steambox-stream-output"

# Session Steam en DRM : son prep-cmd Sunshine (lancé en arcade) arrête ce
# labwc pour libérer la sortie, puis le relance (steam-gamescope-session.sh).
s6-svperms -O arcade -E arcade . 2>/dev/null || true

# Sortie branchée : KWin la pilote en DRM au lieu de labwc (24/11, phase 1 KWin),
# sur le même bus et les mêmes noms (wayland-1, steambox-stream-display). Le
# marqueur steambox-stream-compositor dit aux autres services lequel tourne
# (stream_compositor, steambox-env.sh). Les restes d'une session KWin morte
# (env, DISPLAY, socket de bus) sont retirés avant : dbus-daemon refuse un
# socket existant, et les applis ne doivent pas lire un DISPLAY périmé.
if [ -n "${STREAM_CONNECTOR:-}" ]; then
    echo "[kwin-stream] sortie ${STREAM_CONNECTOR} pilotée en DRM par KWin (${STREAM_CARD}), capture KMS"
    printf '%s' kwin > "${XDG_RUNTIME_DIR}/steambox-stream-compositor"
    rm -f "${XDG_RUNTIME_DIR}/steambox-stream-session.env" \
          "${XDG_RUNTIME_DIR}/steambox-stream-display" \
          "${XDG_RUNTIME_DIR}/bus-stream"
    # Bus de session propre à ce compositeur (24/11) : KWin et les applis
    # lancées depuis Sunshine s'y connectent, et non au bus du bureau.
    runuser -u arcade -- env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
        dbus-daemon --session --address="unix:path=${XDG_RUNTIME_DIR}/bus-stream" --fork
    # env -u : WAYLAND_DISPLAY et DISPLAY hérités de l'ENV du Dockerfile
    # feraient croire à KWin qu'il est un client (même piège que labwc, voir
    # plus haut) ; KWIN_*_NO_PERMISSION_CHECKS : KWin ne demande pas
    # d'autorisation de capture ou de saisie (personne pour répondre à la
    # fenêtre dans ce conteneur, sans écran).
    exec runuser -u arcade -- \
        env -u WAYLAND_DISPLAY -u DISPLAY HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus-stream" \
        XDG_CURRENT_DESKTOP=KDE XDG_SESSION_TYPE=wayland \
        KWIN_WAYLAND_NO_PERMISSION_CHECKS=1 KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1 \
        KWIN_DRM_DEVICES="${STREAM_CARD}" KWIN_FORCE_ASSUME_HDR_SUPPORT=1 \
        kwin_wayland --drm --xwayland --socket wayland-1 --no-lockscreen --exit-with-session \
        /usr/local/bin/scripts/kwin-stream-session.sh
fi

# Pas de sortie : labwc headless, comme avant (24/11 : le marqueur le dit).
echo "[labwc-stream] aucune sortie branchée : headless, capture wlr"
printf '%s' labwc > "${XDG_RUNTIME_DIR}/steambox-stream-compositor"
BACKEND_ENV=(LIBSEAT_BACKEND=noop WLR_BACKENDS=headless)
# DISPLAY de son Xwayland noté par note-display.sh (22/11, stream_display) ;
# l'ancien fichier est retiré d'abord pour qu'aucune appli ne lise un
# numéro périmé.
rm -f "${XDG_RUNTIME_DIR}/steambox-stream-display"
exec runuser -u arcade -- \
    env HOME=/home/arcade XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" "${BACKEND_ENV[@]}" \
    bash -c 'unset WAYLAND_DISPLAY DISPLAY; exec labwc -s "/usr/local/bin/scripts/note-display.sh stream"'
