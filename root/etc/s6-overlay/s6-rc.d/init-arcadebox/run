#!/usr/bin/with-contenv bash
# Initialisation ArcadeBox
#
# Service s6-rc (oneshot) exécuté avant init-services, donc avant svc-de/svc-selkies.
# Remplace l'ancien /etc/cont-init.d/99-arcadebox.sh : le répertoire /etc/cont-init.d
# n'existe plus dans s6-overlay v3, les scripts qui s'y trouvaient n'étaient jamais lancés.

# ── Environnement d'affichage ─────────────────────────────────────────────────
# En mode Wayland, svc-xorg ne démarre pas Xvfb (il fait "sleep infinity") : le
# serveur X est celui de labwc (Xwayland) et écoute sur :0, alors que l'image
# exporte DISPLAY=:1 (valeur correcte uniquement en mode X11/Xvfb).
# Sans cette correction, tout ce qui hérite de l'environnement du conteneur
# (services s6, XDG autostart, terminal) pointe sur un display mort.
# Référence : /etc/s6-overlay/s6-rc.d/svc-watchdog/run utilise DISPLAY=:0 en Wayland.
#
# WAYLAND_DISPLAY n'est volontairement PAS défini globalement : svc-de attend
# ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY:-wayland-1}, or wayland-1 est le socket de
# Selkies (créé avant svc-de) et wayland-0 celui de labwc (créé après).
# Le forcer à wayland-0 ferait attendre svc-de indéfiniment.
if [[ "${PIXELFLUX_WAYLAND}" == "true" ]]; then
    printf ':0' > /var/run/s6/container_environment/DISPLAY
    echo "[arcadebox] Mode Wayland — DISPLAY corrigé à :0 (Xwayland de labwc)"
else
    echo "[arcadebox] Mode X11 — DISPLAY=${DISPLAY} conservé (Xvfb)"
fi

# ── Arborescence ──────────────────────────────────────────────────────────────
# ROMs (noms de systèmes Batocera)
mkdir -p /userdata/roms/{arcade,naomi,naomi2,atomiswave,model2,model3,lindbergh,dreamcast,windows}
mkdir -p /userdata/{bios,saves,screenshots,music}
mkdir -p /userdata/system/wine-bottles/windows
mkdir -p /userdata/system/wine/custom

# Dossiers de config applicatifs
mkdir -p \
  /config/.config/pegasus-frontend \
  /config/.config/retroarch \
  /config/mame \
  /config/heroic \
  /config/skyscraper \
  /config/romvault/DatRoot

# ── Préconfig Pegasus ─────────────────────────────────────────────────────────
if [ ! -f /config/.config/pegasus-frontend/game_dirs.txt ] || \
   grep -q '/config/userdata/' /config/.config/pegasus-frontend/game_dirs.txt 2>/dev/null; then
  cat > /config/.config/pegasus-frontend/game_dirs.txt << 'EOF'
/userdata/roms/arcade
/userdata/roms/naomi
/userdata/roms/naomi2
/userdata/roms/atomiswave
/userdata/roms/model2
/userdata/roms/model3
/userdata/roms/lindbergh
/userdata/roms/dreamcast
/userdata/roms/windows
EOF
fi

# ── Permissions ───────────────────────────────────────────────────────────────
# /userdata est un partage NAS pouvant contenir des dizaines de milliers de ROMs :
# un chown -R à chaque démarrage coûterait plusieurs minutes. On ne corrige que
# les dossiers de premier niveau, ceux que ce script vient éventuellement de créer.
chown abc:users /userdata /userdata/roms /userdata/roms/* /userdata/system \
                /userdata/bios /userdata/saves /userdata/screenshots /userdata/music \
                2>/dev/null || true
chown -R abc:users /config/mame /config/heroic /config/skyscraper /config/romvault 2>/dev/null || true
find /userdata/system/wine-bottles -maxdepth 4 -not -user abc -exec chown abc:users {} + 2>/dev/null || true
chown abc:abc /defaults 2>/dev/null || true

# ── Patch NvFBC (débloque desktop capture GPU pour Sunshine) ──────────────────
if [[ -f /usr/local/bin/patch-nvfbc.sh ]]; then
    bash /usr/local/bin/patch-nvfbc.sh 2>/dev/null || true
    echo "/patched-lib" > /etc/ld.so.conf.d/000-patched-nvidia.conf
    ldconfig 2>/dev/null || true
fi

# ── Decky Loader ──────────────────────────────────────────────────────────────
mkdir -p /config/homebrew/{plugins,themes,settings,services,data}
if [[ -f /opt/decky-loader/PluginLoader && ! -f /config/homebrew/services/PluginLoader ]]; then
    cp /opt/decky-loader/PluginLoader /config/homebrew/services/PluginLoader
    chmod +x /config/homebrew/services/PluginLoader
fi
chown -R abc:users /config/homebrew 2>/dev/null || true

# ── Autostart labwc ───────────────────────────────────────────────────────────
# Mise à jour depuis /defaults si l'ancien bloc dbus-launch est présent, ou si
# l'autostart en place ne fixe pas encore l'environnement Wayland des applications.
if [[ -f /config/.config/labwc/autostart ]] && \
   { grep -q 'dbus-launch' /config/.config/labwc/autostart || \
     ! grep -q 'ARCADEBOX_DISPLAY_ENV_V2' /config/.config/labwc/autostart; }; then
    cp /defaults/autostart_wayland /config/.config/labwc/autostart
    chown abc:users /config/.config/labwc/autostart
fi

# ── Steam ─────────────────────────────────────────────────────────────────────
# steam-installer nomme l'entrée "Install Steam"
if [[ -f /usr/share/applications/steam.desktop ]] && grep -q "Install Steam" /usr/share/applications/steam.desktop; then
    sed -i 's/^Name=.*/Name=Steam/' /usr/share/applications/steam.desktop
fi

# ── Capture PipeWire (optionnelle) ────────────────────────────────────────────
# ARCADEBOX_PIPEWIRE=true : Steam Remote Play capture la sortie entière via le
# portail xdg au lieu du display Xwayland. Les démons sont lancés par l'autostart
# labwc ; on ne pose ici que la configuration.
if [[ "${ARCADEBOX_PIPEWIRE}" == "true" ]]; then
    # Backend wlroots : capture plein écran de la sortie de labwc.
    # chooser_type=none évite tout dialogue de sélection, indispensable sans clavier.
    # WL-1 est le nom de la sortie créée par Selkies (visible via wlr-randr).
    mkdir -p /config/.config/xdg-desktop-portal-wlr
    cat > /config/.config/xdg-desktop-portal-wlr/config << 'EOF'
[screencast]
output_name=WL-1
max_fps=60
chooser_type=none
EOF

    mkdir -p /config/.config/xdg-desktop-portal
    cat > /config/.config/xdg-desktop-portal/portals.conf << 'EOF'
[preferred]
default=wlr
org.freedesktop.impl.portal.ScreenCast=wlr
org.freedesktop.impl.portal.Screenshot=wlr
EOF

    # PipeWire n'est utilisé ici que pour la vidéo : on coupe le monitor ALSA de
    # WirePlumber pour qu'il ne dispute pas les périphériques à PulseAudio.
    mkdir -p /config/.config/wireplumber/wireplumber.conf.d
    cat > /config/.config/wireplumber/wireplumber.conf.d/50-arcadebox-no-alsa.conf << 'EOF'
wireplumber.profiles = {
  main = {
    monitor.alsa = disabled
    monitor.v4l2 = disabled
  }
}
EOF
    chown -R abc:users /config/.config/xdg-desktop-portal-wlr \
                       /config/.config/xdg-desktop-portal \
                       /config/.config/wireplumber 2>/dev/null || true
    STEAM_EXEC="env SDL_JOYSTICK_DISABLE_UDEV=1 steam -pipewire %U"
    echo "[arcadebox] PipeWire activé — Steam sera lancé avec -pipewire"
else
    STEAM_EXEC="env SDL_JOYSTICK_DISABLE_UDEV=1 steam %U"
fi

# L'icône du bureau ne passe pas par l'autostart XDG : il faut aussi porter
# (ou retirer) le drapeau sur le .desktop système, sinon un Steam lancé à la
# main n'aurait pas la capture par portail.
SYS_STEAM=/usr/share/applications/steam.desktop
if [[ -f "${SYS_STEAM}" ]]; then
    sed -i 's| /usr/games/steam -pipewire| /usr/games/steam|' "${SYS_STEAM}"
    if [[ "${ARCADEBOX_PIPEWIRE}" == "true" ]]; then
        sed -i 's| /usr/games/steam| /usr/games/steam -pipewire|' "${SYS_STEAM}"
    fi
fi

# Autostart Steam via XDG (requis pour dex --autostart)
# Réécrit à chaque démarrage : la ligne Exec dépend d'ARCADEBOX_PIPEWIRE.
mkdir -p /config/.config/autostart
cat > /config/.config/autostart/steam.desktop << EOF
[Desktop Entry]
Name=Steam
Exec=${STEAM_EXEC}
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
X-GNOME-Autostart-enabled=true
EOF
chown -R abc:users /config/.config/autostart 2>/dev/null || true

# ── uinput + input : accès manettes/périphériques pour abc ────────────────────
if [[ -e /dev/uinput ]]; then
    chmod 0666 /dev/uinput
    UINPUT_GID=$(stat -c '%g' /dev/uinput 2>/dev/null)
    if [[ -n "$UINPUT_GID" && "$UINPUT_GID" != "0" ]]; then
        getent group "$UINPUT_GID" &>/dev/null || groupadd -g "$UINPUT_GID" uinput 2>/dev/null || true
        usermod -aG "$UINPUT_GID" abc 2>/dev/null || true
    fi
fi
for dev in /dev/input/event* /dev/input/js*; do
    [[ -e "$dev" ]] && chmod 0666 "$dev" 2>/dev/null || true
done
