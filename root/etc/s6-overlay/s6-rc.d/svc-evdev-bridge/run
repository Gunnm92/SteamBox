#!/usr/bin/with-contenv bash

# Attend le socket wayland-0 de labwc — evdev-bridge ne retente pas la
# connexion en boucle en cas d'échec initial (il quitte et compte sur s6
# pour le relancer). XDG_RUNTIME_DIR n'est pas encore exporté à ce stade du
# boot (cf. autostart_wayland), on retombe donc sur le chemin fixe utilisé
# partout ailleurs dans l'image ArcadeBox.
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/config/.XDG}"
SOCKET_PATH="${XDG_RUNTIME_DIR}/wayland-0"

# Docker ne matérialise les device-nodes /dev/input/eventN qu'au démarrage du
# conteneur. Ceux que Sunshine crée dynamiquement via uinput (souris/clavier
# "passthrough") n'apparaissent jamais dans le /dev privé du conteneur malgré
# device_cgroup_rules (qui gère la permission d'accès, pas l'existence du
# fichier) — ils restent visibles uniquement dans /sys/class/input. On les
# synchronise ici, en root, avant le setuidgid vers abc plus bas.
sync_input_nodes() {
    for sys in /sys/class/input/*/dev; do
        [ -f "${sys}" ] || continue
        node=$(basename "$(dirname "${sys}")")
        path="/dev/input/${node}"
        [ -e "${path}" ] && continue
        IFS=: read -r major minor < "${sys}"
        mknod "${path}" c "${major}" "${minor}" 2>/dev/null || continue
        chmod 0660 "${path}" 2>/dev/null || true
        chown root:71 "${path}" 2>/dev/null || true
    done
}

while [ ! -S "${SOCKET_PATH}" ]; do
    sleep 0.5
done

# Boucle de fond : Sunshine peut créer ses devices bien après le démarrage de
# ce service (souvent seulement à la connexion d'un client Moonlight).
(
    while true; do
        sync_input_nodes
        sleep 2
    done
) &

mkdir -p /config/logs
exec s6-setuidgid abc \
  env WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
  /usr/local/bin/evdev-bridge-native >> /config/logs/evdev-bridge.log 2>&1
