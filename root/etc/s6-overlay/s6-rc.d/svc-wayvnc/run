#!/usr/bin/with-contenv bash

# Attend le socket wayland-0 de labwc, comme svc-evdev-bridge.
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/config/.XDG}"
SOCKET_PATH="${XDG_RUNTIME_DIR}/wayland-0"

while [ ! -S "${SOCKET_PATH}" ]; do
    sleep 0.5
done

mkdir -p /config/logs
exec s6-setuidgid abc \
  env WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
  wayvnc --websocket --output=WL-1 --render-cursor --max-fps=60 0.0.0.0 5900 \
  >> /config/logs/wayvnc.log 2>&1
