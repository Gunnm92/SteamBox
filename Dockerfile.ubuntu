# ArcadeBox — variante Ubuntu + KDE Plasma (session X11 réelle).
#
# Repart de la structure root-cachyos/ (scripts, s6-overlay v3, session
# KDE/X11 hand-made) inchangée — seul le système de paquets change
# (pacman/CachyOS → apt/Ubuntu). Raison du changement, confirmée en direct
# sur Dockerfile.cachyos :
#
# Les jeux lancés via Heroic (GE-Proton ET Proton-CachyOS) gelaient tout le
# système (pas juste le jeu — gel complet nécessitant un redémarrage du
# conteneur), alors que wine-staging pur (wsquashfs-launcher, sans Steam
# Runtime) fonctionnait normalement. Point commun identifié en direct : les
# deux passent par pressure-vessel (bac à sable Steam Runtime, invoqué via
# umu-launcher) — chaque lancement affichait "pressure-vessel-wrap: Failed
# to load Vulkan ICD" et "bwrap: Can't find source path
# /run/pressure-vessel/bus". Cause partiellement corrigée (notre session
# D-Bus n'exposait pas le bus au chemin standard $XDG_RUNTIME_DIR/bus que
# pressure-vessel attend — voir x11-session.sh) mais pas totalement
# concluante. L'utilisateur a une expérience directe : ce même trio
# Heroic/Proton/jeux fonctionnait bien sur l'ancienne image Dockerfile
# (base lscr.io/linuxserver/webstation, Ubuntu). Steam Runtime/pressure-
# vessel est développé et testé par Valve principalement sur des layouts
# Debian/Ubuntu — une base Arch/CachyOS est un terrain beaucoup moins
# éprouvé pour lui.
#
# Note : l'ancienne image "qui marchait" utilisait un bureau différent
# (labwc/Wayland + Selkies, pas KDE/KWin/X11) — deux variables ont changé
# en même temps (distro + architecture bureau). Ce Dockerfile ne change que
# la distro ; si la cause réelle est côté KWin/X11, le gel pourrait
# persister malgré tout.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── 1. Base système + KDE Plasma (X11) + seatd/libinput + GPU (Mesa/Vulkan) ──
RUN apt-get update && apt-get install --no-install-recommends -y \
      ca-certificates gnupg software-properties-common && \
    dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install --no-install-recommends -y \
      sudo vim openssh-client curl wget tar xz-utils zstd git jq unzip \
      seatd libinput10 \
      plasma-desktop kwin-x11 konsole dolphin kate \
      xdg-desktop-portal-kde plasma-nm plasma-pa polkit-kde-agent-1 \
      kscreen breeze breeze-gtk-theme kde-spectacle systemsettings \
      qml-module-qt-labs-platform \
      xserver-xorg x11-utils x11vnc xserver-xorg-input-evdev python3-pip \
      mesa-utils libgl1-mesa-dri vulkan-tools mesa-vulkan-drivers \
      libvulkan1 libvulkan1:i386 \
      pipewire pipewire-pulse wireplumber \
      libpipewire-0.3-0:i386 libpulse0:i386 \
      ffmpeg \
      gamemode mangohud \
      dbus policykit-1 network-manager \
      xdg-desktop-portal \
      squashfuse squashfs-tools fuse-overlayfs \
      mako-notifier libnotify-bin cabextract p7zip-full binutils libnss3 \
      ark unrar zip \
      libsdl2-image-2.0-0 libsdl2-mixer-2.0-0 libsdl2-ttf-2.0-0 libsdl2-gfx-1.0-0 \
      scummvm \
      fonts-jetbrains-mono \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# kdeplasma-addons n'existe pas comme paquet fonctionnel sur Ubuntu 24.04
# (seul "kdeplasma-addons-data", fichiers de locale uniquement) — abandonné,
# pas critique (widgets Plasma additionnels, pas requis pour la session).
#
# Papirus (icônes) — pas de paquet apt direct, PPA tiers non retenu ici pour
# limiter les dépendances externes ; à ajouter plus tard si besoin visuel.

# Pilote NetworkManager en mode passif — voir commentaire équivalent dans
# Dockerfile.cachyos : Steam (gamepadui) reste bloqué sur "waiting for
# network" sans ce service même quand la connectivité réelle est bonne, et
# unmanaged-devices=* est requis en network_mode: host pour ne pas laisser
# NetworkManager tenter de gérer les vraies interfaces de l'hôte Unraid.
RUN mkdir -p /etc/NetworkManager && \
    printf '[main]\nplugins=keyfile\n\n[keyfile]\nunmanaged-devices=*\n' \
      > /etc/NetworkManager/NetworkManager.conf

# ── 1a1. Steam — dépôt multiverse officiel Ubuntu ─────────────────────────────
RUN add-apt-repository -y multiverse && \
    apt-get update && \
    apt-get install --no-install-recommends -y steam-installer steam-devices && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# steam toujours avec -pipewire — Remote Play/Steam Link a besoin de ce flag
# pour la capture vidéo (sinon : "Unable to capture video:
# k_ECaptureFailedReasonPipewireRequired" après ~1 min de stream, confirmé
# en direct sur Dockerfile.cachyos). /usr/local/bin passe avant /usr/games
# dans le PATH par défaut, donc ce wrapper est prioritaire quel que soit le
# point d'entrée (dock, menu, app Sunshine).
RUN printf '#!/bin/sh\nexec /usr/games/steam -pipewire "$@"\n' > /usr/local/bin/steam && \
    chmod +x /usr/local/bin/steam

# ── 1a2. Wine Staging + DXVK + VKD3D-Proton — dépôt officiel WineHQ ──────────
# Méthode déjà éprouvée en prod sur l'ancienne image webstation (Ubuntu) —
# contrairement à CachyOS où wine-staging vient du dépôt Arch et où DXVK/
# VKD3D nécessitent un paquet -git tiers (dxvk-mingw-git) dont le setup.sh
# doit être invoqué manuellement au runtime.
RUN mkdir -pm755 /etc/apt/keyrings && \
    curl -sL https://dl.winehq.org/wine-builds/winehq.key \
      | gpg --dearmor > /etc/apt/keyrings/winehq-archive.key && \
    OS_CODENAME=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-${VERSION_CODENAME}}") && \
    curl -sL "https://dl.winehq.org/wine-builds/ubuntu/dists/${OS_CODENAME}/winehq-${OS_CODENAME}.sources" \
      -o /etc/apt/sources.list.d/winehq.sources && \
    apt-get update && \
    apt-get install --install-recommends -y winehq-staging winetricks && \
    apt-get install --no-install-recommends -y libpulse0:i386 libasound2-plugins && \
    DXVK_VERSION=$(curl -sX GET "https://api.github.com/repos/doitsujin/dxvk/releases/latest" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4 | sed 's/^v//') && \
    [ -n "${DXVK_VERSION}" ] || { echo "FATAL: DXVK_VERSION vide"; exit 1; } && \
    curl -o /tmp/dxvk.tar.gz -L \
      "https://github.com/doitsujin/dxvk/releases/download/v${DXVK_VERSION}/dxvk-${DXVK_VERSION}.tar.gz" && \
    tar -xzf /tmp/dxvk.tar.gz -C /opt/ && mv "/opt/dxvk-${DXVK_VERSION}" /opt/dxvk && \
    VKD3D_VERSION=$(curl -sX GET "https://api.github.com/repos/HansKristian-Work/vkd3d-proton/releases/latest" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4 | sed 's/^v//') && \
    [ -n "${VKD3D_VERSION}" ] || { echo "FATAL: VKD3D_VERSION vide"; exit 1; } && \
    curl -o /tmp/vkd3d.tar.zst -L \
      "https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v${VKD3D_VERSION}/vkd3d-proton-${VKD3D_VERSION}.tar.zst" && \
    tar -xf /tmp/vkd3d.tar.zst -C /opt/ && mv "/opt/vkd3d-proton-${VKD3D_VERSION}" /opt/vkd3d && \
    WINE64_DIR=/usr/lib/x86_64-linux-gnu/wine/x86_64-windows && \
    WINE32_DIR=/usr/lib/x86_64-linux-gnu/wine/i386-windows && \
    mkdir -p "$WINE64_DIR" "$WINE32_DIR" && \
    cp /opt/dxvk/x64/*.dll "$WINE64_DIR/" && cp /opt/dxvk/x32/*.dll "$WINE32_DIR/" && \
    cp /opt/vkd3d/x64/*.dll "$WINE64_DIR/" && cp /opt/vkd3d/x86/*.dll "$WINE32_DIR/" && \
    rm -f /tmp/dxvk.tar.gz /tmp/vkd3d.tar.zst && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 1a3. RetroArch + cœurs libretro — PPA officiel ────────────────────────────
# retroarch lui-même installé AVANT le PPA, depuis le dépôt universe standard
# (1.18.0+dfsg-1) — ppa:libretro/testing publie une version de retroarch qui
# exige des libcaca0/libdiscord-rpc3 plus récents que ceux réellement
# disponibles sur noble (conflit de dépendances irrésolvable, confirmé en
# direct). En installant retroarch depuis universe D'ABORD, sa dépendance
# est déjà satisfaite quand le PPA est ajouté ensuite pour les cœurs — apt
# n'a plus besoin de réévaluer/mettre à niveau retroarch lui-même.
# ppa:libretro/stable (essayé en alternative) manque trop de cœurs modernes
# (bsnes, fbneo, mupen64plus-next, picodrive, beetle-supergrafx, melonds,
# yabause, mame2010, dolphin absents) — /testing est le bon choix une fois
# le conflit retroarch contourné.
RUN apt-get update && \
    apt-get install --no-install-recommends -y retroarch && \
    add-apt-repository -y ppa:libretro/testing && \
    apt-get update
# libretro-dolphin (seul cœur encore bloqué : exige libxxhash0 >= 0.8.3,
# noble ne fournit que 0.8.2 — confirmé en direct) volontairement omis.
# Écarts connus par rapport à CachyOS (37 systèmes, cf. init_pegasus.sh),
# vérifiés en direct sur ce PPA (noble) :
#   - pas de "libretro-mame" (MAME moderne/complet) : seulement mame2003 et
#     mame2010 (plus anciens). SYSTEMS["mame"]/["arcade"] à réévaluer.
#   - pas de "libretro-flycast" (Dreamcast/Naomi/Atomiswave) : aucun
#     équivalent packagé sur ce PPA. Systèmes concernés à réévaluer/retirer.
#   - pas de cœur PPSSPP (PSP) ni de cœur ScummVM packagé séparément
#     (le paquet scummvm autonome ci-dessus reste disponible).
#   - pas de cœur Dolphin (GameCube/Wii, cf. ci-dessus).
# À corriger dans init_pegasus.sh une fois le conteneur de test lancé, comme
# ça a été fait pour la même classe de problème sur CachyOS.
RUN apt-get install --no-install-recommends -y \
      libretro-core-info \
      libretro-nestopia libretro-bsnes libretro-genesisplusgx \
      libretro-mgba libretro-gambatte libretro-desmume \
      libretro-mupen64plus-next libretro-beetle-psx libretro-fbneo \
      libretro-picodrive libretro-beetle-supergrafx \
      libretro-snes9x libretro-melonds libretro-yabause \
      libretro-mame2010 libretro-beetle-pce-fast \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 1a4. Schémas GSettings / cache MIME — sécurité, ces hooks tournent déjà
# automatiquement via les scripts postinst dpkg sur Ubuntu (contrairement à
# pacman/CachyOS où le hook réseau-sandboxé de buildkit les bloquait), mais
# on les relance explicitement au cas où pour rester robuste.
RUN glib-compile-schemas /usr/share/glib-2.0/schemas/ 2>/dev/null || true && \
    update-mime-database /usr/share/mime 2>/dev/null || true

# ── 1a5. Locale française ──────────────────────────────────────────────────
RUN apt-get update && apt-get install --no-install-recommends -y locales && \
    locale-gen fr_FR.UTF-8 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 1a6. Pegasus Frontend — pas de paquet apt maintenu à jour, build
# x11-static officiel (identique à Dockerfile.cachyos, méthode distro-
# agnostic déjà éprouvée).
RUN PEGASUS_URL=$(curl -sX GET "https://api.github.com/repos/mmatyas/pegasus-frontend/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*x11-static\.zip"' | cut -d'"' -f4) && \
    [ -n "${PEGASUS_URL}" ] || { echo "FATAL: PEGASUS_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/pegasus.zip "${PEGASUS_URL}" && \
    mkdir -p /opt/pegasus && \
    unzip -q /tmp/pegasus.zip -d /opt/pegasus && \
    ln -sf /opt/pegasus/pegasus-fe /usr/local/bin/pegasus-fe && \
    printf '[Desktop Entry]\nType=Application\nName=Pegasus\nExec=env QT_QPA_PLATFORM=xcb DISPLAY=:0 /usr/local/bin/pegasus-fe\nIcon=applications-games\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/pegasus.desktop && \
    rm -f /tmp/pegasus.zip

# ── 1a7. wsquashfs-launcher — lanceur de jeux Windows .wsquashfs (Batocera).
RUN curl -fsSL https://raw.githubusercontent.com/Gunnm92/wsquashfs-launcher/main/wsquashfs-launcher \
      -o /usr/local/bin/wsquashfs-launcher && \
    chmod +x /usr/local/bin/wsquashfs-launcher

# ── 1a8. Steam ROM Manager — AppImage officielle.
RUN SRM_URL=$(curl -sX GET "https://api.github.com/repos/SteamGridDB/steam-rom-manager/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*[0-9]\.AppImage"' | grep -v arm64 | cut -d'"' -f4) && \
    [ -n "${SRM_URL}" ] || { echo "FATAL: SRM_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/srm.AppImage "${SRM_URL}" && \
    chmod +x /tmp/srm.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./srm.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction srm.AppImage échouée"; exit 1; } && \
    mv /tmp/squashfs-root /opt/steam-rom-manager && \
    chmod -R a+rX /opt/steam-rom-manager && \
    ln -sf /opt/steam-rom-manager/AppRun /usr/local/bin/steam-rom-manager && \
    printf '[Desktop Entry]\nType=Application\nName=Steam ROM Manager\nExec=/usr/local/bin/steam-rom-manager --no-sandbox\nIcon=/opt/steam-rom-manager/.DirIcon\nTerminal=false\nCategories=Game;\n' \
      > /usr/share/applications/steam-rom-manager.desktop && \
    rm -rf /tmp/srm.AppImage /tmp/squashfs-root

# ── 1a9. Lindbergh Loader (arcade Sega Lindbergh) — AppImage officielle.
RUN curl -fSL -o /tmp/lindbergh.app \
      "https://github.com/lindbergh-loader/lindbergh-loader/releases/download/v2.1.4/lindbergh-loader.AppImage" && \
    chmod +x /tmp/lindbergh.app && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root AppDir; ./lindbergh.app --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    { [ -d squashfs-root ] || [ -d AppDir ]; } || { echo "FATAL: extraction lindbergh.app échouée"; exit 1; } && \
    { [ -L squashfs-root ] && mv AppDir /opt/lindbergh && rm -f squashfs-root || mv squashfs-root /opt/lindbergh; } && \
    ln -sf /opt/lindbergh/AppRun /usr/local/bin/lindbergh && \
    printf '[Desktop Entry]\nType=Application\nName=Lindbergh Loader\nExec=/usr/local/bin/lindbergh\nIcon=/opt/lindbergh/.DirIcon\nCategories=Game;Emulator;\nTerminal=false\n' \
      > /usr/share/applications/lindbergh.desktop && \
    rm -rf /tmp/lindbergh.app /tmp/AppDir /tmp/squashfs-root

# ── 1a10. Supermodel (arcade Sega Model 3) — tarball Linux officiel.
RUN SUPERMODEL_URL=$(curl -sX GET "https://api.github.com/repos/trzy/Supermodel/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*[Ll]inux[^"]*\.tar[^"]*"' | cut -d'"' -f4 | head -1) && \
    if [ -n "${SUPERMODEL_URL}" ]; then \
      curl -o /tmp/supermodel.tar.gz -L "${SUPERMODEL_URL}" && \
      mkdir -p /opt/supermodel && \
      tar -xzf /tmp/supermodel.tar.gz -C /opt/supermodel --strip-components=1 && \
      ln -sf /opt/supermodel/supermodel /usr/local/bin/supermodel; \
    else \
      echo "Supermodel: pas de release Linux, skip"; \
    fi && \
    rm -f /tmp/supermodel.tar.gz

# ── 1a11. Wine Gecko + Mono — sans ça, tout préfixe Wine invite au
# téléchargement (popup bloquant) au premier lancement d'un installeur/jeu
# qui a besoin du moteur HTML (Gecko) ou de .NET (Mono).
RUN GECKO_VERSION=$(curl -fsSL "https://raw.githubusercontent.com/wine-mirror/wine/refs/heads/master/dlls/appwiz.cpl/addons.c" \
      | grep -oP '(?<=GECKO_VERSION ")[^"]+' | head -1) && \
    MONO_VERSION=$(curl -fsSL "https://raw.githubusercontent.com/wine-mirror/wine/refs/heads/master/dlls/appwiz.cpl/addons.c" \
      | grep -oP '(?<=MONO_VERSION ")[^"]+' | head -1) && \
    mkdir -p /usr/share/wine/gecko /usr/share/wine/mono && \
    for arch in x86 x86_64; do \
      curl -fsSL --retry 3 -o "/usr/share/wine/gecko/wine-gecko-${GECKO_VERSION}-${arch}.msi" \
        "https://dl.winehq.org/wine/wine-gecko/${GECKO_VERSION}/wine-gecko-${GECKO_VERSION}-${arch}.msi" || true; \
    done && \
    curl -fsSL --retry 3 -o "/tmp/wine-mono.tar.xz" \
      "https://dl.winehq.org/wine/wine-mono/${MONO_VERSION}/wine-mono-${MONO_VERSION}-x86.tar.xz" && \
    tar -xf /tmp/wine-mono.tar.xz -C /usr/share/wine/mono && \
    rm -f /tmp/wine-mono.tar.xz

# ── 1a12. Google Chrome — .deb officiel Google, extrait manuellement.
RUN curl -fsSL -o /tmp/chrome.deb "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb" && \
    cd /tmp && ar x chrome.deb && \
    mkdir -p /tmp/chrome-extract && \
    tar -xf data.tar.xz -C /tmp/chrome-extract && \
    mkdir -p /opt/google/chrome && \
    cp -a /tmp/chrome-extract/opt/google/chrome/. /opt/google/chrome/ && \
    ln -sf /opt/google/chrome/google-chrome /usr/local/bin/google-chrome && \
    chmod 4755 /opt/google/chrome/chrome-sandbox && \
    printf '[Desktop Entry]\nType=Application\nName=Google Chrome\nExec=/opt/google/chrome/google-chrome --ozone-platform=x11 %%U\nIcon=/opt/google/chrome/product_logo_256.png\nTerminal=false\nCategories=Network;WebBrowser;\n' \
      > /usr/share/applications/google-chrome.desktop && \
    rm -rf /tmp/chrome.deb /tmp/control.tar.* /tmp/data.tar.* /tmp/debian-binary /tmp/chrome-extract

# ── 1a13. Émulateurs supplémentaires — AppImage/archive Linux officielle
# pour chaque projet (aucun n'a de paquet apt maintenu à jour sur Ubuntu).
RUN CEMU_URL=$(curl -sX GET "https://api.github.com/repos/cemu-project/Cemu/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*x86_64\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${CEMU_URL}" ] || { echo "FATAL: CEMU_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/cemu.AppImage "${CEMU_URL}" && \
    chmod +x /tmp/cemu.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./cemu.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction cemu.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/cemu && \
    ln -sf /opt/cemu/AppRun /usr/local/bin/cemu && \
    printf '[Desktop Entry]\nType=Application\nName=Cemu\nExec=/usr/local/bin/cemu\nIcon=/opt/cemu/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/cemu.desktop && \
    rm -f /tmp/cemu.AppImage

RUN PCSX2_URL=$(curl -sX GET "https://api.github.com/repos/PCSX2/pcsx2/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*linux-appimage-x64-Qt\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${PCSX2_URL}" ] || { echo "FATAL: PCSX2_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/pcsx2.AppImage "${PCSX2_URL}" && \
    chmod +x /tmp/pcsx2.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./pcsx2.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction pcsx2.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/pcsx2 && \
    ln -sf /opt/pcsx2/AppRun /usr/local/bin/pcsx2 && \
    printf '[Desktop Entry]\nType=Application\nName=PCSX2\nExec=/usr/local/bin/pcsx2\nIcon=/opt/pcsx2/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/pcsx2.desktop && \
    rm -f /tmp/pcsx2.AppImage

RUN RPCS3_URL=$(curl -sX GET "https://api.github.com/repos/RPCS3/rpcs3-binaries-linux/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*_linux64\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${RPCS3_URL}" ] || { echo "FATAL: RPCS3_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/rpcs3.AppImage "${RPCS3_URL}" && \
    chmod +x /tmp/rpcs3.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root AppDir; ./rpcs3.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    { [ -d squashfs-root ] || [ -d AppDir ]; } || { echo "FATAL: extraction rpcs3.AppImage échouée"; exit 1; } && \
    { [ -L squashfs-root ] && mv AppDir /opt/rpcs3 || mv squashfs-root /opt/rpcs3; } && \
    ln -sf /opt/rpcs3/AppRun /usr/local/bin/rpcs3 && \
    printf '[Desktop Entry]\nType=Application\nName=RPCS3\nExec=/usr/local/bin/rpcs3\nIcon=/opt/rpcs3/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/rpcs3.desktop && \
    rm -f /tmp/rpcs3.AppImage

RUN DUCKSTATION_URL=$(curl -sX GET "https://api.github.com/repos/stenzek/duckstation/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*DuckStation-x64\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${DUCKSTATION_URL}" ] || { echo "FATAL: DUCKSTATION_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/duckstation.AppImage "${DUCKSTATION_URL}" && \
    chmod +x /tmp/duckstation.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./duckstation.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction duckstation.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/duckstation && \
    ln -sf /opt/duckstation/AppRun /usr/local/bin/duckstation-qt && \
    printf '[Desktop Entry]\nType=Application\nName=DuckStation\nExec=/usr/local/bin/duckstation-qt\nIcon=/opt/duckstation/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/duckstation.desktop && \
    rm -f /tmp/duckstation.AppImage

RUN XEMU_URL=$(curl -sX GET "https://api.github.com/repos/xemu-project/xemu/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*x86_64\.AppImage"' | grep -v dbg | cut -d'"' -f4 | head -1) && \
    [ -n "${XEMU_URL}" ] || { echo "FATAL: XEMU_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/xemu.AppImage "${XEMU_URL}" && \
    chmod +x /tmp/xemu.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./xemu.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction xemu.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/xemu && \
    ln -sf /opt/xemu/AppRun /usr/local/bin/xemu && \
    printf '[Desktop Entry]\nType=Application\nName=Xemu\nExec=/usr/local/bin/xemu\nIcon=/opt/xemu/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/xemu.desktop && \
    rm -f /tmp/xemu.AppImage

RUN AZAHAR_URL=$(curl -sX GET "https://api.github.com/repos/azahar-emu/azahar/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*wayland\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${AZAHAR_URL}" ] || { echo "FATAL: AZAHAR_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/azahar.AppImage "${AZAHAR_URL}" && \
    chmod +x /tmp/azahar.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./azahar.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction azahar.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/azahar && \
    ln -sf /opt/azahar/AppRun /usr/local/bin/azahar && \
    printf '[Desktop Entry]\nType=Application\nName=Azahar\nExec=/usr/local/bin/azahar\nIcon=/opt/azahar/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/azahar.desktop && \
    rm -f /tmp/azahar.AppImage

RUN XENIA_URL=$(curl -sX GET "https://api.github.com/repos/has207/xenia-edge/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*linux\.AppImage"' | cut -d'"' -f4) && \
    [ -n "${XENIA_URL}" ] || { echo "FATAL: XENIA_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/xenia.AppImage "${XENIA_URL}" && \
    chmod +x /tmp/xenia.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root; ./xenia.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction xenia.AppImage échouée"; exit 1; } && \
    mv squashfs-root /opt/xenia && \
    ln -sf /opt/xenia/AppRun /usr/local/bin/xenia && \
    printf '[Desktop Entry]\nType=Application\nName=Xenia (Xbox 360)\nExec=/usr/local/bin/xenia\nIcon=/opt/xenia/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/xenia.desktop && \
    rm -f /tmp/xenia.AppImage

# melonDS (Nintendo DS) — zip officiel, standalone (en plus du cœur
# libretro-melonds installé plus haut pour Pegasus/RetroArch).
RUN MELONDS_VERSION=$(curl -sX GET "https://api.github.com/repos/melonDS-emu/melonDS/releases/latest" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${MELONDS_VERSION}" ] || { echo "FATAL: MELONDS_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/melon.zip \
      "https://github.com/melonDS-emu/melonDS/releases/download/${MELONDS_VERSION}/melonDS-${MELONDS_VERSION}-ubuntu-x86_64.zip" && \
    mkdir -p /opt/melonds && unzip -q /tmp/melon.zip -d /opt/melonds && \
    ln -sf /opt/melonds/melonDS /usr/local/bin/melonDS && \
    curl -fSL --retry 3 -o /opt/melonds/melon.png \
      "https://raw.githubusercontent.com/melonDS-emu/melonDS/master/res/melon512.png" && \
    printf '[Desktop Entry]\nType=Application\nName=melonDS\nExec=/usr/local/bin/melonDS\nIcon=/opt/melonds/melon.png\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/melonds.desktop && \
    rm -f /tmp/melon.zip

# DOSBox Staging — tarball officiel.
RUN DSTAGING_VERSION=$(curl -sX GET "https://api.github.com/repos/dosbox-staging/dosbox-staging/releases/latest" \
      | grep -oE '"tag_name": *"[^"]*"' | cut -d'"' -f4) && \
    [ -n "${DSTAGING_VERSION}" ] || { echo "FATAL: DSTAGING_VERSION vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/dosbox.tar.xz \
      "https://github.com/dosbox-staging/dosbox-staging/releases/download/${DSTAGING_VERSION}/dosbox-staging-linux-x86_64-${DSTAGING_VERSION}.tar.xz" && \
    mkdir -p /opt/dosbox && tar -xf /tmp/dosbox.tar.xz -C /opt/dosbox --strip-components=1 && \
    ln -sf /opt/dosbox/dosbox /usr/local/bin/dosbox && \
    printf '[Desktop Entry]\nType=Application\nName=DOSBox Staging\nExec=/usr/local/bin/dosbox\nIcon=/opt/dosbox/icons/hicolor/256x256/apps/org.dosbox-staging.dosbox-staging.png\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/dosbox.desktop && \
    rm -f /tmp/dosbox.tar.xz

# GZDoom + Freedoom (WAD libre) — .deb officiel.
RUN GZDOOM_URL=$(curl -sX GET "https://api.github.com/repos/ZDoom/gzdoom/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*_amd64\.deb"' | cut -d'"' -f4) && \
    [ -n "${GZDOOM_URL}" ] || { echo "FATAL: GZDOOM_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/gzdoom.deb "${GZDOOM_URL}" && \
    cd /tmp && ar x gzdoom.deb && mkdir -p /tmp/gzdoom-extract && \
    tar -xf data.tar.* -C /tmp/gzdoom-extract && \
    cp -a /tmp/gzdoom-extract/opt/. /opt/ && \
    cp -a /tmp/gzdoom-extract/usr/. /usr/ && \
    chmod +x /usr/games/gzdoom /opt/gzdoom/gzdoom && \
    ln -sf /usr/games/gzdoom /usr/local/bin/gzdoom && \
    FREEDOOM_URL=$(curl -sX GET "https://api.github.com/repos/freedoom/freedoom/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*freedoom-[^"]*\.zip"' | cut -d'"' -f4) && \
    curl -fSL --retry 3 -o /tmp/freedoom.zip "${FREEDOOM_URL}" && \
    mkdir -p /usr/local/share/doom && \
    unzip -qj /tmp/freedoom.zip '*/freedoom1.wad' -d /usr/local/share/doom && \
    rm -rf /tmp/gzdoom.deb /tmp/control.tar.* /tmp/data.tar.* /tmp/debian-binary /tmp/gzdoom-extract /tmp/freedoom.zip

# ShadPS4 (PS4, expérimental) — zip officiel (AppImage empaqueté dedans).
RUN SHADPS4_TAG=$(curl -sX GET "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases" \
      | grep -oE '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4) && \
    SHADPS4_URL=$(curl -sX GET "https://api.github.com/repos/shadps4-emu/shadps4-qtlauncher/releases" \
      | grep -oE '"browser_download_url": *"[^"]*linux-qt[^"]*\.zip"' | head -1 | cut -d'"' -f4) && \
    [ -n "${SHADPS4_URL}" ] || { echo "FATAL: SHADPS4_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/shadps4.zip "${SHADPS4_URL}" && \
    mkdir -p /tmp/shadps4 && cd /tmp/shadps4 && unzip -q /tmp/shadps4.zip && \
    APPIMAGE=$(find . -name "*.AppImage" | head -1) && \
    chmod +x "${APPIMAGE}" && \
    for i in 1 2 3; do rm -rf squashfs-root; "./${APPIMAGE##./}" --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    [ -d squashfs-root ] || { echo "FATAL: extraction shadps4 échouée"; exit 1; } && \
    mv squashfs-root /opt/shadps4 && \
    ln -sf /opt/shadps4/AppRun /usr/local/bin/shadps4 && \
    printf '[Desktop Entry]\nType=Application\nName=ShadPS4\nExec=/usr/local/bin/shadps4\nIcon=/opt/shadps4/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/shadps4.desktop && \
    rm -rf /tmp/shadps4.zip /tmp/shadps4

# Eden (Nintendo Switch) — le dépôt GitHub officiel est bloqué DMCA,
# distribution via l'infrastructure propre du projet (eden-emu.dev).
RUN EDEN_TAG=$(curl -sX GET "https://git.eden-emu.dev/api/v1/repos/eden-emu/eden/releases/latest" \
      | grep -oE '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4) && \
    [ -n "${EDEN_TAG}" ] || { echo "FATAL: EDEN_TAG vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/eden.AppImage \
      "https://stable.eden-emu.dev/${EDEN_TAG}/Eden-Linux-${EDEN_TAG}-amd64-clang-pgo.AppImage" && \
    chmod +x /tmp/eden.AppImage && cd /tmp && \
    for i in 1 2 3; do rm -rf squashfs-root AppDir; ./eden.AppImage --appimage-extract >/dev/null 2>&1 && break; sleep 1; done && \
    { [ -d squashfs-root ] || [ -d AppDir ]; } || { echo "FATAL: extraction eden.AppImage échouée"; exit 1; } && \
    { [ -L squashfs-root ] && mv AppDir /opt/eden || mv squashfs-root /opt/eden; } && \
    printf '#!/bin/sh\ncd /opt/eden && exec ./AppRun "$@"\n' > /usr/local/bin/eden && \
    chmod +x /usr/local/bin/eden && \
    printf '[Desktop Entry]\nType=Application\nName=Eden\nExec=/usr/local/bin/eden\nIcon=/opt/eden/.DirIcon\nTerminal=false\nCategories=Game;Emulator;\n' \
      > /usr/share/applications/eden.desktop && \
    rm -f /tmp/eden.AppImage

# Flips — patcher de ROMs IPS/BPS.
RUN FLIPS_URL=$(curl -sX GET "https://api.github.com/repos/Alcaro/Flips/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*linux\.zip"' | cut -d'"' -f4) && \
    [ -n "${FLIPS_URL}" ] || { echo "FATAL: FLIPS_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/flips.zip "${FLIPS_URL}" && \
    mkdir -p /tmp/flips && cd /tmp/flips && unzip -q /tmp/flips.zip && \
    install -Dm755 flips /usr/local/bin/flips && \
    rm -rf /tmp/flips.zip /tmp/flips

# ── 1a14. Heroic Games Launcher — .deb officiel ──────────────────────────────
RUN HEROIC_DEB_URL=$(curl -sX GET "https://api.github.com/repos/Heroic-Games-Launcher/HeroicGamesLauncher/releases/latest" \
      | grep -oE '"browser_download_url": *"[^"]*amd64\.deb"' | cut -d'"' -f4 | head -1) && \
    [ -n "${HEROIC_DEB_URL}" ] || { echo "FATAL: HEROIC_DEB_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/heroic.deb "${HEROIC_DEB_URL}" && \
    apt-get update && apt-get install -y /tmp/heroic.deb && \
    rm -f /tmp/heroic.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 1a15. Sunshine — .deb officiel matché à la version Ubuntu ───────────────
RUN UBUNTU_VER=$(. /etc/os-release && echo "${VERSION_ID}") && \
    SUNSHINE_JSON=$(curl -sX GET "https://api.github.com/repos/LizardByte/Sunshine/releases/latest") && \
    SUNSHINE_URL=$(echo "${SUNSHINE_JSON}" \
      | grep "browser_download_url.*ubuntu-${UBUNTU_VER}-amd64\.deb" | cut -d'"' -f4) && \
    if [ -z "${SUNSHINE_URL}" ]; then \
      SUNSHINE_URL=$(echo "${SUNSHINE_JSON}" \
        | grep -o "https://[^\"]*ubuntu-[0-9.]*-amd64\.deb" | sort -V | tail -1); \
      echo "Sunshine: aucun paquet pour Ubuntu ${UBUNTU_VER}, repli sur ${SUNSHINE_URL}"; \
    fi && \
    [ -n "${SUNSHINE_URL}" ] || { echo "FATAL: SUNSHINE_URL vide"; exit 1; } && \
    curl -fSL --retry 3 -o /tmp/sunshine.deb "${SUNSHINE_URL}" && \
    apt-get update && apt-get install -y /tmp/sunshine.deb && \
    rm -f /tmp/sunshine.deb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN setcap 'cap_sys_nice+p' "$(readlink -f /usr/bin/sunshine)" 2>/dev/null || \
    echo "WARN: setcap sunshine impossible ici, à refaire si le binaire change au runtime"

# ── 1b. noVNC — fichiers statiques + websockify (pip, pas de paquet apt) ─────
RUN pip install --break-system-packages --no-cache-dir websockify

RUN NOVNC_URL=$(curl -sX GET "https://api.github.com/repos/novnc/noVNC/releases/latest" \
      | grep -oE '"tarball_url": *"[^"]*"' | cut -d'"' -f4) && \
    mkdir -p /usr/share/webapps/novnc && \
    curl -fSL "${NOVNC_URL}" | tar -xz -C /usr/share/webapps/novnc --strip-components=1

RUN printf '<script>location.replace("vnc.html?host=" + location.hostname + "&port=5900&autoconnect=true&resize=scale&reconnect=true");</script>\n' \
      > /usr/share/webapps/novnc/index.html

# ── 2. Driver NVIDIA userspace — matché à la version du host au démarrage ────
# Script distro-agnostic déjà éprouvé sur CachyOS (approche .run, installé
# au runtime, pas ici au build — le driver du host n'est pas connu ici).
COPY ArcadeBox/root-cachyos/usr/local/bin/install-nvidia-userspace.sh /usr/local/bin/install-nvidia-userspace.sh
RUN chmod +x /usr/local/bin/install-nvidia-userspace.sh

# ── 2b. s6-overlay — vrai supervisor de conteneur ────────────────────────────
ARG S6_OVERLAY_VERSION=3.2.3.2
RUN curl -fsSL -o /tmp/s6-overlay-noarch.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz && \
    curl -fSL -o /tmp/s6-overlay-x86_64.tar.xz \
      "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz && \
    rm -f /tmp/s6-overlay-*.tar.xz

# ── 3. Règles udev manettes (Xbox/PlayStation/Switch — mappings non standard) ─
RUN git clone --depth 1 https://codeberg.org/fabiscafe/game-devices-udev.git /tmp/gdu && \
    cp /tmp/gdu/src/*.rules /etc/udev/rules.d/ && \
    rm -rf /tmp/gdu

# ── 4. Utilisateur non-root pour la session bureau ────────────────────────────
ARG PUID=1000
ARG PGID=1000
# L'image ubuntu:24.04 embarque déjà un utilisateur "ubuntu" en uid 1000
# (convention cloud-init) — en conflit direct avec notre PUID par défaut.
RUN userdel -r ubuntu 2>/dev/null || true && \
    groupadd -g "${PGID}" arcade 2>/dev/null || true && \
    useradd -m -u "${PUID}" -g "${PGID}" \
      -G sudo,video,input,render,audio -s /bin/bash arcade && \
    echo "arcade ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers && \
    mkdir -p /home/arcade/.config/sunshine && \
    chown -R arcade:arcade /home/arcade

# ── 5. Scripts de démarrage ────────────────────────────────────────────────────
# root-cachyos/ réutilisé tel quel (voir Dockerfile.cachyos pour l'historique
# détaillé de chaque script) — remplace l'ancien entrypoint.sh bash.
COPY ArcadeBox/root-cachyos/etc/ /etc/
COPY ArcadeBox/root-cachyos/scripts/ /usr/local/bin/scripts/
RUN chmod +x /usr/local/bin/scripts/*.sh && \
    find /etc/s6-overlay/s6-rc.d -name run -exec chmod +x {} \;

ENV XDG_RUNTIME_DIR=/run/user/1000 \
    DISPLAY=:0 \
    SEATD_VTBOUND=0 \
    LIBSEAT_BACKEND=seatd \
    QT_QPA_PLATFORM=xcb \
    SDL_VIDEODRIVER=x11 \
    SDL_JOYSTICK_DISABLE_UDEV=1 \
    XDG_CURRENT_DESKTOP=KDE \
    XDG_SESSION_TYPE=x11 \
    KDE_SESSION_VERSION=5 \
    GSK_RENDERER=cairo \
    LANG=fr_FR.UTF-8 \
    LANGUAGE=fr_FR:fr \
    LC_ALL=fr_FR.UTF-8 \
    DOOMWADDIR=/usr/local/share/doom \
    S6_KEEP_ENV=1 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_VERBOSITY=2

VOLUME /config
EXPOSE 6080 5900 47990 47984 47989 47998-48000/udp 48010

ENTRYPOINT ["/init"]
